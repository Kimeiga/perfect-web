{
  "page": "store.page.StorePage",
  "route": "/stores/{id}",
  "params": [
    "id"
  ],
  "bindings": [
    {
      "binding": "store",
      "resource": "store.page.Store",
      "args": [
        "id"
      ],
      "policy": {
        "cache": "shared",
        "privacy": "public",
        "freshness_ms": 30000,
        "timeout_ms": 2000,
        "attempts": 1,
        "parallel": false,
        "key": [
          0
        ],
        "on_key_change": "cancel",
        "fallback": "last_known_good"
      },
      "not_found": [
        "not-found"
      ]
    },
    {
      "binding": "menu",
      "resource": "store.page.Menu",
      "args": [
        "id"
      ],
      "policy": {
        "cache": "shared",
        "privacy": "public",
        "freshness_ms": 300000,
        "timeout_ms": 2000,
        "attempts": 1,
        "parallel": false,
        "key": [
          0
        ],
        "on_key_change": "cancel",
        "fallback": "last_known_good"
      },
      "not_found": [
        "not-found"
      ]
    },
    {
      "binding": "cart",
      "resource": "store.page.Cart",
      "args": [
        "current_session()"
      ],
      "policy": {
        "cache": "private",
        "privacy": "session",
        "freshness_ms": 0,
        "timeout_ms": 2000,
        "attempts": 1,
        "parallel": false,
        "key": [
          0
        ],
        "on_key_change": "cancel"
      }
    }
  ],
  "parts": [
    {
      "part": 0,
      "path": "store.name",
      "binding": "store",
      "steps": [
        {
          "field": "name"
        }
      ]
    },
    {
      "part": 1,
      "path": "store.description",
      "binding": "store",
      "steps": [
        {
          "field": "description"
        }
      ]
    },
    {
      "part": 11,
      "path": "cart.line_count",
      "binding": "cart",
      "steps": [
        {
          "member": "domain.line_count"
        }
      ]
    },
    {
      "part": 23,
      "path": "cart.subtotal.display",
      "binding": "cart",
      "steps": [
        {
          "member": "domain.subtotal"
        },
        {
          "member": "domain.display"
        }
      ]
    }
  ],
  "collections": [
    "menu",
    "cart.lines"
  ],
  "signals": [
    {
      "name": "notice",
      "initial": ""
    }
  ],
  "live": [
    {
      "part": 25,
      "signal": "notice",
      "path": "notice",
      "kind": "text"
    }
  ],
  "blocks": [
    24
  ],
  "streams": [
    {
      "part": 2,
      "resource": "store.page.Estimate",
      "args": [
        "current_session()"
      ],
      "policy": {
        "cache": "private",
        "privacy": "session",
        "freshness_ms": 0,
        "timeout_ms": 3000,
        "attempts": 1,
        "parallel": false,
        "key": [
          0
        ],
        "on_key_change": "cancel"
      },
      "streamed": true
    },
    {
      "part": 27,
      "resource": "store.page.Recommendations",
      "args": [
        "id"
      ],
      "policy": {
        "cache": "shared",
        "privacy": "public",
        "freshness_ms": 600000,
        "timeout_ms": 3000,
        "attempts": 1,
        "parallel": false,
        "key": [
          0
        ],
        "on_key_change": "cancel"
      },
      "streamed": true
    }
  ],
  "rows": [
    {
      "collection": "menu",
      "binding": "item",
      "path": "item.price.display",
      "steps": [
        {
          "field": "price"
        },
        {
          "member": "domain.display"
        }
      ]
    },
    {
      "collection": "cart.lines",
      "binding": "line",
      "path": "line.quantity.count",
      "steps": [
        {
          "field": "quantity"
        },
        {
          "member": "domain.count"
        }
      ]
    },
    {
      "collection": "cart.lines",
      "binding": "line",
      "path": "line.total.display",
      "steps": [
        {
          "member": "domain.total"
        },
        {
          "member": "domain.display"
        }
      ]
    }
  ],
  "attributes": [
    12
  ]
}
