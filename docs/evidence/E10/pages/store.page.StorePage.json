{
  "page": "store.page.StorePage",
  "params": [
    "id"
  ],
  "bindings": [
    {
      "binding": "store",
      "resource": "store.page.Store",
      "args": [
        "id"
      ],
      "policy": {
        "cache": "shared",
        "privacy": "public",
        "freshness_ms": 30000,
        "timeout_ms": 2000,
        "attempts": 1,
        "parallel": false,
        "key": [
          0
        ]
      }
    },
    {
      "binding": "menu",
      "resource": "store.page.Menu",
      "args": [
        "id"
      ],
      "policy": {
        "cache": "shared",
        "privacy": "public",
        "freshness_ms": 300000,
        "timeout_ms": 2000,
        "attempts": 1,
        "parallel": false,
        "key": [
          0
        ]
      }
    },
    {
      "binding": "cart",
      "resource": "store.page.Cart",
      "args": [
        "current_session()"
      ],
      "policy": {
        "cache": "private",
        "privacy": "session",
        "freshness_ms": 0,
        "timeout_ms": 2000,
        "attempts": 1,
        "parallel": false,
        "key": [
          0
        ]
      }
    }
  ],
  "parts": [
    {
      "part": 0,
      "path": "store.name",
      "binding": "store",
      "steps": [
        {
          "field": "name"
        }
      ]
    },
    {
      "part": 4,
      "path": "cart.line_count",
      "binding": "cart",
      "steps": [
        {
          "member": "domain.line_count"
        }
      ]
    }
  ],
  "collections": [
    "menu"
  ]
}
