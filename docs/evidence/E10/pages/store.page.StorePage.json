{
  "page": "store.page.StorePage",
  "route": "/stores/{id}",
  "params": [
    "id"
  ],
  "bindings": [
    {
      "binding": "store",
      "resource": "store.page.Store",
      "args": [
        "id"
      ],
      "policy": {
        "cache": "shared",
        "privacy": "public",
        "freshness_ms": 30000,
        "timeout_ms": 2000,
        "attempts": 1,
        "parallel": false,
        "key": [
          0
        ],
        "on_key_change": "cancel"
      },
      "not_found": [
        "not-found"
      ]
    },
    {
      "binding": "menu",
      "resource": "store.page.Menu",
      "args": [
        "id"
      ],
      "policy": {
        "cache": "shared",
        "privacy": "public",
        "freshness_ms": 300000,
        "timeout_ms": 2000,
        "attempts": 1,
        "parallel": false,
        "key": [
          0
        ],
        "on_key_change": "cancel"
      },
      "not_found": [
        "not-found"
      ]
    },
    {
      "binding": "cart",
      "resource": "store.page.Cart",
      "args": [
        "current_session()"
      ],
      "policy": {
        "cache": "private",
        "privacy": "session",
        "freshness_ms": 0,
        "timeout_ms": 2000,
        "attempts": 1,
        "parallel": false,
        "key": [
          0
        ],
        "on_key_change": "cancel"
      }
    }
  ],
  "parts": [
    {
      "part": 0,
      "path": "store.name",
      "binding": "store",
      "steps": [
        {
          "field": "name"
        }
      ]
    },
    {
      "part": 1,
      "path": "store.description",
      "binding": "store",
      "steps": [
        {
          "field": "description"
        }
      ]
    },
    {
      "part": 9,
      "path": "cart.line_count",
      "binding": "cart",
      "steps": [
        {
          "member": "domain.line_count"
        }
      ]
    }
  ],
  "collections": [
    "menu"
  ],
  "signals": [
    {
      "name": "notice",
      "initial": ""
    }
  ],
  "live": [
    {
      "part": 10,
      "signal": "notice",
      "path": "notice",
      "kind": "text"
    }
  ],
  "streams": [
    {
      "part": 2,
      "resource": "store.page.Estimate",
      "args": [
        "current_session()"
      ],
      "policy": {
        "cache": "private",
        "privacy": "session",
        "freshness_ms": 0,
        "timeout_ms": 3000,
        "attempts": 1,
        "parallel": false,
        "key": [
          0
        ],
        "on_key_change": "cancel"
      },
      "streamed": true
    },
    {
      "part": 12,
      "resource": "store.page.Recommendations",
      "args": [
        "id"
      ],
      "policy": {
        "cache": "shared",
        "privacy": "public",
        "freshness_ms": 600000,
        "timeout_ms": 3000,
        "attempts": 1,
        "parallel": false,
        "key": [
          0
        ],
        "on_key_change": "cancel"
      },
      "streamed": true
    }
  ]
}
