package pw:types {
    interface types {
        type capability-session-id = string;
        type capability-user-id = string;
        type clock-instant = s64;
        type clock-time-zone = string;
        type clock-local-date = s64;
        type clock-local-time = s64;
        variant clock-weekday {
            monday,
            tuesday,
            wednesday,
            thursday,
            friday,
            saturday,
            sunday,
        }
        type domain-store-id = string;
        type domain-menu-item-id = string;
        type domain-order-id = string;
        record domain-menu-item {
            id: domain-menu-item-id,
            store-id: domain-store-id,
            name: string,
            description: string,
            price: domain-money,
            available: bool,
            category: domain-menu-category,
        }
        type domain-category-id = string;
        record domain-menu-category {
            id: domain-category-id,
            name: string,
        }
        record domain-menu-section {
            category: domain-menu-category,
            items: list<domain-menu-item>,
        }
        type domain-positive-int = s64;
        type domain-money = s64;
        type domain-rate = s64;
        record domain-store-hours {
            opens-minute: s64,
            closes-minute: s64,
        }
        record domain-store {
            id: domain-store-id,
            name: string,
            description: string,
            cuisine: string,
            hours: domain-store-hours,
        }
        variant domain-store-error {
            not-found,
            unavailable,
            decode-failed(string),
        }
        record domain-cart-line {
            item-id: domain-menu-item-id,
            name: string,
            quantity: domain-positive-int,
            unit-price: domain-money,
        }
        record domain-cart {
            lines: list<domain-cart-line>,
        }
        variant domain-cart-error {
            item-unavailable(domain-menu-item-id),
            quantity-too-large,
            cart-expired,
            out-of-range(domain-store-id),
        }
        variant domain-order-status {
            placed,
            preparing,
            on-the-way,
            delivered,
        }
        variant domain-order-error {
            nothing-to-order,
            no-coverage,
            closed(domain-closing),
            promo(domain-promo-error),
            total-changed(domain-money),
        }
        variant domain-tip {
            no-tip,
            fifteen,
            eighteen,
            twenty,
            tip-amount(domain-money),
        }
        variant domain-promo-error {
            unknown-code,
            expired,
            below-minimum(domain-money),
            already-used,
            not-in-cart,
        }
        variant domain-tip-error {
            negative-tip,
            not-offered,
        }
        variant domain-funded-by {
            by-store,
            by-platform,
        }
        record domain-part-charged {
            store: domain-store-id,
            subtotal: domain-money,
            discount: domain-money,
            funded-by: option<domain-funded-by>,
            delivery: domain-money,
            service: domain-money,
            small-order: domain-money,
            taxable: domain-money,
            tax-rate: domain-rate,
            tax: domain-money,
        }
        record domain-order-charged {
            parts: list<domain-part-charged>,
            tip: domain-money,
            total: domain-money,
        }
        record domain-charges {
            subtotal: domain-money,
            discount: domain-money,
            delivery: domain-money,
            service: domain-money,
            small-order: domain-money,
            tax: domain-money,
            tip: domain-money,
            total: domain-money,
        }
        variant domain-closing {
            closed-now(option<domain-opening>),
            past-last-order(clock-local-time),
        }
        record domain-opening {
            day: domain-opening-day,
            at: clock-local-time,
        }
        variant domain-opening-day {
            today,
            tomorrow,
            on(clock-weekday),
        }
        record domain-order-progress {
            stage-label: string,
        }
        variant domain-tracking-error {
            order-not-found,
            tracking-unavailable,
        }
        record domain-order-failure {
            label: string,
        }
        record domain-delivery-estimate {
            min-minutes: domain-positive-int,
            max-minutes: domain-positive-int,
            generated-at: clock-instant,
        }
        variant domain-estimate-error {
            no-coverage,
            location-unavailable,
        }
        record domain-recommendation {
            id: domain-menu-item-id,
            name: string,
        }
        variant domain-recommendation-error {
            none-available,
            timeout,
        }
        type addresses-address-id = string;
        type addresses-place-id = string;
        type addresses-address-label = string;
        record addresses-address {
            id: addresses-address-id,
            label: string,
            place: string,
            chosen: bool,
        }
        record addresses-place {
            id: addresses-place-id,
            name: string,
        }
        record addresses-coverage {
            chosen: bool,
            delivers: bool,
            to: string,
            travel-minutes: s64,
        }
        variant addresses-address-error {
            unknown-place,
            too-many,
            no-such-address,
        }
        record saved-saved-items {
            items: list<domain-menu-item-id>,
            count: s64,
        }
        record user-carts-user-cart {
            lines: list<domain-cart-line>,
        }
        record store-page-menu-count {
            sections: s64,
            items: s64,
        }
        record store-checkout-fee-schedule {
            delivery-fee: domain-money,
            service-rate: domain-rate,
            service-min: domain-money,
            service-max: domain-money,
            small-order-under: domain-money,
            small-order-fee: domain-money,
            tax-rate: domain-rate,
            tax-delivery: bool,
            tax-service: bool,
        }
        record store-checkout-fees-of {
            store: domain-store-id,
            fees: store-checkout-fee-schedule,
        }
        variant store-checkout-promo-off {
            percent-off(domain-rate),
            amount-off(domain-money),
        }
        record store-checkout-promo {
            code: string,
            store: domain-store-id,
            off: store-checkout-promo-off,
            min-subtotal: domain-money,
            expires: clock-instant,
            funded-by: domain-funded-by,
        }
        record store-checkout-promo-found {
            promo: store-checkout-promo,
            used: bool,
        }
        record store-checkout-cart-part {
            store: domain-store-id,
            lines: list<domain-cart-line>,
        }
        record store-checkout-chosen {
            tip: domain-tip,
            promo: option<string>,
        }
        record store-checkout-priced {
            charged: domain-order-charged,
            charges: domain-charges,
            promo: option<string>,
            tip: domain-tip,
            said: string,
            any: bool,
            discount-said: string,
        }
        record store-hours-weekly-period {
            weekday: s64,
            opens: s64,
            closes: s64,
        }
        record store-hours-special-date {
            date: s64,
            closed: bool,
            opens: s64,
            closes: s64,
        }
        record store-hours-opening-hours {
            zone: string,
            last-order-minutes: s64,
            weekly: list<store-hours-weekly-period>,
            special: list<store-hours-special-date>,
        }
        record store-hours-opening-hours-of {
            store: domain-store-id,
            name: string,
            hours: store-hours-opening-hours,
        }
        record store-hours-open-until {
            until: clock-instant,
            last-order: clock-instant,
        }
        variant store-hours-open-state {
            open(store-hours-open-until),
            closed(option<clock-instant>),
        }
        record store-hours-status-shown {
            status: store-hours-open-state,
            open: bool,
            said: string,
        }
        record store-hours-listed-store {
            id: domain-store-id,
            name: string,
            description: string,
            cuisine: string,
            open: bool,
            said: string,
        }
        record store-search-dish-hit {
            id: domain-menu-item-id,
            name: string,
            description: string,
            category: string,
            price: domain-money,
        }
        record store-search-store-hit {
            id: domain-store-id,
            name: string,
            description: string,
            cuisine: string,
            dishes: list<store-search-dish-hit>,
            more-dishes: s64,
        }
        record store-search-search-found {
            stores: list<store-search-store-hit>,
            more-stores: s64,
            chosen: bool,
            to: string,
            beyond: s64,
        }
        variant store-search-search-error {
            blank,
            too-long,
        }
        record store-search-shown-store {
            id: domain-store-id,
            name: string,
            description: string,
            cuisine: string,
            open: string,
            dishes: list<store-search-dish-hit>,
            more: string,
        }
        record store-search-search-shown {
            asked: string,
            title: string,
            said: string,
            near: string,
            stores: list<store-search-shown-store>,
            more: string,
        }
    }
}

package pw:host {
    interface clock {
        use pw:types/types.{clock-instant, clock-local-date, clock-local-time, clock-time-zone};
        at: func(arg0: clock-local-date, arg1: clock-local-time, arg2: clock-time-zone) -> clock-instant;
        passed: func(arg0: clock-instant) -> bool;
        today: func(arg0: clock-time-zone) -> clock-local-date;
    }
    interface invalidations {
        use pw:types/types.{capability-user-id};
        store-page-cart: func(arg0: capability-user-id);
        store-page-checkout: func(arg0: capability-user-id);
        store-page-order-total: func(arg0: capability-user-id);
        store-page-order: func(arg0: capability-user-id);
        store-page-saved-addresses: func(arg0: capability-user-id);
    }
    interface outbox {
        use pw:types/types.{capability-user-id};
        addresses-changed: func(arg0: capability-user-id);
        user-cart-changed: func(arg0: capability-user-id);
        user-order-changed: func(arg0: capability-user-id);
    }
    interface principal {
        use pw:types/types.{capability-user-id};
        read: func() -> capability-user-id;
    }
    interface reads {
        use pw:types/types.{domain-menu-section, domain-store-id, store-page-menu-count};
        store-page-menu-size: func(arg0: domain-store-id) -> store-page-menu-count;
        store-page-menu: func(arg0: domain-store-id) -> list<domain-menu-section>;
    }
}

