{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "minimumVersion": "3.23.0",
  "entry": [
    "spikes/**/*.mjs",
    "spikes/**/*.js"
  ],
  "workspaces": {
    "patterns": [
      "spikes/*"
    ]
  },
  "ignoreFindings": [
    "spikes/pw-to-marko/src/routes/**",
    "spikes/reality-compiler/**"
  ],
  "duplicates": {
    "ignore": [
      "spikes/pw-to-marko/src/routes/**",
      "spikes/reality-compiler/**"
    ]
  },
  "health": {
    "ignore": [
      "spikes/pw-to-marko/src/routes/**",
      "spikes/reality-compiler/**"
    ]
  },
  "audit": {
    "gate": "new-only"
  }
}
