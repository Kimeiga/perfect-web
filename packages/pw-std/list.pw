// @corpus: platform
// @id: STD-list
// @category: standard library — collections
// @charter: §7.1
// @milestone: E2C

module List

// **Generic, with function-typed callbacks** (E9-V2, ADR-0031). Until
// 2026-09-24 no callable could bind a type parameter and there was no function
// type, so these were declared over `List<decode.Unknown>` with a `Decoder`
// record standing in for the callback — signatures a value checker would have
// had to refuse at every use or special-case by name. Each call now
// instantiates `T` and `U` from its own arguments.
//
// Pure by construction: every row declares `!{}`, so a body that stays inside
// `List` cannot acquire an effect. E2D reads these rows; nothing hard-codes
// "List.map is pure" in a checker.

//
// **Supplied by the compiler** (ADR-0040). Each operation is declared here with
// its type, and `intrinsic` names what the backend compiles it to. Until
// 2026-09-25 these had placeholder bodies: `map` returned `[]` and `length`
// returned 0, and programs type-checked against them and computed nothing.

fn map<T, U>(items: List<T>, f: fn(T) -> U) -> List<U> !{}
    intrinsic "list.map"

fn fold<T, A>(items: List<T>, seed: A, f: fn(A, T) -> A) -> A !{}
    intrinsic "list.fold"

fn filter<T>(items: List<T>, f: fn(T) -> Bool) -> List<T> !{}
    intrinsic "list.filter"

fn length<T>(items: List<T>) -> Int !{}
    intrinsic "list.length"

// `Some` of the element at `index`, counting from 0, and `None` outside.
fn get<T>(items: List<T>, index: Int) -> Option<T> !{}
    intrinsic "list.get"

// The first `count` elements: all of them when there are fewer, none when
// `count` is negative.
fn take<T>(items: List<T>, count: Int) -> List<T> !{}
    intrinsic "list.take"

fn concat<T>(first: List<T>, second: List<T>) -> List<T> !{}
    intrinsic "list.concat"

fn any<T>(items: List<T>, f: fn(T) -> Bool) -> Bool !{}
    intrinsic "list.any"

fn all<T>(items: List<T>, f: fn(T) -> Bool) -> Bool !{}
    intrinsic "list.all"

// The first element `f` accepts.
fn find<T>(items: List<T>, f: fn(T) -> Bool) -> Option<T> !{}
    intrinsic "list.find"

// Stable. `compare(a, b)` above zero puts `b` before `a`.
fn sort_by<T>(items: List<T>, compare: fn(T, T) -> Int) -> List<T> !{}
    intrinsic "list.sort_by"

// Runs of consecutive elements with equal keys, in order: sort by the key
// first to group every element that has it.
fn group_by<T>(items: List<T>, key: fn(T) -> String) -> List<List<T>> !{}
    intrinsic "list.group_by"

// The language has no tuple type, so a position and an element cannot be one
// value's type yet. The result is therefore not annotated — a hole, not a
// claim — and `for (i, v) in List.enumerate(xs)` binds by pattern.
fn enumerate<T>(items: List<T>) !{} { [] }

// Floats, because every caller sums measured lengths. The language has no
// numeric abstraction, so an `Int` sum is a separate declaration when one is
// needed rather than a claim this one could make.
fn sum(items: List<Float>) -> Float !{} { 0.0 }

fn maximum(items: List<Float>) -> Float !{} { 0.0 }
