// @corpus: platform
// @id: STD-decode
// @category: standard library — boundary decoding
// @charter: §7.3, §14 M4
// @milestone: E2C
//
// E2C's first slice. Interface declarations that the ordinary resolver and the
// ordinary semantic analyses consume — not a table inside a checker.
//
// Architect ruling, 2026-08-06:
//
//   standard-library/platform source -> compiled signature manifest ->
//   the same resolver and semantic checkers used for user modules
//
// Bodies are absent on purpose: this declares what exists and what it costs,
// not how it is implemented. E1A owns the decoder semantics
// (`compiler/pw-core/src/abi.rs`), and this is the surface those semantics are
// reached through.

module decode

// A value that has crossed a boundary and has not been checked yet. E0 finding
// F-4 measured that a backend can represent two distinct `pw` types
// identically, so nothing arrives typed; it arrives Unknown.
opaque type Unknown = String

type DecodeError =
    | Missing(String)
    | WrongType(String)
    | Invalid(String, String)

// A named description of a decoder, for a program that wants to pass one
// around as data. The decoders themselves are FUNCTIONS: `string`, `int`, or
// any `fn(Unknown) -> Result<T, DecodeError>` the program declares.
type Decoder = Decoder { name: String }

// **The decoder decides what the field is** (E9-V2, 2026-09-24). This returned
// `Result<Unknown, DecodeError>` whatever decoder it was given, with the
// decoder declared as the `Decoder` record — so `field(raw, "id", string)?`
// was still an undecoded `Unknown`, and passing it where a `String` is
// required was exactly the unchecked external value this module exists to
// prevent. A value checker reported it in A-012 the first time it ran.
fn field<T>(raw: Unknown, name: String, inner: fn(Unknown) -> Result<T, DecodeError>) -> Result<T, DecodeError> !{} {
    Err(DecodeError.Missing(name))
}

fn string(raw: Unknown) -> Result<String, DecodeError> !{} {
    Err(DecodeError.WrongType("String"))
}

fn int(raw: Unknown) -> Result<Int, DecodeError> !{} {
    Err(DecodeError.WrongType("Int"))
}

fn list<T>(raw: Unknown, inner: fn(Unknown) -> Result<T, DecodeError>) -> Result<List<T>, DecodeError> !{} {
    Err(DecodeError.WrongType("List"))
}
