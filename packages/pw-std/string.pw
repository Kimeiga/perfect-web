// @corpus: platform
// @id: STD-string
// @category: standard library — text
// @charter: §7.1
// @milestone: E10

module String

// **Text, by Unicode code point** (ADR-0040). A `String` is UTF-8. `length`
// counts code points, not bytes, and `codepoints` reads the scalar values. The
// compiler supplies every operation; `intrinsic` names which.

fn length(text: String) -> Int !{}
    intrinsic "string.length"

fn codepoints(text: String) -> List<Int> !{}
    intrinsic "string.codepoints"

// A value that is not a Unicode scalar value, a surrogate or one past
// U+10FFFF, stops the invocation.
fn from_codepoints(points: List<Int>) -> String !{}
    intrinsic "string.from_codepoints"

fn starts_with(text: String, prefix: String) -> Bool !{}
    intrinsic "string.starts_with"

fn ends_with(text: String, suffix: String) -> Bool !{}
    intrinsic "string.ends_with"

fn contains(text: String, part: String) -> Bool !{}
    intrinsic "string.contains"

fn join(parts: List<String>, separator: String) -> String !{}
    intrinsic "string.join"

// Unicode `White_Space` removed from both ends, as Rust's `str::trim`.
fn trim(text: String) -> String !{}
    intrinsic "string.trim"

// The code points from `start` up to, not including, `end`. Each bound is
// clamped to the text, and an `end` before `start` gives "" (ADR-0055).
fn slice(text: String, start: Int, end: Int) -> String !{}
    intrinsic "string.slice"

// `A`-`Z` to `a`-`z`, and nothing else (ADR-0040, ruling needed).
fn to_lower_ascii(text: String) -> String !{}
    intrinsic "string.to_lower_ascii"

// **Unicode case mapping** (ADR-0056): each code point's lower or upper case,
// as Unicode 17.0 maps it, one code point at a time. `ß` uppers to `SS` and
// `İ` lowers to `i` and a combining dot. No rule looks at a code point's
// neighbours, so a word-final capital sigma lowers to `σ`, not `ς` (ruling
// needed).
fn to_lower(text: String) -> String !{}
    intrinsic "string.to_lower"

fn to_upper(text: String) -> String !{}
    intrinsic "string.to_upper"
