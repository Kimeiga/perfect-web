// @corpus: platform
// @id: PLATFORM-events
// @category: platform — DOM events
// @charter: §8.2
// @milestone: E9
//
// Which event an `on:` attribute delivers is a platform fact, so it is
// declared here rather than listed in the compiler. `on:submit` resolves to
// `events.submit`, whose parameter type IS the event type — so a handler is
// checked against a signature, and declaring a new event is a change to this
// file rather than to a checker.

module events

// Each record is what the browser's runtime reads in the listener, before
// any code loads, and gives the handler (ADR-0131, ADR-0138). `prevented`
// says whether the form's own submission was stopped: `on:submit|prevent`.
type SubmitEvent = SubmitEvent { prevented: Bool }

type PressEvent = PressEvent { x: Int, y: Int }

type InputEvent = InputEvent { value: String }

type KeyEvent = KeyEvent { key: String }

type ChangeEvent = ChangeEvent { value: String }

// A dialog closed, by Escape or by the page (ADR-0141): its return value,
// what a `<form method="dialog">`'s button gave it.
type CloseEvent = CloseEvent { value: String }

fn submit(event: SubmitEvent) -> () !{} { () }

fn press(event: PressEvent) -> () !{} { () }

fn input(event: InputEvent) -> () !{} { () }

fn keydown(event: KeyEvent) -> () !{} { () }

fn change(event: ChangeEvent) -> () !{} { () }

fn close(event: CloseEvent) -> () !{} { () }
