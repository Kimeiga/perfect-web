// @corpus: platform
// @id: PLATFORM-browser
// @category: platform — browser handles
// @charter: §7.5A, §11.1
// @milestone: E2C

module browser

// A live DOM node. Exists only where the document does, which is why the
// placement solver treats a `Device`-restricted or `dom`-effecting body as
// browser-only.
opaque type Element = String

// A third-party map widget's handle. The corpus uses it for the audited
// imperative-escape case (A-024, R-044): an external implementation reached
// through a declared interface.
opaque type MapHandle = String

type MapError =
    | InitFailed(String)
    | Unsupported

// A reference to a live element, as a view holds one.
opaque type ElementRef = String

// An element's style, as a value with a type. `self.style.set_padding(..)` then
// resolves member by member — `self` is an `ElementRef`, `.style` is a `Style`,
// `.set_padding` is a member of `Style` — instead of by "exactly one module
// declares a `set_padding`", which is an accident of the program rather than a
// fact about it.
opaque type Style = String

fn style(el: ElementRef) -> Style !{} { todo }

type Rect = Rect {
    width: Float,
    height: Float,
    top: Float,
    left: Float,
}

// --- geometry -------------------------------------------------------------
//
// Charter §7.5A bans ordinary code from calling `offsetWidth` or
// `getBoundingClientRect` directly. It is banned because it FORCES A
// SYNCHRONOUS REFLOW, and that is a fact about these accessors — so it is
// written here, in their rows, rather than as a list of property names inside
// a checker. `pw` code reaches geometry through a scheduled measure phase; the
// corpus's rejected files reach it directly, and these rows are what make that
// visible.

fn offsetWidth(el: ElementRef) -> Float !{ layout.measure } { 0.0 }

fn offsetHeight(el: ElementRef) -> Float !{ layout.measure } { 0.0 }

fn scrollTop(el: ElementRef) -> Float !{ layout.measure } { 0.0 }

fn clientWidth(el: ElementRef) -> Float !{ layout.measure } { 0.0 }

fn getBoundingClientRect(el: ElementRef) -> Rect !{ layout.measure } {
    Rect(0.0, 0.0, 0.0, 0.0)
}

fn content_width(el: ElementRef) -> Float !{ layout.measure } { 0.0 }

fn height(el: ElementRef) -> Float !{ layout.measure } { 0.0 }
