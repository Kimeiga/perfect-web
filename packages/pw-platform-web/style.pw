// @corpus: platform
// @id: PLATFORM-style
// @category: platform — layout and style
// @charter: §7.5A
// @milestone: E2C
//
// Charter v2 §7.5A's frame-phase families. The distinction the layout corpus
// turns on is here in the rows: reading geometry is `layout.measure`, and a
// write that can invalidate it is `style.mutate<LayoutAffect>` — so a read
// after such a write is visible to an effect checker rather than to a reviewer.

module style

import browser.{ Element }

fn measure(el: Element) -> Int !{ layout.measure } { 0 }

fn mutate(el: Element, property: String, value: String) -> () !{ style.mutate } { () }

fn mutate_layout_affecting(el: Element, property: String, value: String) -> ()
    !{ style.mutate, layout.invalidate }
{
    ()
}

fn composite(el: Element, property: String, value: String) -> ()
    !{ animation.composite }
{
    ()
}

// The setters the corpus uses. The split is the point: width, height and
// padding invalidate layout, so a geometry read after one of them is a forced
// synchronous reflow (corpus R-034). A custom property does not.

fn set_width(el: Element, value: String) -> () !{ style.mutate, layout.invalidate } { () }

fn set_height(el: Element, value: String) -> () !{ style.mutate, layout.invalidate } { () }

fn set_padding(el: Element, value: String) -> () !{ style.mutate, layout.invalidate } { () }

fn set_custom(el: Element, property: String, value: String) -> () !{ style.mutate } { () }
