// @corpus: platform
// @id: PLATFORM-style
// @category: platform — layout and style
// @charter: §7.5A
// @milestone: E2C
//
// Charter v2 §7.5A's frame-phase families. The distinction the layout corpus
// turns on is here in the rows: reading geometry is `layout.measure`, and a
// write that can invalidate it is `style.mutate<LayoutAffect>` — so a read
// after such a write is visible to an effect checker rather than to a reviewer.

module style

import browser.{ Element, Style }

fn measure(el: Element) -> Int !{ layout.measure } { 0 }

fn mutate(el: Style, property: String, value: String) -> () !{ style.mutate } { () }

// Charter §7.5A's own spelling. The type argument is the point: a write that
// can invalidate layout is a DIFFERENT effect from one that cannot, and naming
// them the same would make the distinction a comment.
fn mutate_layout_affecting(el: Style, property: String, value: String) -> ()
    !{ style.mutate<LayoutAffect> }
{
    ()
}

fn composite(el: Style, property: String, value: String) -> ()
    !{ animation.composite }
{
    ()
}

// The setters the corpus uses. The split is the point: width, height and
// padding invalidate layout, so a geometry read after one of them is a forced
// synchronous reflow (corpus R-034). A custom property does not.

fn set_width(el: Style, value: String) -> () !{ style.mutate<LayoutAffect> } { () }

fn set_height(el: Style, value: String) -> () !{ style.mutate<LayoutAffect> } { () }

fn set_padding(el: Style, value: String) -> () !{ style.mutate<LayoutAffect> } { () }

fn set_custom(el: Style, property: String, value: String) -> () !{ style.mutate } { () }

// The compositor-only properties. Charter §7.5A: `animation.composite` runs off
// the main thread, which is possible exactly because these two do not
// invalidate layout. Declaring them here rather than listing them in the
// compiler is what lets the animation check ask a signature "can this property
// be composited?" instead of consulting a table of property names.

fn set_transform(el: Style, value: String) -> () !{ animation.composite } { () }

fn set_opacity(el: Style, value: String) -> () !{ animation.composite } { () }
