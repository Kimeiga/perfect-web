// @corpus: platform
// @id: PLATFORM-secrets
// @category: platform — secret material
// @charter: §7.8, §11
// @milestone: E2C
//
// The signature the architect used as the worked example:
//
//   secrets.payments : () -> <secret.read<Payments>> Secret<Payments>
//
// One declaration, three consumers. The effect row `secret.read` tells the
// placement solver only the origin may run this; the return type tells the
// privacy checker the value is `Secret<Payments>`. Neither fact is hard-coded
// in a checker any more.

module secrets

import capability.{ Secret }

fn payments() -> Secret !{ secret.read } { Secret("") }

fn signing_key() -> Secret !{ secret.read } { Secret("") }
