        "value": "\n                </ul>\n            </section>\n\n            <section aria-labelledby=\"cart-heading\">\n                \n                <h2 id=\"cart-heading\" tabindex=\"-1\">Cart</h2>\n                <p aria-live=\"polite\" aria-atomic=\"true\">Items in cart: <span id=\"cart-count\">"
