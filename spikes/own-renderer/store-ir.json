        "chunk": "dynamic",
        "value": {
          "part": "text",
          "id": 1,
          "value": "store.description",
          "context": "text"
        }
      },
      {
        "chunk": "static",
        "value": "</p>\n\n            <section aria-label=\"Delivery\" aria-live=\"polite\">\n                "
      },
