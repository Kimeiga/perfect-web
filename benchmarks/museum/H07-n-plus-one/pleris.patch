+// Each item's price, read one item at a time: one round trip per item
+// on the menu, after the one that reads the menu.
+public query MenuPrices(id: StoreId) -> List<Result<Int, StoreError>>
+    freshness     5.minutes
+    consistency   snapshot
+    cache         shared
+    key           id
+    concurrency   one_per_key
+    on_key_change cancel
+    timeout       2.seconds
+{
+    match Menus.for_store(id) {
+        Ok(items) => List.map(items, item => Menus.price(item.id)),
+        Err(_) => [],
+    }
+}
