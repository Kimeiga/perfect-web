+// Each item's price, in cents, held as a database would hold it: reading
+// one is one round trip, and the round trips are counted.
+const PRICES: Record<MenuItemId, number> = { espresso: 300, cortado: 425, "cold-brew": 500 };
+const queries: { n: number } =
+  ((globalThis as Record<string, unknown>).__pwBenchQueries as { n: number }) ?? { n: 0 };
+(globalThis as Record<string, unknown>).__pwBenchQueries = queries;
+
+async function roundTrip(): Promise<void> {
+  queries.n += 1;
+  await new Promise((resolve) => setTimeout(resolve, 20));
+}
+
+/** One item's price: one round trip. */
+export async function getPrice(item: MenuItemId): Promise<number> {
+  await roundTrip();
+  return PRICES[item] ?? 0;
+}
+
+/** Several items' prices: one round trip for all of them. */
+export async function getPrices(items: MenuItemId[]): Promise<number[]> {
+  await roundTrip();
+  return items.map((item) => PRICES[item] ?? 0);
+}
+
+/** How many round trips the database has served. */
+export function queryCount(): number {
+  return queries.n;
+}
+
