@@ -0,0 +1,10 @@
+import { addToCart, isMenuItem } from "@/lib/store";
+import { ensureSession } from "@/lib/session";
+
+/** Add one of an item to the session's cart: `{ store, item }`. */
+export async function POST(request: Request) {
+  const { store, item } = (await request.json()) as { store: string; item: string };
+  if (!isMenuItem(store, item)) return new Response("no such item", { status: 400 });
+  addToCart(await ensureSession(), item, 1);
+  return Response.json({ added: item });
+}
