@@ -0,0 +1,13 @@
+import { getCart, lineCount } from "@/lib/store";
+import { currentSession } from "@/lib/session";
+
+// The session's cart, on a page of its own.
+export default async function CartPage() {
+  const cart = getCart(await currentSession());
+  return (
+    <main>
+      <h1>Your cart</h1>
+      <p id="cart-page-count">{lineCount(cart)}</p>
+    </main>
+  );
+}
