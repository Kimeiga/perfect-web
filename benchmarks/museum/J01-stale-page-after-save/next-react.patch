--- /dev/null
+++ b/app/stores/[storeId]/AddAndView.tsx
@@ -0,0 +1,21 @@
+"use client";
+
+import { useRouter } from "next/navigation";
+
+// Saves, then goes to the cart: `router.push` from an event handler, the way
+// to navigate from a handler.
+export function AddAndView({ store, item }: { store: string; item: string }) {
+  const router = useRouter();
+  return (
+    <button
+      id="add-and-view"
+      type="button"
+      onClick={async () => {
+        await fetch("/api/cart", { method: "POST", body: JSON.stringify({ store, item }) });
+        router.push(`/stores/${store}/cart`);
+      }}
+    >
+      Add and view cart
+    </button>
+  );
+}
