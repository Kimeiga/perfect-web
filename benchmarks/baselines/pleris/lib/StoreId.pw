// @corpus: fixture
// @id: LIB-StoreId
// @category: application — parsing an opaque id
// @charter: §7.1, §15.1
// @milestone: E2C
//
// An opaque id cannot be constructed from a raw String by assignment; it is
// parsed, and parsing can fail. That is what `opaque` is for (E0 finding F-4).

module StoreId

import domain.{ StoreId }
import decode.{ DecodeError }

// A decoding step, so its failure is a decode failure. It returned
// `StoreError`, and A-012 propagates it with `?` out of a function whose error
// is `DecodeError` — a mismatch invisible while `?` had no node in the HIR.
fn from_string(raw: String) -> Result<StoreId, DecodeError> !{} {
    Err(DecodeError.Invalid("id", raw))
}
