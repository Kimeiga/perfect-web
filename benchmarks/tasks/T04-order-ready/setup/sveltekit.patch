@@ -0,0 +1,18 @@
+import { json, type RequestHandler } from "@sveltejs/kit";
+import { ensureSession } from "$lib/server/session";
+import { isOrderStatus, setOrder } from "$lib/server/store";
+
+/** The kitchen sets the session's order: `?status=preparing`, or no status to
+ * remove it. A benchmark's hook, as every stack in it has one. */
+export const POST: RequestHandler = ({ url, cookies }) => {
+  const status = url.searchParams.get("status") ?? "";
+  if (!status) {
+    setOrder(ensureSession(cookies), undefined);
+    return json({});
+  }
+  if (!isOrderStatus(status)) {
+    return json({ error: `no order status ${status}` }, { status: 400 });
+  }
+  setOrder(ensureSession(cookies), status);
+  return json({});
+};
