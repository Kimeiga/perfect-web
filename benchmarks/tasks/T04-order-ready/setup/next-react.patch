+import { NextResponse, type NextRequest } from "next/server";
+import { ensureSession } from "@/lib/session";
+import { isOrderStatus, setOrder } from "@/lib/store";
+
+/** The kitchen sets the session's order: `?status=preparing`, or no status to
+ * remove it. A benchmark's hook, as every stack in it has one. */
+export async function POST(request: NextRequest) {
+  const status = request.nextUrl.searchParams.get("status") ?? "";
+  if (!status) {
+    setOrder(await ensureSession(), undefined);
+    return NextResponse.json({});
+  }
+  if (!isOrderStatus(status)) {
+    return NextResponse.json({ error: `no order status ${status}` }, { status: 400 });
+  }
+  setOrder(await ensureSession(), status);
+  return NextResponse.json({});
+}
