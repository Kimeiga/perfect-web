+/** Where a customer's order is: what the kitchen last said. */
+export type OrderStatus = "placed" | "preparing" | "delivered";
+
+/** Every status the kitchen may set. */
+export const ORDER_STATUSES: readonly OrderStatus[] = ["placed", "preparing", "delivered"];
+
+const orders: Map<string, OrderStatus> =
+  ((globalThis as Record<string, unknown>).__pwBenchOrders as Map<string, OrderStatus>) ??
+  new Map();
+(globalThis as Record<string, unknown>).__pwBenchOrders = orders;
+
+/** The session's order, as the kitchen last set it; none before there is one. */
+export function getOrder(session: string | undefined): OrderStatus | undefined {
+  return session ? orders.get(session) : undefined;
+}
+
+/** The kitchen sets a session's order, or removes it. */
+export function setOrder(session: string, status: OrderStatus | undefined): void {
+  if (status) orders.set(session, status);
+  else orders.delete(session);
+}
+
+export function isOrderStatus(status: string): status is OrderStatus {
+  return (ORDER_STATUSES as readonly string[]).includes(status);
+}
