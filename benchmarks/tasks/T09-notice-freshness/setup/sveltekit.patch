+
+/** Post the store's notice at the board: `?text=…`. Nothing is told that it
+ * changed. A benchmark's hook, as every stack in it has one. */
+export const POST: RequestHandler = ({ url }) => {
+  postNotice(url.searchParams.get("text") ?? "");
+  return json({});
+};
