+/** The store's notice board: what it has posted, and how often it has been
+ * asked. Asking it is expensive. A benchmark's hook posts a notice. */
+const board: { text: string; calls: number } =
+  ((globalThis as Record<string, unknown>).__pwBenchNotices as {
+    text: string;
+    calls: number;
+  }) ?? { text: "Open until 7 pm", calls: 0 };
+(globalThis as Record<string, unknown>).__pwBenchNotices = board;
+
+/** Ask the board for the store's notice. Expensive: every call is counted. */
+async function askBoard(store: StoreId): Promise<string> {
+  board.calls += 1;
+  await new Promise((resolve) => setTimeout(resolve, 50));
+  if (!STORES[store]) throw new Error(`no store ${store}`);
+  return board.text;
+}
+
+/** Post a notice on the board, as the store's staff do. */
+export function postNotice(text: string): void {
+  board.text = text;
+}
+
+/** How many times the board has been asked. */
+export function noticeCalls(): number {
+  return board.calls;
+}
+
+/** How long a notice is kept: five minutes. */
+const NOTICE_KEPT_MS = 5 * 60 * 1000;
+
+const kept: Map<StoreId, { text: string; at: number }> =
+  ((globalThis as Record<string, unknown>).__pwBenchNoticeKept as Map<
+    StoreId,
+    { text: string; at: number }
+  >) ?? new Map();
+(globalThis as Record<string, unknown>).__pwBenchNoticeKept = kept;
+
+/** The store's notice, kept five minutes, so the board is asked at most once
+ * in that time. */
+export async function getNotice(store: StoreId): Promise<string> {
+  const hit = kept.get(store);
+  if (hit && Date.now() - hit.at < NOTICE_KEPT_MS) return hit.text;
+  const text = await askBoard(store);
+  kept.set(store, { text, at: Date.now() });
+  return text;
+}
+
 /** How many items the cart holds: what the page shows. */
 export function lineCount(cart: Cart): number {
   return cart.lines.reduce((n, line) => n + line.quantity, 0);
