+// @category: the store's data layer — a store's notice board
+// @charter: §15
+// @milestone: E14
+//
+// What a store has posted for its customers (E14, T09), from the host's data
+// layer. Asking the board is expensive.
+
+module Notices
+
+import domain.{ StoreId, StoreError }
+
+// The store's notice, as last posted.
+fn current(store: StoreId) -> Result<String, StoreError> !{ database.read<Notices> }
+    host "store:data/notices#current"
