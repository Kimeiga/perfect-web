+"use client";
+
+import { useState, type FormEvent } from "react";
+
+// Ask for an item the store does not sell. Answered on the page: the field
+// is labelled, the error is its description and is announced, and so is
+// the thanks.
+export function RequestForm() {
+  const [requested, setRequested] = useState("");
+  const [problem, setProblem] = useState("");
+  const [thanks, setThanks] = useState("");
+
+  function submit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (requested === "") {
+      setProblem("Enter an item to request.");
+      setThanks("");
+      return;
+    }
+    setProblem("");
+    setThanks(`Thanks! We'll ask the store about ${requested}.`);
+    setRequested("");
+  }
+
+  return (
+    <section aria-label="Request an item">
+      <form onSubmit={submit}>
+        <label htmlFor="request">Item to request</label>
+        <input
+          id="request"
+          type="text"
+          value={requested}
+          onChange={(e) => setRequested(e.target.value)}
+          aria-invalid={problem !== ""}
+          aria-describedby="request-error"
+        />
+        <button type="submit">Request</button>
+      </form>
+      <p id="request-error" role="alert">
+        {problem}
+      </p>
+      <p role="status">{thanks}</p>
+    </section>
+  );
+}
