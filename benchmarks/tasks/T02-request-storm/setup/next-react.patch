@@ -0,0 +1,13 @@
+import { NextResponse, type NextRequest } from "next/server";
+import { setPrepMinutes } from "@/lib/store";
+
+/** Change the kitchen's prep time: `?minutes=…`. Nothing is told that it
+ * changed. A benchmark's hook, as every stack in it has one. */
+export async function POST(request: NextRequest) {
+  const minutes = Number(request.nextUrl.searchParams.get("minutes"));
+  if (!Number.isInteger(minutes)) {
+    return NextResponse.json({ error: "minutes" }, { status: 400 });
+  }
+  setPrepMinutes(minutes);
+  return NextResponse.json({});
+}
