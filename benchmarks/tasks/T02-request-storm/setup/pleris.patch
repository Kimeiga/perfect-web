+// @category: the store's data layer — the kitchen's prep time
+// @charter: §15
+// @milestone: E14
+//
+// How long the kitchen takes to prepare an order now (E14, T02), from the
+// host's data layer. Asking the kitchen is slow.
+
+module Kitchen
+
+import domain.{ StoreId, StoreError }
+
+// The kitchen's prep time now, in minutes.
+fn prep_minutes(store: StoreId) -> Result<Int, StoreError> !{ database.read<Kitchen> }
+    host "store:data/kitchen#prep-minutes"
