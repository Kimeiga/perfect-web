@@ -0,0 +1,11 @@
+import { error, json, type RequestHandler } from "@sveltejs/kit";
+import { setPrepMinutes } from "$lib/server/store";
+
+/** Change the kitchen's prep time: `?minutes=…`. Nothing is told that it
+ * changed. A benchmark's hook, as every stack in it has one. */
+export const POST: RequestHandler = ({ url }) => {
+  const minutes = Number(url.searchParams.get("minutes"));
+  if (!Number.isInteger(minutes)) error(400, "minutes");
+  setPrepMinutes(minutes);
+  return json({});
+};
