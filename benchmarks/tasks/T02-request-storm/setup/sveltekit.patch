+/** The kitchen: how long an order takes now, and how often it has been
+ * asked. Asking it is slow. A benchmark's hook changes the prep time. */
+const kitchen: { minutes: number; calls: number } =
+  ((globalThis as Record<string, unknown>).__pwBenchKitchen as {
+    minutes: number;
+    calls: number;
+  }) ?? { minutes: 12, calls: 0 };
+(globalThis as Record<string, unknown>).__pwBenchKitchen = kitchen;
+
+/** Ask the kitchen how long an order takes now. Slow: every call is counted. */
+async function askKitchen(store: StoreId): Promise<number> {
+  kitchen.calls += 1;
+  const minutes = kitchen.minutes;
+  await new Promise((resolve) => setTimeout(resolve, 300));
+  if (!STORES[store]) throw new Error(`no store ${store}`);
+  return minutes;
+}
+
+/** Change the kitchen's prep time, as a busy kitchen does. */
+export function setPrepMinutes(minutes: number): void {
+  kitchen.minutes = minutes;
+}
+
+/** How many times the kitchen has been asked. */
+export function prepCalls(): number {
+  return kitchen.calls;
+}
+
+/** The kitchen's prep time for the store. A prep time is a promise to the
+ * customer, so it is never kept: each page asks the kitchen. */
+export function getPrepTime(store: StoreId): Promise<number> {
+  return askKitchen(store);
+}
+
 /** How many items the cart holds: what the page shows. */
 export function lineCount(cart: Cart): number {
   return cart.lines.reduce((n, line) => n + line.quantity, 0);
