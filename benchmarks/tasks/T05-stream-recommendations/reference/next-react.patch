+/** The store's recommendations, streamed in when the recommender answers. */
+async function Recommendations({ store }: { store: string }) {
+  let items;
+  try {
+    items = await getRecommendations(store);
+  } catch {
+    return <p>No recommendations right now</p>;
+  }
+  return (
+    <ul>
+      {items.map((item) => (
+        <li key={item.id}>{item.name}</li>
+      ))}
+    </ul>
+  );
+}
