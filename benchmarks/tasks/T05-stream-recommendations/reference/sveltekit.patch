diff --git a/src/routes/stores/[storeId]/+page.server.ts b/src/routes/stores/[storeId]/+page.server.ts
index 1cebba6..2732b1d 100644
--- a/src/routes/stores/[storeId]/+page.server.ts
+++ b/src/routes/stores/[storeId]/+page.server.ts
@@ -1,16 +1,31 @@
 import { error, fail } from "@sveltejs/kit";
 import type { Actions, PageServerLoad } from "./$types";
-import { addToCart, clearCart, getCart, getMenu, getStore, isMenuItem, lineCount } from "$lib/server/store";
+import {
+  addToCart,
+  clearCart,
+  getCart,
+  getMenu,
+  getRecommendations,
+  getStore,
+  isMenuItem,
+  lineCount,
+} from "$lib/server/store";
 import { currentSession, ensureSession } from "$lib/server/session";
 
 export const load: PageServerLoad = ({ params, cookies }) => {
   const store = getStore(params.storeId);
   const menu = getMenu(params.storeId);
   if (!store || !menu) error(404, "no such store");
+  // Not awaited: it streams to the page when the recommender answers. Its
+  // failure is handled here, so one before the page renders does not end the
+  // server (SvelteKit's docs, "Streaming with promises").
+  const recommendations = getRecommendations(params.storeId);
+  recommendations.catch(() => {});
   return {
     store,
     menu,
     cartCount: lineCount(getCart(currentSession(cookies))),
+    recommendations,
   };
 };
 
