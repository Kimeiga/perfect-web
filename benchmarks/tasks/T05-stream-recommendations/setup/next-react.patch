+/** What the recommender suggests for a store. */
+export type Recommendation = { id: MenuItemId; name: string };
+
+/** How the recommender behaves: how long it takes to answer, whether it
+ * fails, and what it suggests. A benchmark's hook sets it. */
+type Recommender = { delayMs: number; fail: boolean; items: Recommendation[] };
+
+const RECOMMENDER: Recommender = {
+  delayMs: 1200,
+  fail: false,
+  items: [
+    { id: "cortado", name: "Cortado" },
+    { id: "cold-brew", name: "Cold Brew" },
+  ],
+};
+
+const recommender: { now: Recommender } =
+  ((globalThis as Record<string, unknown>).__pwBenchRecommender as { now: Recommender }) ?? {
+    now: RECOMMENDER,
+  };
+(globalThis as Record<string, unknown>).__pwBenchRecommender = recommender;
+
+/** The store's recommendations, from the recommender. Slow: it takes over a
+ * second to answer, and it can fail. */
+export async function getRecommendations(store: StoreId): Promise<Recommendation[]> {
+  const { delayMs, fail, items } = recommender.now;
+  await new Promise((resolve) => setTimeout(resolve, delayMs));
+  if (fail || !STORES[store]) throw new Error("the recommender is unavailable");
+  return items;
+}
+
+/** Set how the recommender behaves; what is not given, as it was at the start. */
+export function setRecommender(change: Partial<Recommender>): void {
+  recommender.now = { ...RECOMMENDER, ...change };
+}
