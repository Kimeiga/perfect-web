+import { NextResponse, type NextRequest } from "next/server";
+import { setRecommender } from "@/lib/store";
+
+/** Set how the recommender behaves: `?delay=2000` milliseconds, `?fail=host`,
+ * `?items=mocha:Mocha,latte:Latte`; with nothing, as it was at the start. A
+ * benchmark's hook, as every stack in it has one. */
+export async function POST(request: NextRequest) {
+  const q = request.nextUrl.searchParams;
+  const delay = q.get("delay");
+  const items = q.get("items");
+  setRecommender({
+    ...(delay ? { delayMs: Number(delay) } : {}),
+    ...(q.get("fail") ? { fail: true } : {}),
+    ...(items
+      ? {
+          items: items.split(",").map((pair) => {
+            const [id, name] = pair.split(":");
+            return { id, name };
+          }),
+        }
+      : {}),
+  });
+  return NextResponse.json({});
+}
