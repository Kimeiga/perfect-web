+// **The menu's items in a category** (E14, T07). The page reads it again
+// when its category changes. Reading a category can be slow, so one read at
+// a time: a new category is read once the one before it has answered.
+public query MenuIn(id: StoreId, category: String) -> Result<List<MenuItem>, StoreError>
+    freshness     0.seconds
+    consistency   snapshot
+    concurrency   one_per_key
+    on_key_change keep
+    timeout       5.seconds
+{
+    Categories.items(id, category)
+}
