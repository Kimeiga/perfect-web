+// @corpus: fixture
+// @id: E14-categories
+// @category: the store's data layer — the menu by category
+// @charter: §15
+// @milestone: E14
+//
+// The menu's items in one category (E14, T07), from the host's data layer.
+// One category can be slow to read.
+
+module Categories
+
+import domain.{ StoreId, StoreError, MenuItem }
+
+// The store's menu items in `category`: `hot`, `cold`, or `all` of them.
+fn items(store: StoreId, category: String) -> Result<List<MenuItem>, StoreError> !{ database.read<Categories> }
+    host "store:data/menus#in-category"
