+/** Each menu item's category: hot or cold. */
+const CATEGORY: Record<MenuItemId, string> = {
+  espresso: "hot",
+  cortado: "hot",
+  "cold-brew": "cold",
+};
+
+/** Which category is slow to read, and how slow. A benchmark's hook sets
+ * it. */
+const slowness: { category: string | null; delayMs: number } =
+  ((globalThis as Record<string, unknown>).__pwBenchSlowness as {
+    category: string | null;
+    delayMs: number;
+  }) ?? { category: null, delayMs: 0 };
+(globalThis as Record<string, unknown>).__pwBenchSlowness = slowness;
+
+/** Make one category slow to read, as a busy kitchen's is. */
+export function setSlowCategory(category: string | null, delayMs: number): void {
+  slowness.category = category;
+  slowness.delayMs = delayMs;
+}
+
+/** How long reading a category takes, in milliseconds. */
+export function slowFor(category: string): number {
+  return slowness.category === category ? slowness.delayMs : 0;
+}
+
+/** The store's menu items in a category: `hot`, `cold`, or `all` of them. */
+export function menuIn(store: StoreId, category: string): MenuItem[] {
+  return (MENUS[store] ?? []).filter(
+    (item) => category === "all" || CATEGORY[item.id] === category,
+  );
+}
+
 /** How many items the cart holds: what the page shows. */
 export function lineCount(cart: Cart): number {
   return cart.lines.reduce((n, line) => n + line.quantity, 0);
