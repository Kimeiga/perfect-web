+import { json, type RequestHandler } from "@sveltejs/kit";
+import { setSlowCategory } from "$lib/server/store";
+
+/** Make one of the menu's categories slow to read: `?slow=hot&delay=1500`.
+ * A benchmark's hook, as every stack in it has one. */
+export const POST: RequestHandler = ({ url }) => {
+  setSlowCategory(url.searchParams.get("slow"), Number(url.searchParams.get("delay") ?? 0));
+  return json({});
+};
