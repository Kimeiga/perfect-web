@@ -0,0 +1,10 @@
+import { json, type RequestHandler } from "@sveltejs/kit";
+import { menuIn, slowFor } from "$lib/server/store";
+
+/** The store's menu items in a category: `?store=..&category=..`. Reading a
+ * category takes as long as it takes. */
+export const GET: RequestHandler = async ({ url }) => {
+  const category = url.searchParams.get("category") ?? "all";
+  await new Promise((resolve) => setTimeout(resolve, slowFor(category)));
+  return json(menuIn(url.searchParams.get("store") ?? "", category));
+};
