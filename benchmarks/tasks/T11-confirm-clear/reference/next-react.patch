+"use client";
+
+import { useRef } from "react";
+import { clearCartAction } from "./actions";
+
+// Clear asks first, in the browser's modal dialog: it takes focus, makes the
+// page behind it inert, closes on Escape, and gives focus back to Clear.
+export function ClearCart({ store }: { store: string }) {
+  const dialog = useRef<HTMLDialogElement>(null);
+  return (
+    <>
+      <button id="clear-cart" type="button" onClick={() => dialog.current?.showModal()}>
+        Clear
+      </button>
+      <dialog ref={dialog} aria-labelledby="clear-title">
+        <h2 id="clear-title">Clear your cart?</h2>
+        <button type="button" onClick={() => dialog.current?.close()}>
+          Keep items
+        </button>
+        <form action={clearCartAction} onSubmit={() => dialog.current?.close()}>
+          <input type="hidden" name="store" value={store} />
+          <button type="submit">Clear cart</button>
+        </form>
+      </dialog>
+    </>
+  );
+}
