+export type CartEntry = { itemId: MenuItemId; name: string; quantity: number };
+
+// The lines, kept between requests and forgotten when a cart changes: the
+// page asks for them on every render.
+const kept: Map<StoreId, CartEntry[]> =
+  ((globalThis as Record<string, unknown>).__pwBenchLines as Map<StoreId, CartEntry[]>) ??
+  new Map();
+(globalThis as Record<string, unknown>).__pwBenchLines = kept;
+
+/** The cart's lines, each with its item's name: what the cart section lists. */
+export function cartLines(store: StoreId, session: string | undefined): CartEntry[] {
+  const hit = kept.get(store);
+  if (hit) return hit;
+  const menu = MENUS[store] ?? [];
+  const lines = getCart(session).lines.map((line) => ({
+    itemId: line.itemId,
+    name: menu.find((m) => m.id === line.itemId)?.name ?? line.itemId,
+    quantity: line.quantity,
+  }));
+  kept.set(store, lines);
+  return lines;
+}
+
 /** How many items the cart holds: what the page shows. */
 export function lineCount(cart: Cart): number {
