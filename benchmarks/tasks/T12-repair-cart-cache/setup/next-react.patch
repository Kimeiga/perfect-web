   const lines = carts.get(session) ?? new Map<MenuItemId, number>();
   lines.set(item, (lines.get(item) ?? 0) + quantity);
   carts.set(session, lines);
+  recentCarts.clear();
   return getCart(session);
 }
 
 export function clearCart(session: string): Cart {
