+// The cart, cached for 30 seconds: reading it was the slowest part of the
+// page. Cleared whenever a cart changes.
+const recentCarts = new Map<string, { at: number; cart: Cart }>();
+
+export function getCartCached(store: StoreId, session: string | undefined): Cart {
+  const key = store;
+  const hit = recentCarts.get(key);
+  if (hit && Date.now() - hit.at < 30_000) return hit.cart;
+  const cart = getCart(session);
+  recentCarts.set(key, { at: Date.now(), cart });
+  return cart;
+}
+
