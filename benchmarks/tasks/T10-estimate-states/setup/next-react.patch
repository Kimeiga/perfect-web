+/** A delivery estimate: how many minutes until an order would arrive. */
+export type DeliveryEstimate = { minutes: number };
+
+/** How the estimator behaves for a session: how long it takes to answer,
+ * whether it fails, and what it estimates. A benchmark's hook sets it. */
+type Estimator = { delayMs: number; fail: boolean; minutes: number };
+
+const ESTIMATOR: Estimator = { delayMs: 400, fail: false, minutes: 25 };
+
+const estimators: Map<string, Estimator> =
+  ((globalThis as Record<string, unknown>).__pwBenchEstimators as Map<string, Estimator>) ??
+  new Map();
+(globalThis as Record<string, unknown>).__pwBenchEstimators = estimators;
+
+/** The session's delivery estimate, from the estimator. It can take a few
+ * seconds, and it sometimes fails. */
+export async function getEstimate(session: string | undefined): Promise<DeliveryEstimate> {
+  const { delayMs, fail, minutes } = (session && estimators.get(session)) || ESTIMATOR;
+  await new Promise((resolve) => setTimeout(resolve, delayMs));
+  if (fail) throw new Error("the estimator is unavailable");
+  return { minutes };
+}
+
+/** Set how the estimator behaves for a session; what is not given, as it was
+ * at the start. */
+export function setEstimator(session: string, change: Partial<Estimator>): void {
+  estimators.set(session, { ...ESTIMATOR, ...change });
+}
