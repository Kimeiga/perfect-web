+import { NextResponse, type NextRequest } from "next/server";
+import { ensureSession } from "@/lib/session";
+import { setEstimator } from "@/lib/store";
+
+/** Set how the estimator behaves for the request's session: `?delay=2000`
+ * milliseconds, `?fail=down`, `?minutes=35`; with nothing, as it was at the
+ * start. A benchmark's hook, as every stack in it has one. */
+export async function POST(request: NextRequest) {
+  const q = request.nextUrl.searchParams;
+  const session = await ensureSession();
+  const delay = q.get("delay");
+  const minutes = q.get("minutes");
+  setEstimator(session, {
+    ...(delay ? { delayMs: Number(delay) } : {}),
+    ...(q.get("fail") ? { fail: true } : {}),
+    ...(minutes ? { minutes: Number(minutes) } : {}),
+  });
+  return NextResponse.json({});
+}
