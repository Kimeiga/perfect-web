// @corpus: fixture
// @id: LIB-UserOrders
// @category: application service — a user's order
// @charter: §15, §15.6
// @milestone: E14
//
// **An order is its user's** (track `store-accounts`, ADR-0318): placed from
// the user's cart and read by the user's handle alone, as a notification is
// (ADR-0274). `Orders` keeps its session's operations, for the benchmark's
// copy of the store.
module UserOrders

import domain.{ OrderStatus, OrderError, TrackingError, OrderCharged, AwaitedPayment, ScheduledFor }
// NEXT 6c: the payment an order awaits.
import payments.{ Payment, PaymentStatus }
import capability.{ User, UserId }
// The resources these read and write, which their modules name.
import Carts
import Orders

// The user's order, as the store last said; none before one is placed.
fn current(reader: User<UserId>) -> Result<Option<OrderStatus>, TrackingError> !{ database.read<Orders> }
    host "store:data/user-orders#current"

// The user's cart, placed as their order: the order is the cart's lines,
// and the cart is empty after. An empty cart places nothing. And (track
// `order-total`) as charged, each store's part, the tip and the total, with
// the code it used, once per user: a code used since is refused
// `Promo(AlreadyUsed)`, by the data's own uniqueness.
fn place(reader: User<UserId>, charged: OrderCharged, promo: Option<String>) -> Result<OrderStatus, OrderError> !{ database.write<Orders>, database.write<Carts> }
    host "store:data/user-orders#place"

// **The user's order, as charged** (track `order-total`): none before one is
// placed, or where it was placed with no charges recorded.
fn charged(reader: User<UserId>) -> Option<OrderCharged> !{ database.read<Orders> }
    host "store:data/user-orders#charged"

// **An order awaiting its payment** (NEXT 6c): the reader's cart placed as
// their order, charged, its code used and the cart emptied, as `place` does,
// awaiting the payment begun for it; its reference, which the payment
// carries. Refused while an order of the reader's awaits one. And (track
// `scheduled-orders`) for the time `time` says, none for as soon as
// possible: paid, it is scheduled, not placed. Refused while an order of the
// reader's is scheduled.
fn await_payment(reader: User<UserId>, charged: OrderCharged, promo: Option<String>, time: Option<ScheduledFor>) -> Result<String, OrderError> !{ database.write<Orders>, database.write<Carts> }
    host "store:data/user-orders#await-payment"

// **The reader's scheduled order, sent to its stores** (track
// `scheduled-orders`): placed, where their order is the one `order` names
// and is scheduled still; as it is otherwise.
fn send(reader: User<UserId>, order: String) -> Result<OrderStatus, OrderError> !{ database.write<Orders> }
    host "store:data/user-orders#send"

// **The payment the reader's awaiting order awaits**, and the provider's
// page for it, which the order page frames.
fn paying(reader: User<UserId>, order: String, payment: Payment) -> Result<OrderStatus, OrderError> !{ database.write<Orders> }
    host "store:data/user-orders#paying"

// **The reader's order's payment, settled as the provider says it** (NEXT
// 6c): placed where it succeeded, or scheduled where it is for a time (track
// `scheduled-orders`); taken back where it was canceled (step
// eight), its lines back in the cart and its code's use released; awaiting
// still where it has not yet; a payment for an order the reader's is no
// longer changes nothing.
fn settle(reader: User<UserId>, order: String, status: PaymentStatus) -> Result<OrderStatus, OrderError> !{ database.write<Orders>, database.write<Carts> }
    host "store:data/user-orders#settle"

// **The payment the reader's order awaits** (step eight): its order's
// reference and the payment's id, where an order of theirs awaits one the
// provider has begun.
fn awaited(reader: User<UserId>) -> Option<AwaitedPayment> !{ database.read<Orders> }
    host "store:data/user-orders#awaited"
