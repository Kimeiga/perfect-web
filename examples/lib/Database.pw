// @category: application service — transactions
// @charter: §7.5, §15.1
// @milestone: E2C
//
// A transaction is an effect. E9C will make failing to end one an error.

module Database

import domain.{ StoreId, Store, StoreError, Cart, CartError, SessionId,
    MenuItemId, OrderId, OrderProgress, PositiveInt, Recommendation,
    RecommendationError, PaymentError, TrackingError, DatabaseTransaction, DatabaseConnection }
import browser.{ Element, MapHandle, MapError }

// A live connection. It is a resource for the same reason a transaction is —
// something outside the program is holding state open on this program's behalf
// — and that is also why it cannot be written into a resume manifest.
fn connect() -> DatabaseConnection
    !{ database.connect, resource.acquire<DatabaseConnection> }
{
    todo
}

fn disconnect(c: DatabaseConnection) -> ()
    !{ resource.release<DatabaseConnection> }
{
    todo
}

// `resource.acquire<T>` in the row is what makes the returned value affine.
// The checker reads the row; it holds no list of functions that open things,
// so a new resource is declared here rather than in the compiler.
fn begin() -> DatabaseTransaction
    !{ database.transaction, resource.acquire<DatabaseTransaction> }
{
    todo
}

// The two ways a transaction ends. Exactly one of them must happen on every
// path, which is what `resource.release<T>` says.
fn commit(tx: DatabaseTransaction) -> Result<(), CartError>
    !{ database.transaction, resource.release<DatabaseTransaction> }
{
    todo
}

fn rollback(tx: DatabaseTransaction) -> ()
    !{ database.transaction, resource.release<DatabaseTransaction> }
{
    todo
}
