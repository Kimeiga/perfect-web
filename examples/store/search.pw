// @corpus: fixture
// @id: E14-store-search
// @category: the store's search — the stores and their dishes, matched in
//            the store's data layer
// @charter: §15.1, §7.5
// @milestone: E14
//
// Track `store-search` (docs/PARALLEL.md, W9). A reader searches the stores
// and their menus by text, and the search page lists the stores that match
// and the dishes that match, each dish under its store, linked to it.
//
// The match runs in the store's data layer, as its operation (as kiokun's
// search runs in kiokun's): in memory, and on PostgreSQL, where `LIKE`
// matches each term with its `%`, `_` and `\` escaped and every value bound.
// Both layers hold one meaning, and the ADR states it:
// - case is ignored, by each character's Unicode simple lowercase;
// - a store matches where every term is part of its name, its description
//   or its cuisine; a dish, where every term is part of its name, its
//   description or its category;
// - a store is listed where it matches or any of its dishes does;
// - stores rank by where their terms were found, then by name, then id;
//   a store's dishes likewise.
//
// The catalog is public, so the search is public and kept `shared`, keyed by
// its text. The page is shown in `StoreLayout`, which shows the reader's
// cart, so the page is the reader's: a `user` page, as the layout is since
// track `store-accounts` (a page declares at least its layout's audience,
// PW5046).

module store.search

import List
import clock
// The data the search reads: the stores, and their menus.
import Stores
import Menus
// And the reader's chosen address, which a store reaches or not.
import Addresses
import domain.{ StoreId, MenuItemId, Money, USD }
import capability.{ User, UserId }
import context.{ current_user }
import Events.{ MenuChanged, InventoryChanged, AddressesChanged, StoreChanged }
import store.page.{ StoreLayout }
// TRACK SEAM (store-hours): whether each store found is open.
import store.hours.{ OpeningHoursOf, hours_of_stores, shown_of }
// TRACK SEAM (reviews): each store found's ratings, read at once.
import Ratings
import Ratings.{ RatingsOf }
import store.reviews.{ StoreRated, said_of }

// **A dish that matched**, as the search shows it: its store's page is
// where it is ordered.
type DishHit = DishHit {
    id: MenuItemId,
    name: String,
    description: String,
    category: String,
    price: Money<USD>,
}

// **A store that matched**, or whose dishes did, and the dishes of it that
// matched, the first five, with how many more.
type StoreHit = StoreHit {
    id: StoreId,
    name: String,
    description: String,
    cuisine: String,
    dishes: List<DishHit>,
    more_dishes: Int,
}

// **What a search found**: the stores, the first twenty, with how many more;
// and for a reader (`find_for`), whether they chose an address, its label,
// and how many stores matched that do not reach it, left out.
type SearchFound = SearchFound {
    stores: List<StoreHit>,
    more_stores: Int,
    chosen: Bool,
    to: String,
    beyond: Int,
}

// **What the data layer refuses to search**: text with no term in it, and
// text longer than 100 characters.
type SearchError =
    | Blank
    | TooLong

// **The store's search, in its data layer** (`store:data/search#find`).
fn find(text: String) -> Result<SearchFound, SearchError> !{ database.read<Stores>, database.read<Menus> }
    host "store:data/search#find"

// **A reader's search** (`store:data/search#find-for`): the stores that reach
// the reader's chosen address, by the store's one rule (ADR-0319); every
// store where none is chosen.
fn find_for(text: String, reader: User<UserId>) -> Result<SearchFound, SearchError> !{ database.read<Stores>, database.read<Menus>, database.read<Addresses> }
    host "store:data/search#find-for"

// **A store as the page shows it**: its dishes, and how many more there
// are, in words.
type ShownStore = ShownStore {
    id: StoreId,
    name: String,
    description: String,
    cuisine: String,
    open: String,
    // TRACK SEAM (reviews): what its ratings come to.
    rating: String,
    dishes: List<DishHit>,
    more: String,
}

// **What the page says of a search**: what was asked, the page's title, a
// sentence for what was found or why nothing was, the stores, and how many
// more, in words.
type SearchShown = SearchShown {
    asked: String,
    title: String,
    said: String,
    near: String,
    stores: List<ShownStore>,
    more: String,
}

fn shown(asked: String, answer: Result<SearchFound, SearchError>, hours: List<OpeningHoursOf>, ratings: List<RatingsOf>) -> SearchShown !{ clock.compare, clock.zone } {
    let none: List<ShownStore> = []
    let title = if asked == "" { "Search" } else { "Search for “{asked}”" }
    let blank = "Type a store, a dish or a cuisine to search for."
    match answer {
        Ok(found) => SearchShown {
            asked: asked,
            title: title,
            said: summary(asked, found),
            near: near(found),
            stores: List.map(found.stores, s => shown_store(s, hours, ratings)),
            more: more(found.more_stores, "store", "stores"),
        },
        Err(SearchError.Blank) => SearchShown { asked: asked, title: title, said: blank, near: "", stores: none, more: "" },
        Err(SearchError.TooLong) => SearchShown { asked: asked, title: title, said: "That search is too long: 100 characters at most.", near: "", stores: none, more: "" },
    }
}

fn shown_store(s: StoreHit, hours: List<OpeningHoursOf>, ratings: List<RatingsOf>) -> ShownStore !{ clock.compare, clock.zone } {
    ShownStore {
        id: s.id,
        name: s.name,
        description: s.description,
        cuisine: s.cuisine,
        open: shown_of(s.id, hours).said,
        rating: said_of(s.id, ratings),
        dishes: s.dishes,
        more: more(s.more_dishes, "dish", "dishes"),
    }
}

// **Where the search was for**: the stores that deliver to the chosen
// address, and how many that match do not; or, with none chosen, how to
// see only those.
fn near(found: SearchFound) -> String {
    if !found.chosen {
        "Choose a delivery address to see only the stores that deliver to it."
    } else if found.beyond == 0 {
        "Showing the stores that deliver to {found.to}."
    } else if found.beyond == 1 {
        "Showing the stores that deliver to {found.to}; 1 more matches but doesn't."
    } else {
        "Showing the stores that deliver to {found.to}; {found.beyond} more match but don't."
    }
}

fn summary(asked: String, found: SearchFound) -> String {
    let n = List.length(found.stores) + found.more_stores
    if n == 0 {
        "No stores or dishes match “{asked}”."
    } else if n == 1 {
        "1 store matches “{asked}”."
    } else {
        "{n} stores match “{asked}”."
    }
}

// **A reader's search** (track `store-search`, ADR-0308 amended): the
// stores that reach the reader's chosen address, so the reader's own, kept
// by its text and the reader, and dropped when any store's menu or stock
// changes or the reader's addresses do. What it matches is the public
// catalogue.
user query Search(q: Option<String>, reader: User<UserId>) -> SearchShown
    freshness      30.seconds
    consistency    read_your_writes
    cache          private
    key            q, reader
    invalidates_on MenuChanged(_), InventoryChanged(_, _), AddressesChanged(reader), StoreChanged(_), StoreRated(_)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    // The host call is in the query's own body: a call reached only
    // through a helper is not among the component's imports.
    // An address with no `q` is searched as a blank text is. Its page shows
    // no sentence for it: the sentence is in `{#match q}`'s `Some` arm, and
    // the `None` arm says what can be searched for (ADR-0320).
    let text = match q {
        Some(t) => t,
        None => "",
    }
    let answer = find_for(text, reader)
    // TRACK SEAM (store-hours): the hours of each store found.
    let no_ids: List<StoreId> = []
    let found = match answer {
        Ok(f) => List.map(f.stores, h => h.id),
        Err(_) => no_ids,
    }
    let hours = hours_of_stores(found)
    // TRACK SEAM (reviews): the ratings of each store found, one read.
    let ratings = Ratings.for_stores(found)
    shown(text, answer, hours, ratings)
}

// **"5 more dishes"**, or nothing where there are none.
fn more(n: Int, one: String, many: String) -> String !{} {
    if n == 0 {
        ""
    } else if n == 1 {
        "1 more {one}"
    } else {
        "{n} more {many}"
    }
}

// **The search page** (track `store-search`, ADR-0308; its address
// ADR-0309's): at `/search{?q}`, its search box a plain GET form that makes
// the address, with scripts on or off. With no `q` it asks what to search
// for; with one, it says what was found. A navigation gives no query, so a
// link or the form reaches it.
user page SearchPage(q: Option<String>) {
    route     "/search{?q}"
    layout    StoreLayout
    placement origin
    cache     private

    let search = query Search(q, current_user())

    view {
        <title>{search.title}</title>
        <meta name="robots" content="noindex, follow" />
        <main>
            <h1>{search.title}</h1>
            <form id="search-form" method="get" action="/search" role="search">
                <label>Stores and dishes <input id="search-q" type="search" name="q" value={search.asked} /></label>
                <button>Search</button>
            </form>
            <!-- What was found, or with no `q`, what can be searched for.
                 The sentence is told where it is when the search's result
                 changes, its arm being the document's (ADR-0320). -->
            {#match q}
            {:Some(_)}<p id="search-said" role="status">{search.said}</p><p id="search-near">{search.near}</p>
            {:None}<p id="search-intro">Search the stores by name or cuisine, and their dishes by name or what they are.</p>
            {/match}
            <ul id="search-stores">
                {#each search.stores as store (store.id)}
                    <li>
                        <h2><a href="/stores/{store.id}">{store.name}</a></h2>
                        <p class="cuisine">{store.cuisine}</p>
                        <p class="open">{store.open}</p>
                        <p class="rating">{store.rating}</p>
                        <p>{store.description}</p>
                        {#if store.dishes}
                            <ul aria-label="Dishes at {store.name}">
                                {#each store.dishes as dish (dish.id)}
                                    <li>
                                        <a href="/stores/{store.id}">{dish.name}</a>
                                        <span class="category">{dish.category}</span>
                                        <p>{dish.description}</p>
                                        <p>{dish.price.display}</p>
                                    </li>
                                {/each}
                            </ul>
                        {/if}
                        {#if store.more}<p>{store.more}</p>{/if}
                    </li>
                {/each}
            </ul>
            {#if search.more}<p id="search-more">{search.more}</p>{/if}
        </main>
    }
}
