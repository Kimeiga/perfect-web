// @corpus: accepted
// @id: A-010
// @category: origin-only secret operation
// @charter: §7.3, §7.8, §15.2
// @milestone: 5
//
// A capability-gated operation that can only be placed at the origin. The
// secret handle is affine and never serialized, so it cannot reach a browser
// or edge artifact.

module payments.capture

import domain.{ OrderId, Money, USD, PaymentError }
import capability.{ Secret }

command capture_payment(order: OrderId, amount: Money<USD>)
    -> Result<PaymentReceipt, PaymentError>
{
    requires      SignedIn, OwnsOrder(order)
    placement     origin
    idempotent_by InteractionId
    transaction   serializable
    invalidates   Order(order)
    retry         transport_only(max = 2, jitter = true)
{
    // `secret<Payments>` is granted only in the origin world.
    use key: Secret<Payments> = secrets.payments()
    Payments.capture(key, order, amount)
}
