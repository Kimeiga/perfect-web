// @corpus: accepted
// @id: A-009
// @category: edge materialized menu
// @charter: §9.4, §14 M6
// @milestone: 6
//
// A public fragment materialized at the edge and invalidated by typed events
// rather than a route timer. The dependency list is explicit, so invalidating
// one store cannot regenerate another.

module store.menu_materialization

import domain.{ StoreId }
// E6: what this fragment depends on and what invalidates it are now
// resolved against declarations. Before, both lists were names nobody
// checked, and a graph of edges to nothing looks exactly like a graph of
// dependencies that never change.
import Resources.{ Store, Menu }
import Events.{ MenuChanged, InventoryChanged }

materialize MenuFragment(id: StoreId) {
    placement      edge
    partition      public
    depends_on     Store(id), Menu(id)
    // Any item of this store: `_` is any value (ADR-0091). This read
    // `_item: MenuItemId`, which named nothing the materializer compares.
    invalidates_on MenuChanged(id),
        InventoryChanged(id, _)
    regenerate     on_invalidation
    stampede       single_flight
    fallback       last_known_good
    locale         included_in_key
}
