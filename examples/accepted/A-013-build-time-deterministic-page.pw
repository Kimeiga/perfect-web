// @corpus: accepted
// @id: A-013
// @category: build-time deterministic page
// @charter: §9.3, §7.9
// @milestone: 6
//
// A page whose inputs are all known at build time and whose effect row
// excludes the clock and randomness, so it can be statically generated.
// Determinism is a type property here, not a convention.

module marketing.terms

// 2026-08-10: `include_markdown` was called and declared nowhere, so the page
// claimed build-time determinism against silence — nothing constrained where it
// could run, and its contract permitted the browser. It is now a tracked build
// input: reading it performs `build.input.read<WorkspaceFile>`, which is
// `placement build`, so the determinism claim is carried by an effect rather
// than by an absence.
import build.{ include_markdown, WorkspaceFile }

// A build-known input plus a row that excludes the clock and randomness => the
// placement solver has a reason to choose Build, rather than no reason to
// choose anything.
page Terms() !{ build.input.read<WorkspaceFile> } {
    placement build
    privacy   Public
    cache     shared
    revision  content_hash

    view {
        <main>
            <h1>Terms of Service</h1>
            <article>
                {include_markdown("content/terms.md")}
            </article>
        </main>
    }
}
