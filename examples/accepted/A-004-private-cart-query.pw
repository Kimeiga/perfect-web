// @corpus: accepted
// @id: A-004
// @category: private cart query
// @charter: §7.8, §9.2, §15.2
// @milestone: 4
//
// Session-labeled data in a private cache partition with read-your-writes
// consistency and zero staleness. The privacy label makes shared caching a
// compile error, so the partition need not be defended by convention.

module cart.queries

import domain.{ Cart, CartError }
import capability.{ Session, SessionId }

import Carts
import Events.{ CartChanged }

session query Cart(session: Session<SessionId>) -> Result<Cart, CartError>
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    // Zero staleness holds only if the cart hears of each write: A-005's
    // `add_to_cart` emits this. Until 2026-09-26 nothing did (ADR-0101).
    invalidates_on CartChanged(session)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    Carts.current(session)
}
