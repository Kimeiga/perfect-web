// @corpus: accepted
// @id: A-024
// @category: audited imperative widget escape
// @charter: §7.5A, §7.5
// @milestone: 7
//
// Third-party imperative widgets cannot be statically proven safe, so the
// charter requires an audited escape hatch rather than pretending otherwise.
// It is quarantined, justified, and appears in the semantic diff.

module store.third_party_map

component VendorMap(center: LatLng) {
    placement browser

    // Quarantined behind a measurable imperative-resource boundary. The
    // capability is named, justified, and surfaced in the semantic PR diff;
    // its forced-layout cost is attributed to this component, not amortised
    // silently across the frame.
    unsafe capability synchronous_geometry
        because "VendorMap reads offsetWidth during init; upstream has no
                 measurement-free API. Tracked at vendor-issue-4471."
        attributes_forced_layout_to VendorMap

    resource widget {
        scope   component
        acquire { unsafe.imperative { VendorSdk.mount(self, center) } }
        release(h) { unsafe.imperative { VendorSdk.destroy(h) } }
    }

    view { <section aria-label="Map" /> }
}
