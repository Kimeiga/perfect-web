// @corpus: accepted
// @id: A-016
// @category: multiple measures share one layout snapshot
// @charter: §7.5A
// @milestone: 7
//
// Charter §7.5A requires deduplicating measurements of the same element and
// property within one frame. Three reads of the same box cost one layout.

module store.menu_align

import List
import style
import browser.{ ElementRef, LayoutSnapshot }

component MenuAligner(items: List<ElementRef>) {
    placement browser

    frame {
        // All three reads are satisfied from a single flush. The compiler
        // deduplicates by (element, property) within the frame.
        let widths: List<LayoutSnapshot<Float>> = measure {
            // `offsetWidth`, which the platform declares; `width()` was a
            // member no declaration has (ADR-0048).
            items |> List.map(fn(it) it.offsetWidth())
        }
        let total = derived widths |> List.map(fn(w) w.value) |> List.sum()
        let max = derived widths |> List.map(fn(w) w.value) |> List.maximum()

        // `maximum` is `None` for an empty list (ADR-0055). It answered 0.0.
        mutate {
            match max {
                Some(m) => self.style.set_width(m),
                None => self.style.set_width(0.0),
            }
            self.style.set_custom("--total", total)
        }
    }
}
