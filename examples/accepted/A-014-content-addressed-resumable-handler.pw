// @corpus: accepted
// @id: A-014
// @category: content-addressed resumable handler
// @charter: §8.5
// @milestone: 7
//
// A handler that captures only serializable immutable values and a resource
// key. Its identity is the hash of its code and captures, so a stale manifest
// is detectable rather than silently wrong.

module store.add_button

import domain.{ MenuItemId, PositiveInt }
// The command the deferred handler invokes. It was called and never imported,
// so from E7 until 2026-08-10 the authority it carries was attributed to
// nobody — and the fixture read as evidence that a view does not inherit its
// handler's authority while there was nothing to inherit and no contract to
// say so either way.
//
// Architect ruling, 2026-08-10:
//
//   The handler's reference to `add_to_cart` should become a component import
//   identified by DefId, not `view requires database.write<Carts>`.
import cart.commands.{ add_to_cart }

view AddToCartButton(item: MenuItemId, available: Bool) !{} {
    // The handler captures `item` (an immutable opaque id) and nothing else.
    // No DOM node, no connection, no closure over server state.
    <button
        disabled={!available}
        on:press={resumable(captures = { item }) => add_to_cart(item, PositiveInt(1))}
    >
        Add
    </button>
}

handler_policy {
    identity content_address(code, captures)
    captures serializable_only
    on_version_mismatch safe_refetch
    load on_first_interaction
}
