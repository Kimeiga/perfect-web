// @corpus: accepted
// @id: A-001
// @category: pure calculation
// @charter: §7.1, §7.2, §16.1
// @milestone: 2
//
// A function with an empty effect row. It reads no clock, performs no I/O, and
// returns a nominal Money<USD> rather than a bare integer. The compiler must
// infer !{} here; anything else is a bug in the effect checker.

module store.pricing

import domain.{ MenuItemId, Money, USD, PositiveInt, times, sum }

import List

type CartLine = CartLine {
    item_id: MenuItemId,
    quantity: PositiveInt,
    unit_price: Money<USD>,
}

type Cart = Cart {
    lines: List<CartLine>,
}

// !{} — no effects. Enforced, not merely intended.
fn line_total(line: CartLine) -> Money<USD> !{} {
    // `PositiveInt` and `Money` are opaque here: `.value` is `domain`'s
    // alone, and `count`, `times` and `sum` are what `domain` gives other
    // modules (ADR-0048, ADR-0327). An amount is multiplied and added
    // exactly; it is never divided here.
    times(line.unit_price, line.quantity.count)
}

fn subtotal(cart: Cart) -> Money<USD> !{} {
    sum(cart.lines |> List.map(line_total))
}
