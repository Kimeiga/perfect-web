// @corpus: accepted
// @id: A-011
// @category: offline draft with explicit conflict policy
// @charter: §9.1
// @milestone: 4
//
// Intentionally local, synchronized state with a named conflict policy. The
// policy is part of the declaration, so there is no silent last-write-wins.

module order.draft

import domain.{ ConsumerId, OrderDraft, SyncError }

replicated OrderDraft(consumer: ConsumerId)
    -> Result<OrderDraft, SyncError>
{
    privacy       User(consumer)
    storage       device
    offline       writable
    sync          on_reconnect
    conflict      merge_by_field(
                      notes         = last_write_wins,
                      line_quantity = maximum,
                      removed_lines = union,
                  )
    on_conflict_unresolved surface_to_user
}
