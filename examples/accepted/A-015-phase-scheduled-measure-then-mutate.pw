// @corpus: accepted
// @id: A-015
// @category: phase-scheduled measure then mutate
// @charter: §7.5A
// @milestone: 7
//
// The canonical safe shape. All measurements are collected while layout is
// clean, a mutation plan is computed touching nothing, then every write is
// committed together. Measured at 264x-848x faster than the interleaved form
// on identical work.

module store.tooltip

// `layout.measure` and `style.mutate<LayoutAffect>` are distinct phases. The
// scheduler runs every measure before any mutate, so layout flushes at most once.
component Tooltip(anchor: ElementRef, content: String) {
    placement browser

    frame {
        let box: LayoutSnapshot<Rect> = measure { anchor.bounds() }
        mutate {
            self.style.transform = translate(box.x, box.bottom + 8.px)
        }
    }

    view {
        <div role="tooltip">{content}</div>
    }
}
