// @corpus: accepted
// @id: A-015
// @category: phase-scheduled measure then mutate
// @charter: §7.5A
// @milestone: 7
//
// The canonical safe shape. All measurements are collected while layout is
// clean, a mutation plan is computed touching nothing, then every write is
// committed together. Measured at 264x-848x faster than the interleaved form
// on identical work.

module store.tooltip

import browser.{ ElementRef, LayoutSnapshot, Rect }

// `layout.measure` and `style.mutate<LayoutAffect>` are distinct phases. The
// scheduler runs every measure before any mutate, so layout flushes at most once.
component Tooltip(anchor: ElementRef, content: String) {
    placement browser

    // Until 2026-09-25 this read `anchor.bounds()`, `box.x` and `box.bottom`,
    // and assigned `self.style.transform`: no declaration has any of them, and
    // nothing checked a member (ADR-0048). The geometry is the platform's
    // `getBoundingClientRect`, read through the snapshot's `value`, and the
    // write is the declared `set_transform`.
    frame {
        let box: LayoutSnapshot<Rect> = measure { anchor.getBoundingClientRect() }
        mutate {
            self.style.set_transform(
                translate(box.value.left, box.value.top + box.value.height + 8.px),
            )
        }
    }

    view {
        <div role="tooltip">{content}</div>
    }
}
