// @corpus: fixture
// @id: VENDORS
// @category: external implementations, declared
// @charter: §11.4, §14 M5 task 6
// @milestone: E2C
//
// Third-party code the corpus reaches. Architect ruling, 2026-08-06:
//
//   External implementation is allowed. Missing declaration is not.
//
// So `VendorSdk` and `Legacy` are declared here with the effects they actually
// have. That is the whole value: `VendorSdk.mount` declaring
// `!{ dom.mutate, layout.measure }` is what makes A-024's audited escape a
// *measurable* cost attributed to a named component, rather than an
// unaccounted-for one.
//
// An interface module is checked into the package graph, versioned, and visible
// to the evidence ledger. It is not an escape from declaration.

module vendors

import browser.{ Element, MapHandle, MapError }

// The map widget. It reads geometry during init, which is exactly why A-024
// must declare `unsafe capability synchronous_geometry` and attribute the cost.
fn vendorsdk_mount(container: Element, center: String) -> Result<MapHandle, MapError>
    !{ dom.mutate, layout.measure }
{
    Err(MapError.Unsupported)
}

fn vendorsdk_destroy(handle: MapHandle) -> () !{ dom.mutate } { () }

// A legacy widget with imperative lifecycle hooks.
fn legacy_init() -> () !{ dom.mutate } { () }

fn legacy_teardown() -> () !{ dom.mutate } { () }
