//
// Escape hatches are permitted but never anonymous: they must be justified,
// warned about, and surfaced in the semantic diff.

module legacy.widget

component LegacyWidget() {
    // ERROR: unsafe escape hatch with no justification.
    unsafe.lifecycle {
        on_mount  { Legacy.init() }
        on_unmount { Legacy.teardown() }
    }

    view { <div id="legacy" /> }
}
