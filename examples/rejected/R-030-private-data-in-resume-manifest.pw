// @corpus: rejected
// @id: R-030
// @category: private data in resume manifest
// @rule: PW0328
// @invariant: private_in_resume_manifest
// @charter: §8.5, §7.8
// @milestone: 7
// @expect-error: resume manifest for `CartSummary` would contain a `Session<SessionId>` value
// @expect-error: the resume manifest is served with the public shell and may contain only `Public` values
//
// The resume manifest ships with the document. Anything in it inherits the
// document's cacheability, so private values must not be captured.

module cart.summary_view

import domain.{ Cart }
import cart.queries

// 2026-09-25: the handler called `checkout(cart.id)`, and `Cart` has no `id`
// (ADR-0048). The callee takes the captured cart, and is declared here so the
// witness depends on no library signature; its subject, the capture, is
// unchanged.
fn checkout_cart(cart: Cart) -> () !{} { todo }

view CartSummary(cart: Cart) !{} {
    <section aria-label="Cart">
        <button
            // ERROR: capturing session-labeled data into the resume manifest.
            on:press={resumable(captures = { cart }) => checkout_cart(cart)}
        >
            Checkout ({cart.line_count})
        </button>
    </section>
}
