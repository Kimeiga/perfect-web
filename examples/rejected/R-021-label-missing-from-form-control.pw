// @corpus: rejected
// @id: R-021
// @category: label missing from form control
// @rule: PW0319
// @invariant: control_without_label
// @charter: §8.2
// @milestone: 3
// @expect-error: `<input>` has no associated label
// @expect-error: associate a `<label for=...>`, or supply `aria-label`/`aria-labelledby`
//
// An unlabeled control is unusable with a screen reader and often with voice
// control.

module checkout.address_form

// 2026-09-25 (ADR-0047): the form submitted to `save_address`, which nothing
// declared. A name used as a value must resolve now, and a fixture about a
// missing label must not also be about a missing declaration.
fn save_address() -> () !{} { todo }

view AddressForm() !{} {
    <form on:submit={save_address}>
        // ERROR: no label associated with this control.
        <input type="text" name="street" />
        <button type="submit">Save</button>
    </form>
}
