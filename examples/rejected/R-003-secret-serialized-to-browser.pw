// @corpus: rejected
// @id: R-003
// @category: secret serialized to browser
// @rule: PW0302
// @charter: §7.8, §8.5
// @milestone: 5
// @expect-error: a value labeled `Secret<Payments>` may not be serialized to the browser
// @expect-error: `Secret<Payments>` is not serializable across the origin/browser boundary
//
// Secrets are labeled and the boundary is typed, so shipping one to the client
// is a label violation rather than a code review miss.

module checkout.page

import secrets

page Checkout() {
    placement origin

    let key: Secret<Payments> = secrets.payments()

    view {
        // ERROR: secret crosses the origin -> browser boundary.
        <pay-button api_key={key} />
    }
}
