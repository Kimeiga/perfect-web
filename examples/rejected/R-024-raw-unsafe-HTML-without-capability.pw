// @corpus: rejected
// @id: R-024
// @category: raw unsafe HTML without capability
// @rule: PW0322
// @invariant: unsafe_audit_incomplete
// @charter: §8.2, §17.5
// @milestone: 3
// @expect-error: `raw_html` requires the `unsafe.raw_html` capability and a justification
// @expect-error: untrusted input reaching `raw_html` is an XSS sink
//
// Escaping is the default. Bypassing it requires an audited, justified
// capability, never a bare function call.

module store.description_view

import html.{ raw_html }

view StoreDescription(description: String) !{} {
    <section>
        // ERROR: raw HTML injection without capability or justification.
        {raw_html(description)}
    </section>
}
