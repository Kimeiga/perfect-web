// @corpus: rejected
// @id: R-029
// @category: optimistic state with no rollback path
// @rule: PW0330
// @invariant: optimistic_not_pure
// @charter: §7.5, §15.4
// @milestone: 4
// @expect-error: `add_to_cart`'s optimistic transition performs database.write<Carts>
// @expect-error: an optimistic transition must be a pure function of the resource's value
//
// **This fixture's subject changed on 2026-08-11, and the reason is the point.**
//
// It used to demonstrate `optimistic` with no `rollback`. Architect ruling
// (ADR-0025) retired that invariant:
//
//   "an optimistic transition is a function from the current value to the next,
//    and rollback is its inverse" — the first half is excellent. The second is
//    generally false.
//
// A cart holding `Apple x 3`, optimistically `+2`, is `Apple x 5`; a written
// `remove(apple)` does not restore `Apple x 3`, and even `subtract(2)` fails
// once there are concurrent updates, normalization, or derived fields. The
// platform knows the exact value it held, so it restores that.
//
// What makes automatic restoration MEANINGFUL is the invariant this fixture now
// carries: the transition must be pure. An externally visible effect cannot be
// undone by restoring a resource value, so a transition that performs one has
// no defined behaviour on rejection.
//
// The category is unchanged because the failure mode is: an optimistic update
// that cannot be cleanly abandoned leaves the UI permanently inconsistent with
// the server. Only the mechanism moved.

module cart.commands

import Carts
import domain
import domain.{ MenuItemId, PositiveInt, CartError }
import Resources.{ Cart }
import context.{ current_session }

// This helper returns the resource value but still performs the forbidden write.
fn impure_add(cart: domain.Cart, item: MenuItemId, quantity: PositiveInt) -> domain.Cart {
    let _added = Carts.add(current_session(), item, quantity)
    cart
}

command add_to_cart(item: MenuItemId, quantity: PositiveInt)
    -> Result<domain.Cart, CartError>
    requires      SignedIn
    idempotent_by InteractionId
    // ERROR: the transition writes the database. It runs on the client, before
    // the round trip, and is discarded by restoring the previous value — which
    // cannot undo a write that already happened.
    optimistic    Cart(current_session()) as cart => impure_add(cart, item, quantity)
    invalidates   Cart(current_session())
{
    Carts.add(current_session(), item, quantity)
}
