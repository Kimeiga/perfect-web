// @corpus: rejected
// @id: R-029
// @category: optimistic state with no rollback path
// @rule: PW0327
// @invariant: optimistic_no_rollback
// @charter: §7.5, §15.4
// @milestone: 4
// @expect-error: `add_to_cart` declares `optimistic` without `rollback`
// @expect-error: an optimistic transition must declare how it is reversed on failure
//
// An optimistic update with no rollback leaves the UI permanently inconsistent
// with the server after a rejected mutation.

module cart.commands

import Carts
import Resources.{ Cart }
// See A-005, which this fixture is the rejected twin of: the body called
// `current_consumer()` and passed it where `Carts.add` takes a `SessionId`.
import context.{ current_session }

command add_to_cart(item: MenuItemId, quantity: PositiveInt)
    -> Result<Cart, CartError>
    requires      SignedIn
    idempotent_by InteractionId
    optimistic    cart => cart.add(item, quantity)
    // ERROR: no `rollback` declared.
    invalidates   Cart(current_session())
{
    Carts.add(current_session(), item, quantity)
}
