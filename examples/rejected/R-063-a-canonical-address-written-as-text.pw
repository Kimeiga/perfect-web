// @corpus: rejected
// @id: R-063
// @category: a canonical address written as text
// @rule: PW5051
// @invariant: canonical_address
// @charter: §8.2
// @milestone: 14
// @expect-error: `<link rel="canonical">` in `StorePage` states its address as text: a canonical address is a page's, which the compiler checks
// @expect-error: a page's canonical address is a page's, `href={Page(args)}`, served at a route without a query part, each argument a value the page reads or text
//
// A canonical address is the one a search engine takes for a page and a
// link's preview names. Written as text it could name no page, or one served
// elsewhere, and nothing would say so. Written as a page and its arguments,
// it is checked as a navigation's address is (ADR-0311).

module store.canonical_text

import domain.{ StoreId }

page StorePage(id: StoreId) !{} {
    route "/stores/{id}/about"
    view {
        <title>Store</title>
        <link rel="canonical" href="/stores/{id}/about" />
        <main><h1>Store</h1></main>
    }
}
