// @corpus: rejected
// @id: R-005
// @category: cross-tenant cache key missing tenant
// @rule: PW0303
// @charter: §7.8, §14 M5
// @milestone: 5
// @expect-error: shared cache key for `Menu` omits the required partition `Organization<OrganizationId>`
// @expect-error: every privacy partition the value depends on must appear in the cache key
//
// A cache key that omits a tenant discriminator serves one tenant's data to
// another. The compiler knows the value's labels, so it can require them in
// the key.

module menu.queries

query Menu(store: StoreId) -> Result<List<MenuItem>, MenuError> {
    cache   shared
    // ERROR: the result depends on Organization<OrganizationId>,
    // but the key is only `store`.
    key     store
{
    Menus.for_store_in_org(store, current_organization())
}
