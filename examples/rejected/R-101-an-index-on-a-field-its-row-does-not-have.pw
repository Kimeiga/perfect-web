// @corpus: rejected
// @id: R-101
// @category: an index on a field its row does not have
// @rule: PW0361
// @invariant: table_malformed
// @charter: §9.2
// @milestone: 14
// @expect-error: `index` names `color`, which is no field of `Label`
//
// An index is another way to find a table's rows, by fields its row has: an
// index on a field no row holds finds nothing, and its read, `by_color`,
// would be given a value no row could match. `A-100`'s index is on a field
// of its row, accepted.

module Labels

opaque type LabelId = String

type Label = Label { id: LabelId, name: String }

table Labels
    row   Label
    key   id
    index by_color on color
