// @corpus: rejected
// @id: R-006
// @category: public log of secret value
// @rule: PW0304
// @charter: §7.8, §7.2
// @milestone: 5
// @expect-error: cannot log a `Secret<Payments>` value at privacy level `Public`
// @expect-error: `log<Public>` accepts only `Public` values
//
// Logging is an effect parameterized by privacy level, so leaking a token into
// a public log is a type error rather than an incident.

module payments.debug

import log
import secrets

fn trace_capture(order: OrderId) -> () !{ log<Public>, secret<Payments> } {
    let token = secrets.payments()
    // ERROR: Secret<Payments> flows into a Public log.
    log.public("capturing with token {token}")
}
