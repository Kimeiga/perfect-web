// @corpus: rejected
// @id: R-020
// @category: button behavior implemented on inaccessible div
// @rule: PW0318
// @invariant: handler_on_inert
// @charter: §8.2
// @milestone: 3
// @expect-error: `<div>` with an `on:press` handler is not keyboard accessible
// @expect-error: use `<button>`, or supply `role`, `tabindex`, and keyboard activation
//
// A click target that only responds to a mouse excludes keyboard and screen
// reader users. The compiler can see the shape and reject it.

module cart.add_view

// 2026-08-10: PW0021 learned to examine bare calls. This fixture called
// `add_to_cart` and `PositiveInt` and imported neither, so a fixture whose
// subject is an inaccessible element was carrying two silent resolution
// defects as well.
import domain.{ MenuItemId, PositiveInt }
import cart.commands.{ add_to_cart }

view AddButton(item: MenuItemId) !{} {
    // ERROR: interactive behavior on a non-interactive element.
    <div class="btn" on:press={() => add_to_cart(item, PositiveInt(1))}>
        Add
    </div>
}
