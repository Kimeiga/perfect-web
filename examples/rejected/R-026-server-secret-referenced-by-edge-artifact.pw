// @corpus: rejected
// @id: R-026
// @category: server secret referenced by edge artifact
// @rule: PW5005
// @invariant: declared_placement_cannot_grant
// @charter: §7.3, §7.8
// @milestone: 5
// @expect-error: `secret<Payments>` is not granted to the edge world
// @expect-error: move this operation to `origin`, or request an edge-scoped credential
//
// Worlds differ in what they may hold. An edge artifact referencing an origin-
// only secret must fail before deployment.

module edge.receipt

import Receipts
import secrets
import capability.{ Payments }
import domain.{ OrderId }
import html.{ Html }

// Its placement is written before its body, where a function's is read: in
// its body, until ADR-0216, it was a clause nothing read.
fn render_receipt(order: OrderId) -> Html !{ secret<Payments> }
    placement edge
{
    // ERROR: the edge world has no `secret<Payments>` capability.
    let key = secrets.payments()
    Receipts.render(key, order)
}
