// @corpus: rejected
// @id: R-060
// @category: a secret a query answers, kept in a shared fragment
// @rule: PW5101
// @invariant: private_in_shared_materialization
// @charter: §7.8, §9.4, §14 M6 gate 4
// @milestone: 6
// @expect-error: `KeyFragment` is materialized into a shared entry and depends on `PaymentsKey`, which reads Secret<Payments>
// @expect-error: a shared materialization may only depend on data every reader of its cache entry may see
//
// Found on 2026-10-03 and refused since ADR-0282. A query that USES a secret,
// as a key to fetch something public, makes a public value (ADR-0085), and a
// shared fragment may keep that. This query ANSWERS the secret: its value is
// the key itself. Until 2026-10-08 every secret was left out of what a
// fragment's dependency holds, so this checked clean, where a page rendering
// the same value from a shared cache was refused.

module checkout.keys

import secrets
import capability.{ Secret, Payments }
import domain.{ StoreId }
import Events.{ MenuChanged }

public query PaymentsKey(id: StoreId) -> Secret<Payments> {
    secrets.payments()
}

materialize KeyFragment(id: StoreId) {
    placement      origin
    // ERROR: every reader is served this entry, and it is the key.
    partition      public
    depends_on     PaymentsKey(id)
    invalidates_on MenuChanged(id)
    regenerate     on_invalidation
    stampede       single_flight
    fallback       last_known_good
}
