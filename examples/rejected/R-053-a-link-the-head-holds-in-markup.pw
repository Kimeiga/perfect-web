// @corpus: rejected
// @id: R-053
// @category: a link the head holds, written in markup
// @rule: PW5035
// @invariant: link_not_in_body
// @charter: §8.2
// @milestone: 14
// @expect-error: `<link rel="canonical">` in `StorePage` is inside an element or a block, not at the top of its view, where HTML does not allow it and nothing reads it
// @expect-error: a `<link>` in markup is one HTML allows in the body, each relation body-ok or an item's property, or a page's canonical address, once at the top of its view
//
// A canonical address is the head's. A page states one at the top of its
// view, and its host writes it into the head (ADR-XXXX). Inside an element
// it is markup, written into the body, where HTML does not allow a
// `canonical` link and no search engine reads one: the page would say which
// address is its own to nothing.

module store.canonical

import domain.{ StoreId }

page StorePage(id: StoreId) !{} {
    route "/stores/{id}/about"
    view {
        <title>Store</title>
        <main>
            <link rel="canonical" href={StorePage(id)} />
            <h1>Store</h1>
        </main>
    }
}
