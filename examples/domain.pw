// @corpus: fixture
// @id: DOMAIN
// @category: shared domain types for the corpus
// @charter: §7.1, §15.1
// @milestone: E2B
//
// The types the corpus imports from `domain`. Written as real source on the
// architect's ruling of 2026-08-06:
//
//   External implementation is allowed. Missing declaration is not.
//
// Twelve corpus files import from this module and, until now, it did not
// exist — so strict name resolution would have failed all of them on E2B's
// first day. Declaring them here also makes the corpus an actual program, so
// imports, visibility, constructor resolution and cross-file exhaustiveness
// are exercised rather than assumed.
//
// `decode`, `capability` and `browser` are NOT here. They are platform
// modules and arrive with E2C's signature manifests.

module domain

// `line_count` sums a cart's quantities (ADR-0048).
import List
// When a delivery estimate was made (ADR-0180).
import clock.{ Instant, LocalTime, Weekday }
// NEXT 6c: a payment begun at the deployment's provider.
import payments.{ Payment, BeginError }

// --- identities -----------------------------------------------------------
//
// Opaque, so a raw String cannot be passed where an id is expected. E0 finding
// F-4 measured that Koka erases such wrappers at the JS boundary; `pw` owns
// the nominal identity regardless (ADR-0011).

opaque type StoreId = String
opaque type MenuItemId = String
opaque type ConsumerId = String
opaque type OrderId = String
opaque type InteractionId = String

// --- menu -----------------------------------------------------------------

// What a menu holds. `List<MenuItemId>` was what `Menu` used to return, and a
// page that renders `item.name` from a list of ids is describing one thing and
// reading another — harmless while nothing depended on the element's type, and
// not harmless now that a resumable handler inside the loop hashes it into a
// capture schema.
//
// Its description since ADR-0166, charter §15.1's: what the item is, which a
// menu's row shows under its name. Its price since ADR-0169, which the row
// shows as `price.display`. Whether it can be ordered since ADR-0178, which
// the row decides its Add by, before the press. Its store and its category
// since ADR-0181, the rest of charter §15.1's.
type MenuItem = MenuItem {
    id: MenuItemId,
    store_id: StoreId,
    name: String,
    description: String,
    price: Money<USD>,
    available: Bool,
    category: MenuCategory,
}

// **A category of a store's menu** (ADR-0181, charter §15.1's
// `MenuCategory`): what the menu groups its items by.
opaque type CategoryId = String

type MenuCategory = MenuCategory { id: CategoryId, name: String }

// **A category's items, in the order the store lists them** (ADR-0181):
// what a store's menu is, grouped.
type MenuSection = MenuSection { category: MenuCategory, items: List<MenuItem> }

// --- quantities -----------------------------------------------------------

// A count of at least one (ADR-0179): every construction is shown to hold
// it at build, and a value that arrives from outside is checked by the host.
opaque type PositiveInt = Int where value >= 1

// The count a `PositiveInt` holds, for other modules. The type is opaque
// outside this one, where `.value` reads its representation (ADR-0048).
fn count(n: PositiveInt) -> Int !{} { n.value }

// The sum of two counts, for a transition that adds to a line (ADR-0122).
fn added(a: PositiveInt, b: PositiveInt) -> PositiveInt !{} { PositiveInt(a.value + b.value) }

// One fewer, for a line that holds more than one (ADR-0172). A
// `PositiveInt` holds no zero, so one fewer than one is none (ADR-0179).
fn fewer(n: PositiveInt) -> Option<PositiveInt> !{} {
    if n.value > 1 {
        Some(PositiveInt(n.value - 1))
    } else {
        None
    }
}

// --- money ----------------------------------------------------------------
//
// **Money is rounded only where a program names how** (ADR-0327). An amount
// is its minor units, cents for US dollars, read in this module alone
// (ADR-0048). Another module adds amounts, multiplies one by a count, sums
// and compares them, all exactly, and takes a part of one only at a `Rate`,
// naming its `Rounding`: `/` on an amount's units, which floors (ADR-0039),
// is this module's alone to write.

type USD = USD { code: String }

opaque type Money<C> = Int

// **`n` cents.**
fn cents(n: Int) -> Money<USD> !{} {
    Money(n)
}

fn plus<C>(a: Money<C>, b: Money<C>) -> Money<C> !{} {
    Money(a.value + b.value)
}

fn minus<C>(a: Money<C>, b: Money<C>) -> Money<C> !{} {
    Money(a.value - b.value)
}

// **`amount`, `count` times.**
fn times<C>(amount: Money<C>, count: Int) -> Money<C> !{} {
    Money(amount.value * count)
}

// **Amounts added together**: none is nothing.
fn sum<C>(amounts: List<Money<C>>) -> Money<C> !{} {
    Money(List.fold(amounts, 0, (n, amount) => n + amount.value))
}

// **Whether `a` is less than `b`** (track `order-total`): a subtotal under
// a small-order threshold, a fee clamped to its bounds, a discount capped at
// what it discounts.
fn is_less<C>(a: Money<C>, b: Money<C>) -> Bool !{} {
    a.value < b.value
}

// **A rate, in millionths**: 1,000,000 is the whole, 150,000 is 15%, and
// 88,750 is 8.875%, New York City's sales tax. A rate is never negative.
opaque type Rate = Int where value >= 0

// **`p` percent.**
fn percent(p: Int) -> Option<Rate> !{} {
    millionths(p * 10000)
}

// **`n` millionths**, where `n` is not negative.
fn millionths(n: Int) -> Option<Rate> !{} {
    if n >= 0 { Some(Rate(n)) } else { None }
}

// **How a part of a minor unit is rounded** (ADR-0327):
// - `HalfUp`: to the nearer unit, a half away from zero. A half cent or more
//   is a cent, as California's, New York's and Texas's sales taxes ask.
// - `HalfEven`: to the nearer unit, a half to the even one (banker's).
// - `TowardZero`: the part is dropped.
// - `AwayFromZero`: any part is a whole unit more.
type Rounding =
    | HalfUp
    | HalfEven
    | TowardZero
    | AwayFromZero

// **`amount` at `rate`, rounded as `rounding` says**: a fee, a tax, a tip or
// a discount, never a fraction of a cent.
fn at_rate<C>(amount: Money<C>, rate: Rate, rounding: Rounding) -> Money<C> !{} {
    Money(rounded(amount.value * rate.value, 1000000, rounding))
}

// `n / d`, for `d` above 0, rounded as `rounding` says. `/` and `%` are
// Euclidean (ADR-0039): `q` is the floor of `n / d` and `r` is in `[0, d)`.
fn rounded(n: Int, d: Int, rounding: Rounding) -> Int !{} {
    let q = n / d
    let r = n % d
    if r == 0 {
        q
    } else {
        match rounding {
            TowardZero => if n >= 0 { q } else { q + 1 },
            AwayFromZero => if n >= 0 { q + 1 } else { q },
            HalfUp => if r * 2 > d { q + 1 } else if r * 2 < d { q } else if n >= 0 { q + 1 } else { q },
            HalfEven => if r * 2 > d { q + 1 } else if r * 2 < d { q } else if q % 2 == 0 { q } else { q + 1 },
        }
    }
}

// **A price as a person reads it** (ADR-0169): US dollars as en-US writes
// them, `$3.50`, `$1,234.50`, and `-$3.50` for an amount owed back. A member
// of `Money<USD>`, which a page reads as `price.display`.
fn display(price: Money<USD>) -> String !{} {
    // `/` and `%` are Euclidean (ADR-0039): `n % 100` is in `[0, 100)` and
    // `n == 100 * (n / 100) + n % 100`, whatever `n`'s sign. An amount owed
    // back is written from those parts, since `-n` does not fit for the
    // least `Int`.
    let n = price.value
    let q = n / 100
    let r = n % 100
    let dollars = if n >= 0 { q } else if r == 0 { 0 - q } else { 0 - q - 1 }
    let cents = if n >= 0 | r == 0 { r } else { 100 - r }
    let sign = if n < 0 { "-" } else { "" }
    let pad = if cents < 10 { "0" } else { "" }
    "{sign}${grouped(dollars)}.{pad}{cents}"
}

// **A payment begun for `order`'s `total`** (NEXT 6c): only `domain` reads
// an amount's minor units (ADR-0327), so only it says one to the provider.
fn begin_payment(order: String, total: Money<USD>) -> Result<Payment, BeginError> !{ payments.begin } {
    payments.begin(order, total.value)
}

// `1234567` as `1,234,567`: a comma before each three digits, from the
// right, of a count that is not negative.
fn grouped(n: Int) -> String !{} {
    if n < 1000 {
        "{n}"
    } else {
        let rest = n % 1000
        let pad = if rest < 10 { "00" } else if rest < 100 { "0" } else { "" }
        "{grouped(n / 1000)},{pad}{rest}"
    }
}

// A geographic point. A-007, A-019 and A-024 wrote `center: LatLng` for two
// years of corpus history while no module declared it — an annotation naming
// nothing, which checked nothing, and nothing said so until 2026-09-24.
type LatLng = LatLng { lat: Float, lng: Float }

// --- store ----------------------------------------------------------------

type StoreHours = StoreHours {
    opens_minute: Int,
    closes_minute: Int,
}

// What the store says of itself since ADR-0166, charter §15.1's; what it
// serves, in its own words, since ADR-0308's amendment.
type Store = Store {
    id: StoreId,
    name: String,
    description: String,
    cuisine: String,
    hours: StoreHours,
}

// A live connection to the database. Opaque, and a resource: `Database.connect`
// declares `resource.acquire<DatabaseConnection>`.
opaque type DatabaseConnection = String

// An open transaction. Affine: it must end exactly once, and the row of the
// function that produced it says so.
opaque type DatabaseTransaction = String

type StoreError =
    | NotFound
    | Unavailable
    | DecodeFailed(String)

// --- cart -----------------------------------------------------------------

// A line of a cart: its item, as it was when the line was made, and how
// many. The name and the price are recorded with the line (ADR-0172), as
// charter §15.1's `unit_price` is: the line shows what was added.
type CartLine = CartLine {
    item_id: MenuItemId,
    name: String,
    quantity: PositiveInt,
    unit_price: Money<USD>,
}

type Cart = Cart {
    lines: List<CartLine>,
}

// **What a cart count shows**: the quantity across its lines. The store's page
// rendered `{cart.line_count}` from the first E7 demo, and `Cart` has no such
// field: the dev server filled that path from its own state, and nothing
// checked that the type had it (ADR-0048). It is a member of `Cart` now, and
// the host's value is this function's.
fn line_count(cart: Cart) -> Int !{} {
    List.fold(cart.lines, 0, fn(n, line) n + line.quantity.count)
}

// **What a line costs** (ADR-0172): its price, as many times as it holds.
fn total(line: CartLine) -> Money<USD> !{} {
    times(line.unit_price, line.quantity.value)
}

// **What a cart's lines cost together** (ADR-0172), before any fee.
fn subtotal(cart: Cart) -> Money<USD> !{} {
    sum(List.map(cart.lines, total))
}

type CartError =
    | ItemUnavailable(MenuItemId)
    | QuantityTooLarge
    | CartExpired
    // The store does not deliver to the reader's chosen address (track
    // `store-accounts`, ADR-0319).
    | OutOfRange(StoreId)

// --- orders ---------------------------------------------------------------

// **Where a customer's order is** (ADR-0193): what the store last said of
// it, or, where the deployment takes payments, that it awaits its payment
// on the provider's page, or was taken back before it was paid (NEXT 6c).
type OrderStatus =
    | Placed
    | Preparing
    | OnTheWay
    | Delivered
    | AwaitingPayment(PaymentPage)
    | Canceled
    // Paid, and sent to its stores at its time (track `scheduled-orders`):
    // the store is told nothing until its preparation is due.
    | Scheduled(ScheduledFor)

// **When an order is for, and when its stores are told** (track
// `scheduled-orders`): the start of the window its reader chose; when it is
// sent to its stores, that less their estimates at their most and five
// minutes more; and the window's day and time in its first store's zone,
// which a page words, having no zone database (ADR-0328).
type ScheduledFor = ScheduledFor { at: Instant, sends: Instant, day: Weekday, time: LocalTime }

// **The provider's page an order's payment is made on** (NEXT 6c): what the
// order page frames, the provider's own origin.
type PaymentPage = PaymentPage { url: String }

// **The payment an order awaits** (NEXT 6c, step eight): the order's
// reference and the payment's id at the provider.
type AwaitedPayment = AwaitedPayment { order: String, payment: String }

// **Why an order was not placed** (ADR-0193). `AwaitingPayment`: an order
// of the reader's awaits its payment, which the order page frames (NEXT 6c).
type OrderError =
    | NothingToOrder
    // A store an item is from does not deliver to the reader's chosen address
    // (track `store-accounts`, ADR-0319).
    | NoCoverage
    // A store an item is from is closed, or past its last order (track
    // `store-hours`): which, as data the page words (the integrator's
    // ruling of 2026-10-12).
    | Closed(Closing)
    // The promo code the cart carries no longer applies (track
    // `order-total`): it expired, or was used, since it was applied. The
    // order is not placed without the discount the reader saw.
    | Promo(PromoError)
    // The total the reader was shown is not the total now (track
    // `order-total`, the integrator's ruling of 2026-10-13): a fee
    // schedule, a rate or the clock moved. The reader pays the total they
    // were shown, or is shown the new one.
    | TotalChanged(Money<USD>)
    // An order of the reader's awaits its payment (NEXT 6c): a second is not
    // begun beside it, whose payment the first's settling would not reach.
    | AwaitingPayment
    // The deployment's provider could not be reached to begin the payment
    // (NEXT 6c): nothing is written, and the reader may press again.
    | PaymentUnavailable
    // The time the reader chose is no longer offered (track
    // `scheduled-orders`): an hour away or less, or a store of the cart is
    // not open then. The reader is shown the times offered now.
    | NotOffered(Instant)
    // An order of the reader's is scheduled (track `scheduled-orders`): a
    // second is not placed beside it until it is sent to its stores.
    | Scheduled

// **Why an order was not taken back** (NEXT 6c, step eight).
type CancelOrderError =
    // No order of the reader's awaits its payment: none to take back.
    | NotAwaitingPayment
    // Its payment is past canceling, paid or being paid: the order stands,
    // and the provider's word places it.
    | Paid
    // The provider could not be reached to cancel the payment: the order
    // awaits still, and the reader may press again.
    | PaymentUnavailable

// --- checkout (track `order-total`) ---------------------------------------

// **The tip the reader chose**: none unless they choose one, never a
// default (California's Regulation 1603(h) and New York's TB-ST-320 make
// an automatic tip a mandatory charge, and taxed); a percent of the
// subtotal, rounded half up; or an amount. Never taxed.
type Tip =
    | NoTip
    | Fifteen
    | Eighteen
    | Twenty
    | TipAmount(Money<USD>)

// **Why a promo code does not apply**, each by name.
type PromoError =
    | UnknownCode
    | Expired
    | BelowMinimum(Money<USD>)
    | AlreadyUsed
    // Its store has no line in the cart: a code is one store's.
    | NotInCart

// **Why a tip is refused**: an amount below nothing.
type TipError =
    | NegativeTip

// **Who pays for a discount.** A store's own lowers what is taxed; one the
// platform reimburses does not (California's Regulation 1671.1, New York's
// TB-ST-806).
type FundedBy =
    | ByStore
    | ByPlatform

// **One store's part of an order, as charged** (the integrator's ruling of
// 2026-10-13): its food's subtotal, its discount and who funds it, its
// fees, what was taxed, the rate applied and the tax. Recorded with the
// order, so a later change of rate never rewrites what was charged.
type PartCharged = PartCharged {
    store: StoreId,
    subtotal: Money<USD>,
    discount: Money<USD>,
    funded_by: Option<FundedBy>,
    delivery: Money<USD>,
    service: Money<USD>,
    small_order: Money<USD>,
    taxable: Money<USD>,
    tax_rate: Rate,
    tax: Money<USD>,
}

// **An order as charged**: each store's part, the tip, once, and the total.
type OrderCharged = OrderCharged {
    parts: List<PartCharged>,
    tip: Money<USD>,
    total: Money<USD>,
}

// **An order's charges added across its stores**: what the cart page
// itemizes.
type Charges = Charges {
    subtotal: Money<USD>,
    discount: Money<USD>,
    delivery: Money<USD>,
    service: Money<USD>,
    small_order: Money<USD>,
    tax: Money<USD>,
    tip: Money<USD>,
    total: Money<USD>,
}

// **Why a store takes no order now** (track `store-hours`): closed, and when
// it opens where it does within a week; or past its last order, which was at
// the time it carries, in the store's zone.
type Closing =
    | ClosedNow(Option<Opening>)
    | PastLastOrder(LocalTime)

// **When a store opens**: its day, seen from the store's today, and its time.
type Opening = Opening { day: OpeningDay, at: LocalTime }

type OpeningDay =
    | Today
    | Tomorrow
    | On(Weekday)

type OrderDraft = OrderDraft {
    id: OrderId,
    cart: Cart,
}

type OrderProgress = OrderProgress {
    stage_label: String,
}

type PaymentError =
    | Declined
    | InsufficientFunds
    | TransportFailed

type TrackingError =
    | OrderNotFound
    | TrackingUnavailable

// The four `OrderState` payloads. A-002 declares the union and imports these;
// R-007 matches on it non-exhaustively, and the witness names them — which is
// how `Cancelled(CancellationReason)` reaches the diagnostic rather than
// `Cancelled(String)`.

type OrderConfirmation = OrderConfirmation {
    reference: String,
}

type OrderProgressStage = OrderProgressStage {
    stage_label: String,
}

type DeliveryReceipt = DeliveryReceipt {
    delivered_at_local: String,
}

type CancellationReason = CancellationReason {
    label: String,
}

type OrderFailure = OrderFailure {
    label: String,
}

// The order lifecycle. Declared here rather than in a view module so both
// A-002 (which handles every variant) and R-007 (which does not) import it
// through the ordinary module graph. R-007 previously relied on assumption
// A-009's ambient union to see it at all — name-resolution failure must not be
// what makes an exhaustiveness fixture red.

type OrderState =
    | Draft
    | Pricing
    | AuthorizingPayment
    | Submitting
    | SearchingForDasher
    | Confirmed(OrderConfirmation)
    | InProgress(OrderProgress)
    | Delivered(DeliveryReceipt)
    | Cancelled(CancellationReason)
    | Failed(OrderFailure)

// --- recommendations ------------------------------------------------------

// What a captured payment returns (A-010). Named by the corpus, declared by
// nothing, until the value relations made an unresolved annotation an error.
type PaymentReceipt = PaymentReceipt { order: OrderId, amount: Money<USD> }

// A delivery estimate and why one could not be made (R-025). A range, as
// a courier, a kitchen and the traffic each vary, and when it was made
// (ADR-0180, charter §15.1). Each bound is a `PositiveInt`, so an estimator's
// answer of 0 minutes is a failed read (ADR-0179).
type DeliveryEstimate = DeliveryEstimate {
    min_minutes: PositiveInt,
    max_minutes: PositiveInt,
    generated_at: Instant,
}

type EstimateError =
    | NoCoverage
    | LocationUnavailable

// A row of the inventory table (A-023).
type InventoryRow = InventoryRow { id: MenuItemId, name: String, status: String }

type Recommendation = Recommendation {
    id: MenuItemId,
    name: String,
}

type RecommendationError =
    | NoneAvailable
    | Timeout

// --- sync -----------------------------------------------------------------

type SyncError =
    | Conflict
    | Offline

// Whether two ids name one item. The representation is readable only here
// (ADR-0048), so the comparison is written here (ADR-0122).
fn same_item(a: MenuItemId, b: MenuItemId) -> Bool !{} { a.value == b.value }

// Whether two ids name one store (track `store-hours`).
fn same_store(a: StoreId, b: StoreId) -> Bool !{} { a.value == b.value }
