// @corpus: fixture
// @id: DOMAIN
// @category: shared domain types for the corpus
// @charter: §7.1, §15.1
// @milestone: E2B
//
// The types the corpus imports from `domain`. Written as real source on the
// architect's ruling of 2026-08-06:
//
//   External implementation is allowed. Missing declaration is not.
//
// Twelve corpus files import from this module and, until now, it did not
// exist — so strict name resolution would have failed all of them on E2B's
// first day. Declaring them here also makes the corpus an actual program, so
// imports, visibility, constructor resolution and cross-file exhaustiveness
// are exercised rather than assumed.
//
// `decode`, `capability` and `browser` are NOT here. They are platform
// modules and arrive with E2C's signature manifests.

module domain

// `line_count` sums a cart's quantities (ADR-0048).
import List
// When a delivery estimate was made (ADR-0180).
import clock.{ Instant }

// --- identities -----------------------------------------------------------
//
// Opaque, so a raw String cannot be passed where an id is expected. E0 finding
// F-4 measured that Koka erases such wrappers at the JS boundary; `pw` owns
// the nominal identity regardless (ADR-0011).

opaque type StoreId = String
opaque type MenuItemId = String
opaque type ConsumerId = String
opaque type OrderId = String
opaque type InteractionId = String

// --- menu -----------------------------------------------------------------

// What a menu holds. `List<MenuItemId>` was what `Menu` used to return, and a
// page that renders `item.name` from a list of ids is describing one thing and
// reading another — harmless while nothing depended on the element's type, and
// not harmless now that a resumable handler inside the loop hashes it into a
// capture schema.
//
// Its description since ADR-0166, charter §15.1's: what the item is, which a
// menu's row shows under its name. Its price since ADR-0169, which the row
// shows as `price.display`. Whether it can be ordered since ADR-0178, which
// the row decides its Add by, before the press. Its store and its category
// since ADR-0181, the rest of charter §15.1's.
type MenuItem = MenuItem {
    id: MenuItemId,
    store_id: StoreId,
    name: String,
    description: String,
    price: Money<USD>,
    available: Bool,
    category: MenuCategory,
}

// **A category of a store's menu** (ADR-0181, charter §15.1's
// `MenuCategory`): what the menu groups its items by.
opaque type CategoryId = String

type MenuCategory = MenuCategory { id: CategoryId, name: String }

// **A category's items, in the order the store lists them** (ADR-0181):
// what a store's menu is, grouped.
type MenuSection = MenuSection { category: MenuCategory, items: List<MenuItem> }

// --- quantities -----------------------------------------------------------

// A count of at least one (ADR-0179): every construction is shown to hold
// it at build, and a value that arrives from outside is checked by the host.
opaque type PositiveInt = Int where value >= 1

// The count a `PositiveInt` holds, for other modules. The type is opaque
// outside this one, where `.value` reads its representation (ADR-0048).
fn count(n: PositiveInt) -> Int !{} { n.value }

// The sum of two counts, for a transition that adds to a line (ADR-0122).
fn added(a: PositiveInt, b: PositiveInt) -> PositiveInt !{} { PositiveInt(a.value + b.value) }

// One fewer, for a line that holds more than one (ADR-0172). A
// `PositiveInt` holds no zero, so one fewer than one is none (ADR-0179).
fn fewer(n: PositiveInt) -> Option<PositiveInt> !{} {
    if n.value > 1 {
        Some(PositiveInt(n.value - 1))
    } else {
        None
    }
}

type USD = USD { code: String }

type Money<C> = Money { minor_units: Int }

// **A price as a person reads it** (ADR-0169): US dollars as en-US writes
// them, `$3.50`, `$1,234.50`, and `-$3.50` for an amount owed back. A member
// of `Money<USD>`, which a page reads as `price.display`.
fn display(price: Money<USD>) -> String !{} {
    // `/` and `%` are Euclidean (ADR-0039): `n % 100` is in `[0, 100)` and
    // `n == 100 * (n / 100) + n % 100`, whatever `n`'s sign. An amount owed
    // back is written from those parts, since `-n` does not fit for the
    // least `Int`.
    let n = price.minor_units
    let q = n / 100
    let r = n % 100
    let dollars = if n >= 0 { q } else if r == 0 { 0 - q } else { 0 - q - 1 }
    let cents = if n >= 0 | r == 0 { r } else { 100 - r }
    let sign = if n < 0 { "-" } else { "" }
    let pad = if cents < 10 { "0" } else { "" }
    "{sign}${grouped(dollars)}.{pad}{cents}"
}

// `1234567` as `1,234,567`: a comma before each three digits, from the
// right, of a count that is not negative.
fn grouped(n: Int) -> String !{} {
    if n < 1000 {
        "{n}"
    } else {
        let rest = n % 1000
        let pad = if rest < 10 { "00" } else if rest < 100 { "0" } else { "" }
        "{grouped(n / 1000)},{pad}{rest}"
    }
}

// A geographic point. A-007, A-019 and A-024 wrote `center: LatLng` for two
// years of corpus history while no module declared it — an annotation naming
// nothing, which checked nothing, and nothing said so until 2026-09-24.
type LatLng = LatLng { lat: Float, lng: Float }

// --- store ----------------------------------------------------------------

type StoreHours = StoreHours {
    opens_minute: Int,
    closes_minute: Int,
}

// What the store says of itself since ADR-0166, charter §15.1's.
type Store = Store {
    id: StoreId,
    name: String,
    description: String,
    hours: StoreHours,
}

// A live connection to the database. Opaque, and a resource: `Database.connect`
// declares `resource.acquire<DatabaseConnection>`.
opaque type DatabaseConnection = String

// An open transaction. Affine: it must end exactly once, and the row of the
// function that produced it says so.
opaque type DatabaseTransaction = String

type StoreError =
    | NotFound
    | Unavailable
    | DecodeFailed(String)

// --- cart -----------------------------------------------------------------

// A line of a cart: its item, as it was when the line was made, and how
// many. The name and the price are recorded with the line (ADR-0172), as
// charter §15.1's `unit_price` is: the line shows what was added.
type CartLine = CartLine {
    item_id: MenuItemId,
    name: String,
    quantity: PositiveInt,
    unit_price: Money<USD>,
}

type Cart = Cart {
    lines: List<CartLine>,
}

// **What a cart count shows**: the quantity across its lines. The store's page
// rendered `{cart.line_count}` from the first E7 demo, and `Cart` has no such
// field: the dev server filled that path from its own state, and nothing
// checked that the type had it (ADR-0048). It is a member of `Cart` now, and
// the host's value is this function's.
fn line_count(cart: Cart) -> Int !{} {
    List.fold(cart.lines, 0, fn(n, line) n + line.quantity.count)
}

// **What a line costs** (ADR-0172): its price, as many times as it holds.
fn total(line: CartLine) -> Money<USD> !{} {
    Money { minor_units: line.unit_price.minor_units * line.quantity.value }
}

// **What a cart's lines cost together** (ADR-0172), before any fee.
fn subtotal(cart: Cart) -> Money<USD> !{} {
    Money { minor_units: List.fold(cart.lines, 0, fn(n, line) n + total(line).minor_units) }
}

type CartError =
    | ItemUnavailable(MenuItemId)
    | QuantityTooLarge
    | CartExpired

// --- orders ---------------------------------------------------------------

type OrderDraft = OrderDraft {
    id: OrderId,
    cart: Cart,
}

type OrderProgress = OrderProgress {
    stage_label: String,
}

type PaymentError =
    | Declined
    | InsufficientFunds
    | TransportFailed

type TrackingError =
    | OrderNotFound
    | TrackingUnavailable

// The four `OrderState` payloads. A-002 declares the union and imports these;
// R-007 matches on it non-exhaustively, and the witness names them — which is
// how `Cancelled(CancellationReason)` reaches the diagnostic rather than
// `Cancelled(String)`.

type OrderConfirmation = OrderConfirmation {
    reference: String,
}

type OrderProgressStage = OrderProgressStage {
    stage_label: String,
}

type DeliveryReceipt = DeliveryReceipt {
    delivered_at_local: String,
}

type CancellationReason = CancellationReason {
    label: String,
}

type OrderFailure = OrderFailure {
    label: String,
}

// The order lifecycle. Declared here rather than in a view module so both
// A-002 (which handles every variant) and R-007 (which does not) import it
// through the ordinary module graph. R-007 previously relied on assumption
// A-009's ambient union to see it at all — name-resolution failure must not be
// what makes an exhaustiveness fixture red.

type OrderState =
    | Draft
    | Pricing
    | AuthorizingPayment
    | Submitting
    | SearchingForDasher
    | Confirmed(OrderConfirmation)
    | InProgress(OrderProgress)
    | Delivered(DeliveryReceipt)
    | Cancelled(CancellationReason)
    | Failed(OrderFailure)

// --- recommendations ------------------------------------------------------

// What a captured payment returns (A-010). Named by the corpus, declared by
// nothing, until the value relations made an unresolved annotation an error.
type PaymentReceipt = PaymentReceipt { order: OrderId, amount: Money<USD> }

// A delivery estimate and why one could not be made (R-025). A range, as
// a courier, a kitchen and the traffic each vary, and when it was made
// (ADR-0180, charter §15.1). Each bound is a `PositiveInt`, so an estimator's
// answer of 0 minutes is a failed read (ADR-0179).
type DeliveryEstimate = DeliveryEstimate {
    min_minutes: PositiveInt,
    max_minutes: PositiveInt,
    generated_at: Instant,
}

type EstimateError =
    | NoCoverage
    | LocationUnavailable

// A row of the inventory table (A-023).
type InventoryRow = InventoryRow { id: MenuItemId, name: String, status: String }

type Recommendation = Recommendation {
    id: MenuItemId,
    name: String,
}

type RecommendationError =
    | NoneAvailable
    | Timeout

// --- sync -----------------------------------------------------------------

type SyncError =
    | Conflict
    | Offline

// Whether two ids name one item. The representation is readable only here
// (ADR-0048), so the comparison is written here (ADR-0122).
fn same_item(a: MenuItemId, b: MenuItemId) -> Bool !{} { a.value == b.value }
