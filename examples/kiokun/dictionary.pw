// @corpus: fixture
// @id: KIOKUN-dictionary
// @category: the kiokun slice — an entry and a search hit, as kiokun.com's
//            app reads them
// @charter: §14 M10
// @milestone: E10
//
// kiokun.com is a Chinese, Japanese and Korean dictionary. Its build merges
// CC-CEDICT, JMdict, JMnedict, KANJIDIC and a Korean dictionary into one entry
// per word, keyed by the traditional form, and a simplified or Japanese form
// is a stub that redirects to it. These are that entry and one row of search
// results, narrowed to what the slice renders.

module dictionary

// One Chinese reading of a word: its forms, pinyin, and definitions. `id` is
// CC-CEDICT's line, which keys the list: one entry can have several readings
// with the same pinyin.
type ChineseWord = ChineseWord {
    id: String,
    traditional: String,
    simplified: String,
    pinyin: String,
    definitions: String,
}

// One sense of a Japanese word, its glosses joined.
type JapaneseSense = JapaneseSense {
    id: String,
    glosses: String,
}

// One Japanese word: its written forms and readings, and its senses. `id` is
// JMdict's sequence number.
type JapaneseWord = JapaneseWord {
    id: String,
    written: String,
    readings: String,
    senses: List<JapaneseSense>,
    common: Bool,
}

// One Korean word, from the Korean Learners' Dictionary: its hangul, its
// hanja where it has one, its pronunciation, and its definitions joined.
type KoreanWord = KoreanWord {
    id: String,
    hangul: String,
    hanja: String,
    pronunciation: String,
    definitions: String,
}

// One Japanese name, from JMnedict: its written forms and readings, what
// kind of name it is (given, surname, place..), and its romanizations.
type JapaneseName = JapaneseName {
    id: String,
    written: String,
    readings: String,
    kinds: String,
    translations: String,
}

// The character an entry is, when it is one. Strokes, grade, the former
// JLPT level and frequency are KANJIDIC's where it has them; the hangul
// readings and meanings are the hanja table's.
type Character = Character {
    strokes: Option<Int>,
    grade: Option<Int>,
    jlpt: Option<Int>,
    frequency: Option<Int>,
    hangul: String,
    meanings: String,
}

// An entry. A stub carries only `key` and `redirect`, the entry it names.
type Entry = Entry {
    key: String,
    redirect: Option<String>,
    chinese: List<ChineseWord>,
    japanese: List<JapaneseWord>,
    korean: List<KoreanWord>,
    names: List<JapaneseName>,
    character: Option<Character>,
}

// One search result. `id` is unique within a result list: a word can match
// in Chinese and in Japanese, and the list is keyed.
type SearchHit = SearchHit {
    id: String,
    word: String,
    target: String,
    language: String,
    pronunciation: String,
    definition: String,
    common: Bool,
}

// Where a word's file is, by kiokun's shard rule: which of the 28 shards it
// belongs to, and the subdirectory it sits in, as
// `<subdirectory>/<word>.json.deflate`.
type Placement = Placement {
    shard: String,
    subdirectory: String,
}

// One searchable row, as the index returns it: one definition of one word.
// `folded` and `words` are the definition as the index's tokenizer reads it,
// case-folded and split into words, the division kiokun.com keeps: its SQLite
// FTS5 tokenizer folds case, and its application ranks.
type Row = Row {
    word: String,
    target: String,
    language: String,
    pronunciation: String,
    reading: String,
    definition: String,
    folded: String,
    words: List<String>,
    common: Bool,
}
