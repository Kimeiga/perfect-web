// @status: NARROW
// @invariant: non_exhaustive_match
//
// A gap found by writing a counterexample rather than by reasoning about the
// checker. The OUTER match is exhaustive; the inner one, in an arm, covers two
// of five `OrderState` variants. R-007's shape — one match, at the top of a
// body — is caught. This one is not.
//
// The exhaustiveness checker is real and differentially tested against Koka
// (ADR-0011); what it does not do is descend into a match that appears as an
// arm's result. This file must compile clean today, and stop compiling when
// it does.

module generality.match_nested

import domain.{ OrderState, CancellationReason }

fn describe(a: OrderState, b: OrderState) -> String !{} {
    match a {
        Placed => match b {
            Placed => "both placed"
            Delivered => "one delivered"
        }
        Delivered => "delivered"
        Cancelled(r) => "cancelled"
        Preparing => "preparing"
        Ready => "ready"
    }
}
