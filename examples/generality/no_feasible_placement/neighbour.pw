// @status: NEIGHBOUR
// @invariant: no_feasible_placement
// @dimension: valid neighbour — two capabilities one world DOES grant
//
// A secret read and a network fetch: the origin grants both. A rule reacting
// to "more than one capability family" would catch this.
module generality.one_world_ok

import Payments
import domain.{ OrderId, PaymentError }
import domain.{ Money, PaymentReceipt }

fn charge(order: OrderId) -> Result<PaymentReceipt, PaymentError>
    !{ secret.read, network.fetch }
{
    Payments.charge(order, Money(100))
}
