// @status: GENERAL
// @invariant: refers_across_sources
//
// Structurally different from R-105: the referring table is held by no
// source (the host's own database), and the table it names by one
// (`MemberData`, A-051): two databases all the same.

module Replies

import Members.{ MemberId }
import Members

opaque type ReplyId = String

type Reply = Reply { id: ReplyId, author: MemberId, text: String }

table Replies
    row    Reply
    key    id
    refers author to Members
