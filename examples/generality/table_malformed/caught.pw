// @status: GENERAL
// @invariant: table_malformed
//
// Structurally different from R-100 and R-101: the key and the indexes are
// sound, and the fault is a reference, whose field holds what is no key of
// the table it names, a self-reference keyed by BadgeId.

module Badges

opaque type BadgeId = String

type Badge = Badge { id: BadgeId, holder: Option<String> }

table Badges
    row    Badge
    key    id
    refers holder to Badges
