// @status: NEIGHBOUR
// @invariant: table_malformed
// @dimension: valid neighbour — a reference whose field holds the key of the table it names, or none
//
// The same reference, its field the `MemberId` that keys `Members`: a rule
// that refused references, rather than references to another key, would
// refuse it.

module Ribbons

import Members.{ MemberId }
import Members

opaque type RibbonId = String

type Ribbon = Ribbon { id: RibbonId, holder: Option<MemberId> }

table Ribbons
    row    Ribbon
    key    id
    refers holder to Members
