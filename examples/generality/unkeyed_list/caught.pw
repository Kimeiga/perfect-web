// @status: GENERAL
// @invariant: unkeyed_list
//
// Structurally different from R-018: the unkeyed loop is nested two elements
// deep inside a KEYED outer loop, so the file contains a correct use of the
// same construct in the same markup tree.

module generality.list_nested

import domain.{ MenuItem, StoreId }

// Until 2026-09-26 the outer list was a `List<StoreId>`, whose elements have
// no `items`, and nothing checked the field (ADR-0074).
type Group = Group { id: StoreId, items: List<MenuItem> }

view Grid(groups: List<Group>) !{} {
    <ul>
        {#each groups as g (g.id)}
            <li>
                <ul>
                    {#each g.items as item}
                        <li>{item.name}</li>
                    {/each}
                </ul>
            </li>
        {/each}
    </ul>
}
