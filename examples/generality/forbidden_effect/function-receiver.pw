// @status: GENERAL
// @invariant: forbidden_effect
// @dimension: a module-qualified function is a real member receiver

module receiver_witness

type Item = Item { name: String }

fn stamp() -> String !{ database.read<Item> }
    host "shop:data/items#stamp"

fn apply(f: fn() -> String) -> String !{} { f() }

view Show() !{} { <p>{receiver_witness.stamp.apply}</p> }
