// @status: GENERAL
// @invariant: forbidden_effect
//
// Structurally different from R-001: the network call is not in the view's own
// body but two helpers away, and the view declares the effect rather than
// hiding it. Declaring it is exactly what must not help.

module generality.view_fetch_depth

import Estimates
import device.{ Location }
import domain.{ StoreError }
import domain.{ DeliveryEstimate, EstimateError }

fn nearby(at: Location) -> Result<DeliveryEstimate, EstimateError> !{ network.fetch } {
    Estimates.for_location(at)
}

// A `String`, which a template writes as text. Until 2026-09-26 this answered
// the `Result`, which a template takes apart with `{#match}`, and nothing
// checked the hole (ADR-0074).
fn label(at: Location) -> String !{ network.fetch } {
    match nearby(at) {
        Ok(_) => "soon",
        Err(_) => "unavailable",
    }
}

view Nearby(at: Location) !{ network.fetch } {
    <p>{label(at)}</p>
}
