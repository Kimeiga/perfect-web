// @status: GENERAL
// @invariant: shared_key_omits_code_version
// @dimension: the key names four other dimensions, so the omission is a gap in
//             a careful key rather than a fragment with no key policy at all
module generality.materialize_thorough_key

import domain.{ StoreId }
import Resources.{ Menu }
import Events.{ MenuChanged }

materialize CarefulButDrifting(id: StoreId) {
    placement      edge
    partition      public
    depends_on     Menu(id)
    invalidates_on MenuChanged(id)
    regenerate     on_invalidation
    stampede       single_flight
    fallback       last_known_good
    locale         included_in_key
    tenant         included_in_key
    policy_version included_in_key
}
