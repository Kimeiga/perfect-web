// @status: NEIGHBOUR
// @invariant: retry_unbounded
// @dimension: valid neighbour — bounded, and idempotent
module generality.retry_bounded_ok

import Payments
import domain.{ OrderId, PaymentError }
import domain.{ Money, PaymentReceipt }

command sync(order: OrderId) -> Result<PaymentReceipt, PaymentError>
    requires      SignedIn
    retry         bounded_exponential(max = 5, jitter = true)
    idempotent_by InteractionId
{
    Payments.charge(order, Money(1))
}
