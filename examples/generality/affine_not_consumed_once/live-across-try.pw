// @status: GENERAL
// @invariant: affine_not_consumed_once
// @dimension: indirect invalid — the early exit is a `?`, not a `return`
//
// `Carts.clear(..)?` leaves the body when the clear fails, and the transaction
// is still open on that path. A `?` is an exit as much as a `return` is; until
// 2026-09-25 the check did not know it was one.

module generality.affine_try

import Carts
import Database
import context.{ current_session }
// The accepted corpus's `Cart` reads what this command writes, and listens
// for this event (ADR-0101).
import Events.{ CartChanged }
import domain.{ CartError }

command clear_cart() -> Result<(), CartError>
    requires SignedIn
    emits CartChanged(current_session())
{
    let tx = Database.begin()
    Carts.clear(current_session())?
    tx.commit()
}
