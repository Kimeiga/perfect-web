// @status: NARROW
// @invariant: affine_not_consumed_once
//
// The gap in `affine.rs`, as an executable program rather than a sentence.
//
// The transaction is released on ONE branch and returned from the other, so
// there is a path that leaves it open — the same defect R-011 has. The current
// check asks whether a `return` sits textually between the acquisition and the
// FIRST release; here the release comes first in the text, so it does not.
//
// This file must compile clean today. When control-flow analysis lands it must
// stop compiling, and this file moves to `caught.pw`.

module generality.affine_branch

import Carts
import Database

command drain_cart() -> Result<(), CartError>
    requires SignedIn
{
    let tx = Database.begin()
    if Carts.is_empty(current_session()) {
        Database.rollback(tx)
    } else {
        // No release on this path, and no `return` before the one above.
        return Ok(())
    }
    tx.commit()
}
