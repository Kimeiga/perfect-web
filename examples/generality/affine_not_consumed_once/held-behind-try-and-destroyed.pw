// @status: NEIGHBOUR
// @invariant: affine_not_consumed_once
// @dimension: valid neighbour — the same handle, destroyed
//
// `held-behind-try.pw`, destroying the handle `?` took out of the
// `Result`: the binding is followed, and its release counted (ADR-0250).

module generality.affine_behind_try_destroyed

import Maps
import browser.{ ElementRef, MapHandle, MapError }
import domain.{ LatLng }

fn show(container: ElementRef, center: LatLng) -> Result<(), MapError>
    !{ dom.mutate, layout.measure, resource.acquire<MapHandle>, resource.release<MapHandle> }
{
    let handle = Maps.create(container, center)?
    Maps.destroy(handle)
    Ok(())
}
