// @status: GENERAL
// @invariant: affine_not_consumed_once
// @dimension: deferred execution — a function value's result
//
// `open` returns a transaction to whatever calls it, and nothing follows
// what calls a function value. Until ADR-0250 an acquisition inside one was
// not looked at.

module generality.affine_function_value

import Carts
import Database
import context.{ current_session }
// The accepted corpus's `Cart` reads what this command writes, and listens
// for this event (ADR-0101).
import Events.{ CartChanged }
import domain.{ CartError }

command clear_cart() -> Result<(), CartError>
    requires SignedIn
    emits CartChanged(current_session())
{
    let open = () => Database.begin()
    let _cleared = Carts.clear(current_session())
    Ok(())
}
