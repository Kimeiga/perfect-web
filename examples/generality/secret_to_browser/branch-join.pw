// @status: GENERAL
// @invariant: secret_to_browser
// @dimension: branch join
module generality.secret_branch

import secrets
import capability.{ Secret, Payments }

page Checkout(dry_run: Bool) {
    placement origin
    let key: Secret<Payments> = secrets.payments()
    // Each branch is a `String`, the second interpolating the secret: a
    // branch of another type, `{ key }`, was a second defect, and
    // PW0613 refuses it since 2026-09-26 (ADR-0068).
    let shown = if dry_run { "none" } else { "{key}" }
    view { <main><p>{shown}</p></main> }
}
