// @status: GENERAL
// @invariant: declared_placement_cannot_grant
// @dimension: direct invalid
module generality.place_direct

import Estimates
import device
import capability.{ SessionId }
import domain.{ DeliveryEstimate, EstimateError }

query DeliveryEstimate(session: SessionId) -> Result<DeliveryEstimate, EstimateError>
    placement origin
    cache     private
{
    let here = device.current_location()
    Estimates.for_location(here)
}
