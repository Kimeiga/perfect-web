// @status: GENERAL
// @invariant: declared_placement_cannot_grant
//
// Structurally different from R-025: a different world (edge, not origin), a
// different capability family (secret, not device), and the effect arrives
// through a helper rather than a direct call.

module generality.placement_edge_secret

import Payments
import domain.{ OrderId, PaymentError }
import domain.{ Money, PaymentReceipt }

fn charge_now(order: OrderId) -> Result<PaymentReceipt, PaymentError> !{ secret.read, network.fetch } {
    Payments.charge(order, Money(100))
}

query EdgePrice(order: OrderId) -> Result<PaymentReceipt, PaymentError>
    placement edge
    cache     private
{
    charge_now(order)
}
