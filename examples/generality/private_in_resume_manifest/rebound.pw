// @status: GENERAL
// @invariant: private_in_resume_manifest
// @dimension: indirect invalid — the same value, renamed first
//
// A rule reading the PARAMETER list would see `cart: Cart` and miss that what
// is captured is `held`.
module generality.resume_private_rebound

import domain.{ Cart }
import cart.queries

// 2026-09-25: the handler called `checkout(cart.id)`, and `Cart` has no `id`
// (ADR-0048). The callee takes the captured cart, and is declared here so the
// witness depends on no library signature; its subject, the capture, is
// unchanged.
fn checkout_cart(cart: Cart) -> () !{} { todo }

view CartSummary(cart: Cart) !{} {
    let held = cart
    <section aria-label="Cart">
        <button on:press={resumable(captures = { held }) => checkout_cart(held)}>
            Checkout
        </button>
    </section>
}
