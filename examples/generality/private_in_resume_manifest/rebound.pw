// @status: GENERAL
// @invariant: private_in_resume_manifest
// @dimension: indirect invalid — the same value, renamed first
//
// A rule reading the PARAMETER list would see `cart: Cart` and miss that what
// is captured is `held`.
module generality.resume_private_rebound

import domain.{ Cart }
import cart.queries
// 2026-08-10: PW0021 learned to examine bare calls. A witness that calls a
// name nothing declares is invalid evidence by the corpus's own rule, so the
// callee is declared here — the witness stays self-contained and its subject
// is unchanged.
import Carts.{ checkout }

view CartSummary(cart: Cart) !{} {
    let held = cart
    <section aria-label="Cart">
        <button on:press={resumable(captures = { held }) => checkout(held.id)}>
            Checkout
        </button>
    </section>
}
