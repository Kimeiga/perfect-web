// @status: NEIGHBOUR
// @invariant: undeclared_effect
// @dimension: valid neighbour — the same chain, declared
//
// The identical call graph with a row that names both. A rule reacting to the
// depth of the chain, or to a lambda being present, would catch this.
module generality.effect_complete

import Stores
import Telemetry
import List
import domain.{ Store, StoreId }
import domain.{ StoreError }

fn record(id: StoreId) -> Result<Store, StoreError> !{ database.read<Stores>, network.fetch } {
    Telemetry.record_visible(id)
    Stores.get(id)
}

fn labels(ids: List<StoreId>) -> List<Result<Store, StoreError>> !{ database.read<Stores> } {
    List.map(ids, id => Stores.get(id))
}
