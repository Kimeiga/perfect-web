// @status: NEIGHBOUR
// @invariant: wrong_frame_phase
// @dimension: valid neighbour — the same write, in the phase that owns it
module generality.phase_ok

import style
import browser.{ ElementRef }

fn widen(target: ElementRef) -> () !{ style.mutate<LayoutAffect> } {
    target.style.set_width(10.px)
}

component Row() {
    placement browser
    frame {
        mutate {
            let el = self
            widen(el)
        }
    }
}
