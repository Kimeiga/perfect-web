// @status: NEIGHBOUR
// @invariant: resume_capture_schema_unnameable
// @dimension: valid neighbour — the same shape, with a nameable type
//
// A rule reacting to "a capture that is not a bare parameter" would catch
// this. What matters is whether the type is knowable, not how it was reached:
// `held` is a rebinding and `store.id` is a field, and both have types this
// build can name.

module generality.schema_nameable

import domain.{ Store, StoreId }

// 2026-08-10: PW0021 learned to examine bare calls. A witness that calls a
// name nothing declares is invalid evidence by the corpus's own rule, so the
// callee is declared here — the witness stays self-contained and its subject
// is unchanged.
fn refresh(s: Store, id: StoreId) -> () !{} { todo }

view Panel(store: Store) !{} {
    let held = store
    <button on:press={resumable(captures = { held, store.id }) => refresh(held, store.id)}>
        Refresh
    </button>
}
