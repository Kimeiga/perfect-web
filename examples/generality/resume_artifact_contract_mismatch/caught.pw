// @status: GENERAL
// @invariant: resume_artifact_contract_mismatch
// @dimension: direct invalid — a capture declared and never read
//
// The manifest is derived from the `captures` list as written; the handler
// artifact from what the body reads. `other` appears in one and not the other,
// so the two records describe different contracts. Shipped, every resume of
// this handler would fail after deployment.

module generality.artifact_mismatch

import domain.{ Store }

// 2026-08-10: PW0021 learned to examine bare calls. A witness that calls a
// name nothing declares is invalid evidence by the corpus's own rule, so the
// callee is declared here — the witness stays self-contained and its subject
// is unchanged.
fn refresh(s: Store) -> () !{} { todo }

view Panel(store: Store, other: Store) !{} {
    <button on:press={resumable(captures = { store, other }) => refresh(store)}>
        Refresh
    </button>
}
