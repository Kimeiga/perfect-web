// @status: NEIGHBOUR
// @invariant: cache_key_omits_partition
// @dimension: valid neighbour — the partition IS in the key
//
// The same shared cache, the same dependency on the tenant, with the
// organization in the key. A rule reacting to `cache shared` plus a
// partitioned value, without looking at the key, would catch this.
//
// Until 2026-10-02 this neighbour was the current USER's value keyed by
// `user`. ADR-0128 ruled that a defect: an entry only one reader can hit gains
// nothing from a shared cache. It is `private_in_shared_cache/keyed-by-reader.pw`
// now.

module generality.key_ok

import Menus
import context
import domain.{ MenuItem, StoreId }
import domain.{ StoreError }

query Recent(store: StoreId) -> Result<List<MenuItem>, StoreError>
    cache shared
    key   store, organization
{
    Menus.for_store_in_org(store, context.current_organization())
}
