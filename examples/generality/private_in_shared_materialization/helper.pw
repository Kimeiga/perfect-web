// @status: GENERAL
// @invariant: private_in_shared_materialization
// @dimension: the private value arrives through a PUBLIC query whose body
//             reads it — the fragment's edge is public, so the graph is right
//             and the conclusion was wrong
//
// `PW5101` reads the dependency graph, and the graph has one edge per
// `depends_on` target. `Summary` is declared `public`, so the edge looked
// public. What `Summary` returns is derived from a session-scoped cart.
//
// A known gap until 2026-10-02, kept as a NARROW witness. ADR-0128 closed it
// without a fragment body: a declaration observes its own parameters, and
// `Summary(session: Session<SessionId>)` is given the session. The query
// declares no cache since, so neither its own cache nor a private one decides
// this: only what it is given. The fragment is the one thing reported.
module generality.materialize_helper

import Resources.{ Cart }
import Events.{ CartChanged }
import Carts
import capability.{ Session, SessionId }

// Public by declaration. Session-derived in fact.
public query Summary(session: Session<SessionId>) -> Int
    freshness     5.seconds
    consistency   snapshot
    key           session
    concurrency   one_per_key
    on_key_change cancel
{
    line_count(session)
}

fn line_count(session: Session<SessionId>) -> Int !{ database.read<Carts> } {
    todo
}

materialize SummaryStrip(session: Session<SessionId>) {
    placement      edge
    partition      public
    depends_on     Summary(session)
    invalidates_on CartChanged(session)
    regenerate     on_invalidation
    stampede       single_flight
    fallback       last_known_good
}
