// @status: NARROW
// @invariant: private_in_shared_materialization
// @dimension: the private value arrives through a PUBLIC query whose body
//             reads it — the fragment's edge is public, so the graph is right
//             and the conclusion is wrong
//
// This compiles clean and it should not.
//
// `PW5101` reads the dependency graph, and the graph has one edge per
// `depends_on` target. `Summary` is declared `public` and cached `shared`, so
// the edge is public and the fragment looks correct. What `Summary` actually
// returns is derived from a session-scoped cart.
//
// Seeing this needs label dataflow over the produced VALUE, which is what
// `private_in_shared_cache` already does for a page's body — over a body a
// `materialize` block does not have. That is the work, and it is E7's: a
// fragment gets a body when there is a renderer to give it one.
//
// Written as a program rather than as a sentence in a document so the gap
// cannot drift out of date. `just generality` fails the moment this stops
// compiling clean, and then the file is promoted rather than deleted.
module generality.materialize_slips_helper

import domain.{ SessionId }
import Resources.{ Cart }
import Events.{ CartChanged }

// Public by declaration. Session-derived in fact.
public query Summary(session: SessionId) -> Int
    freshness     5.seconds
    consistency   snapshot
    cache         shared
    key           session
    concurrency   one_per_key
    on_key_change cancel
{
    line_count(session)
}

fn line_count(session: SessionId) -> Int !{ database.read<Carts> } {
    todo
}

materialize SummaryStrip(session: SessionId) {
    placement      edge
    partition      public
    depends_on     Summary(session)
    invalidates_on CartChanged(session)
    regenerate     on_invalidation
    stampede       single_flight
    fallback       last_known_good
}
