// @status: GENERAL
// @invariant: private_in_shared_materialization
// @dimension: the dependency is public on one path and session-derived on the
//             other, so no single declaration is wrong and the edge is public
//
// `Personalised` returns 0 for a signed-out reader and a session-derived
// answer for a signed-in one. Its declaration says `public` about both.
//
// A known gap until 2026-10-02: this compiled clean, and was kept as a NARROW
// witness so the gap could not drift out of date. ADR-0128 closed it. A query
// is a function of its arguments, so `Personalised(session:
// Session<SessionId>)` holds the session's value whatever its keyword says,
// and the fragment depending on it is refused. The query declares no
// cache since, so neither its own cache nor a private one decides this: only
// what it is given. The fragment is the one thing reported.
module generality.materialize_branch

import Resources.{ Cart }
import Events.{ CartChanged }
import Carts
import capability.{ Session, SessionId }

public query Personalised(session: Session<SessionId>) -> Int
    freshness     5.seconds
    consistency   snapshot
    key           session
    concurrency   one_per_key
    on_key_change cancel
{
    if signed_in(session) {
        private_total(session)
    } else {
        0
    }
}

fn signed_in(session: Session<SessionId>) -> Bool !{} { todo }

fn private_total(session: Session<SessionId>) -> Int !{ database.read<Carts> } { todo }

materialize PersonalStrip(session: Session<SessionId>) {
    placement      edge
    partition      public
    depends_on     Personalised(session)
    invalidates_on CartChanged(session)
    regenerate     on_invalidation
    stampede       single_flight
    fallback       last_known_good
}
