// @status: NEIGHBOUR
// @invariant: optimistic_not_pure
// @dimension: valid neighbour — the same shape, transformed purely
//
// One character of difference in meaning: the transition computes the
// speculative cart from the one it was given, instead of going to the origin
// for it. Both are `Cart -> Cart`; only one can be abandoned by restoring the
// previous value.
module generality.optimistic_pure

import Carts
import Resources.{ Cart }
import context.{ current_session }
// The accepted corpus's `Cart` reads what this command writes, and listens
// for this event (ADR-0101).
import Events.{ CartChanged }
import domain.{ MenuItemId }
import domain.{ CartError, InteractionId }

command remove_from_cart(item: MenuItemId)
    -> Result<domain.Cart, CartError>
    requires      SignedIn
    idempotent_by InteractionId
    // The line, taken away from the cart it was given (ADR-0172). Until
    // 2026-10-03 this added a line, `Carts.with_line`, which now takes the
    // item a page showed.
    optimistic    Cart(current_session()) as cart => Carts.without(cart, item)
    invalidates   Cart(current_session())
    emits         CartChanged(current_session())
{
    Carts.clear(current_session())
}
