// @status: NEIGHBOUR
// @invariant: stale_key_policy
// @dimension: valid neighbour — the same query, with the policy declared
module generality.stale_ok

import Stores
import domain.{ Store, StoreId }
import domain.{ StoreError }

public query Store(id: StoreId) -> Result<Store, StoreError>
    freshness     10.seconds
    consistency   snapshot
    cache         shared
    concurrency   parallel
    on_key_change cancel
{
    Stores.get(id)
}
