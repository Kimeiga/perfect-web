// @status: NEIGHBOUR
// @invariant: value_exceeds_sink_level
// @dimension: valid neighbour
//
// The control for the whole matrix: every shape above, with a value that is
// not secret. A rule that reacted to rebinding, records, branches or
// interpolation rather than to the LABEL would catch this file.

module generality.sink_neighbour

import log
import Stores
import capability.{ Public }
import domain.{ StoreId }

fn audit(id: StoreId, dry_run: Bool) -> () !{ log<Public>, database.read<Stores> } {
    let store = Stores.get(id)
    let same = store
    // Each branch is a `String`, the second interpolating the store: a
    // branch of another type, `{ same }`, was a second defect, and
    // PW0613 refuses it since 2026-09-26 (ADR-0068).
    let value = if dry_run { "none" } else { "{same}" }
    log.public("loaded {value}")
}
