// @status: GENERAL
// @invariant: value_exceeds_sink_level
// @dimension: branch join
//
// Secret on one path, public on the other. Charter §7.8 makes the join a
// UNION of restrictions, so the merged value is still secret — a `max` over an
// ordering would be the wrong operation and would let this through.

module generality.sink_branch

import log
import secrets
import capability.{ Payments, Public }
import domain.{ OrderId }

fn audit(order: OrderId, dry_run: Bool) -> () !{ log<Public>, secret<Payments> } {
    let token = secrets.payments()
    // Each branch is a `String`, the second interpolating the secret: a
    // branch of another type, `{ token }`, was a second defect, and
    // PW0613 refuses it since 2026-09-26 (ADR-0068).
    let value = if dry_run { "none" } else { "{token}" }
    log.public(value)
}
