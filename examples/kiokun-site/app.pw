// @corpus: reference
// @id: KIOKUN-SITE
// @category: the owner's production target: kiokun.com, a dictionary
// @milestone: E14
//
// kiokun.com in Pleris (track `kiokun`, W6): the owner's Chinese, Japanese and
// Korean dictionary, a program the development server serves beside the
// store and the feed (docs/PARALLEL.md, "W6's inventory, answered", Q2).
//
// kiokun.com's SvelteKit app is the reference: its word page,
// `sveltekit-app/src/routes/[word]/`, and the components it renders. Each
// rule here names the file it is read from. The entry is kiokun's own file,
// read by the deployment's data layer as kiokun's build wrote it; what the
// page shows of it, and how, is decided here.

module kiokun.site

import List
import String
import shards

// **Where kiokun's entries are** (ADR-0207): its build's output, one
// raw-DEFLATE JSON file a word, which nothing here writes. Every read sees
// the one version the deployment opened; there are no transactions, since
// nothing commits; and nothing tells a change, since none is made.
source KiokunEntries
    holds        Entry, Label, CharGloss, PitchReading
    transactions none
    reads        strong
    changes      none

// ---------------------------------------------------------------------------
// The entry, as kiokun's build writes it (`src/lib/types.ts`, `DictionaryEntry`):
// the fields the word page reads, each list as the file lists it. The page's
// own shapes are below.

// One example of a Chinese sense (`definitionExamples[].examples[]`): its
// simplified and traditional text, its English and its pinyin.
type ChineseExample = ChineseExample {
    simp: String,
    trad: String,
    en: String,
    pinyin: String,
}

// A sense's examples, by the sense's text (`definitionExamples[]`).
type DefinitionExamples = DefinitionExamples {
    definition: String,
    examples: List<ChineseExample>,
}

// One reading of a Chinese word: its pinyin and Jyutping, its senses, and
// their examples.
type ChineseItem = ChineseItem {
    pinyin: String,
    jyutping: String,
    definitions: List<String>,
    examples: List<DefinitionExamples>,
}

// One Chinese word: CC-CEDICT's line `id`, its forms, its readings.
type ChineseWord = ChineseWord {
    id: String,
    simp: String,
    trad: String,
    items: List<ChineseItem>,
}

// A written form or a reading of a Japanese word, JMdict's `kanji` or `kana`.
type Headword = Headword {
    text: String,
    tags: List<String>,
    common: Bool,
}

// One gloss of a sense, and its type (`lit`, `fig`, `expl`), or "" for none.
type Gloss = Gloss {
    text: String,
    kind: String,
    lang: String,
}

// One of KANJIDIC's meanings: its language ("" for English, as KANJIDIC
// writes it) and its text.
type CharMeaning = CharMeaning {
    lang: String,
    value: String,
}

// One sentence of a Japanese example, Tatoeba's: its language, as the file
// spells it (`lang`, or `land` in some records), and its text.
type Sentence = Sentence {
    lang: String,
    land: String,
    text: String,
}

// One example of a Japanese sense: its sentences in each language.
type SenseExample = SenseExample {
    sentences: List<Sentence>,
}

// One sense of a Japanese word: its glosses, notes, labels and examples.
type Sense = Sense {
    glosses: List<Gloss>,
    info: List<String>,
    pos: List<String>,
    field: List<String>,
    misc: List<String>,
    dialect: List<String>,
    examples: List<SenseExample>,
}

// One Japanese word: JMdict's sequence number `id`, its forms and senses.
type JapaneseWord = JapaneseWord {
    id: String,
    kanji: List<Headword>,
    kana: List<Headword>,
    senses: List<Sense>,
}

// One example of a Korean word or sense: its Korean and its translation.
type KoreanExample = KoreanExample {
    korean: String,
    translation: String,
}

// One sense of a Korean word: its text and its examples.
type KoreanSense = KoreanSense {
    text: String,
    examples: List<KoreanExample>,
}

// One Korean word: hangul, hanja where it has one, a part of speech, its
// definitions' texts, its senses with their examples, and its own examples.
type KoreanWord = KoreanWord {
    id: String,
    hangul: String,
    hanja: String,
    pos: String,
    definitions: List<String>,
    senses: List<KoreanSense>,
    examples: List<KoreanExample>,
}

// One translation of a Japanese name: its kinds and texts.
type NameTranslation = NameTranslation {
    kinds: List<String>,
    texts: List<String>,
}

// One Japanese name, from JMnedict.
type JapaneseName = JapaneseName {
    id: String,
    kanji: List<String>,
    kana: List<String>,
    translations: List<NameTranslation>,
}

// The character an entry is, as Chinese sources give it (`chinese_char`):
// the character itself, its simplified, traditional and Hong Kong forms, its
// learner gloss, its Mandarin readings by frequency, its readings in older
// sources, its Cantonese readings, and its HSK level where it has one.
type ChineseChar = ChineseChar {
    character: String,
    simplified: List<String>,
    traditional: List<String>,
    hong_kong: String,
    gloss: String,
    frequencies: List<String>,
    old: List<String>,
    cantonese: List<String>,
    hsk: Option<Int>,
}

// One of KANJIDIC's readings: its type (`ja_on`, `ja_kun`, `pinyin`..) and
// its value.
type KanjiReading = KanjiReading {
    kind: String,
    value: String,
}

type ReadingGroup = ReadingGroup {
    readings: List<KanjiReading>,
}

// The character as KANJIDIC gives it (`japanese_char`): its former JLPT
// level, and its readings, in groups where the file has `groups` and in the
// older flat list where it does not.
type JapaneseChar = JapaneseChar {
    literal: String,
    jlpt: Option<Int>,
    grouped: Bool,
    groups: List<ReadingGroup>,
    readings: List<KanjiReading>,
    meanings: List<CharMeaning>,
}

// The character as the hanja table gives it (`korean_char`): the
// character, its hanja form, and its hangul readings.
type KoreanChar = KoreanChar {
    character: String,
    hanja: String,
    readings: List<String>,
    meanings_en: List<String>,
}

// A mnemonic card (`semantic_mnemonic`, `semantic_mnemonic_variants`): the
// character it teaches, the keyword it is remembered by, its meaning, and
// its dictionary meanings.
type Card = Card {
    character: String,
    keyword: String,
    meaning: String,
    lexical: String,
}

// An entry. A stub carries only `key` and `redirect`, the entry it names.
// A word kiokun's builder previews in another's entry (`WordPreview`,
// kiokun-data `src/word_preview_types.rs`): its written form, pinyin,
// Jyutping, Japanese reading and on'yomi, Korean reading, first definition,
// whether JMdict calls it common, and its frequency rank.
type Preview = Preview {
    w: String,
    p: String,
    ct: String,
    jp: String,
    jo: String,
    kr: String,
    d: String,
    c: Bool,
    fr: Option<Int>,
}

type Entry = Entry {
    key: String,
    redirect: Option<String>,
    chinese: List<ChineseWord>,
    japanese: List<JapaneseWord>,
    korean: List<KoreanWord>,
    names: List<JapaneseName>,
    chinese_char: Option<ChineseChar>,
    japanese_char: Option<JapaneseChar>,
    korean_char: Option<KoreanChar>,
    mnemonic: Option<Card>,
    variants: List<Card>,
    simplified_form_of: String,
    contains: List<Preview>,
    in_chinese: List<Preview>,
    in_japanese: List<Preview>,
    in_korean: List<Preview>,
}

// One of kiokun.com's labels for JMdict's codes
// (`sveltekit-app/src/lib/japanese-labels.json`): its kind (`pos`, `misc`,
// `field`, `dial`, `head_info`), its code, and its text.
type Label = Label {
    kind: String,
    code: String,
    text: String,
}

// `Moved` is a word whose page is another's: kiokun.com answers 308 to the
// one traditional form a simplified character equals in meaning
// (`[word]/+page.ts:419-425`). The page answers it once the integrator's
// page redirect lands; until then the query does not return it.
type KiokunError =
    | NotFound
    | Moved(String)

// Where a word's file is: its subdirectory and its escaped name.
type Place = Place {
    subdirectory: String,
    file: String,
}

// One reading of a word in kiokun.com's pitch data (`static/pitch/<shard>.json`,
// read through `KIOKUN_APP`): the reading, and its accent, the mora after
// which the pitch falls (0 for none), where the data gives one.
type PitchReading = PitchReading {
    reading: String,
    accent: Option<Int>,
}

// One character's gloss from kiokun.com's component glosses
// (`static/game_data/component_glosses.json`, read through `KIOKUN_APP`).
type CharGloss = CharGloss {
    character: String,
    gloss: String,
}

// The file `subdirectory/file.json.deflate`, as the data layer reads it, or
// none where there is no such file. The layer refuses a name that is not one
// path segment.
fn read_entry(subdirectory: String, file: String) -> Option<Entry> !{ database.read<Entry> }
    host "kiokun:data/entries#read"

// kiokun.com's labels for JMdict's codes, as its app keeps them (read through
// `KIOKUN_APP`), or none where the deployment names no app: a code is then
// shown as it is, as kiokun.com shows a code its table lacks.
fn read_labels() -> List<Label> !{ database.read<Label> }
    host "kiokun:data/labels#japanese"

// The files at `places`, each read as `read_entry` reads one, in order.
fn read_entries(places: List<Place>) -> List<Option<Entry>> !{ database.read<Entry> }
    host "kiokun:data/entries#read-all"

// A word's readings in pitch shard `shard`, in the data's order, or none.
fn read_pitch(shard: String, word: String) -> List<PitchReading> !{ database.read<PitchReading> }
    host "kiokun:data/pitch#of"

// The glosses kiokun.com's component table has for `characters`, or none
// where the deployment names no app.
fn read_glosses(characters: List<String>) -> List<CharGloss> !{ database.read<CharGloss> }
    host "kiokun:data/support#glosses"

// ---------------------------------------------------------------------------
// Finding a word's file.

// kiokun's `create_safe_filename` (kiokun-data `src/main.rs`): each of
// `/ \ : * ? " < > |` and each control character (Unicode's Cc: U+0000 to
// U+001F and U+007F to U+009F) is written `_`.
fn escaped(c: Int) -> Int {
    let unsafe_mark = c == 47 | c == 92 | c == 58 | c == 42 | c == 63 | c == 34 | c == 60 | c == 62 | c == 124
    let control = c <= 31 | (c >= 127 & c <= 159)
    if unsafe_mark | control { 95 } else { c }
}

fn file_name(word: String) -> String {
    String.from_codepoints(List.map(String.codepoints(word), escaped))
}

// The entry a file holds, where it records `word`: a file whose escaped
// name several words share answers only for the word it records
// (ADR-0041).
fn recorded(file: Option<Entry>, word: String) -> Option<Entry> {
    match file {
        Some(e) => if e.key == word { Some(e) } else { None },
        None => None,
    }
}

// ---------------------------------------------------------------------------
// What the page shows. Each list a page keys is keyed by the source's id,
// or by its place in the source's list where the source gives none.

type Numbered = Numbered {
    id: String,
    text: String,
}

// A list's strings, each keyed `<prefix>:<n>` by its place.
fn numbered(items: List<String>, prefix: String) -> List<Numbered> {
    let none: List<Numbered> = []
    List.fold(items, none, (out, t) => List.concat(out, [Numbered { id: "{prefix}:{List.length(out)}", text: t }]))
}

// One example as the page shows it: its text and its translation.
type Example = Example {
    text: String,
    translation: String,
}

type ShownExample = ShownExample {
    id: String,
    text: String,
    translation: String,
}

// A sense's examples as `SenseExampleList.svelte` shows them: those with a
// text, labelled `Example` or `Examples`; the first shown, and the rest
// behind a disclosure that says how many.
type ShownExamples = ShownExamples {
    lang: String,
    label: String,
    first: List<ShownExample>,
    rest: List<ShownExample>,
    more: String,
}

fn examples_shown(items: List<Example>, prefix: String, lang: String) -> ShownExamples {
    let usable = List.filter(items, e => e.text != "")
    let none: List<ShownExample> = []
    let all = List.fold(usable, none, (out, e) => List.concat(out, [ShownExample { id: "{prefix}:x{List.length(out)}", text: e.text, translation: e.translation }]))
    ShownExamples {
        lang: lang,
        label: if List.length(all) == 1 { "Example" } else { "Examples" },
        first: List.take(all, 1),
        rest: List.drop(all, 1),
        more: "Show {List.length(all) - 1} more examples for this definition",
    }
}

// One sense as the page shows it, with its examples.
type ShownDefinition = ShownDefinition {
    id: String,
    text: String,
    examples: ShownExamples,
}

// A Chinese sense's examples (`+page.svelte`'s `matchedExamples`): the first
// record for the sense's text, each example's text its simplified, else
// traditional, form.
fn chinese_examples(item: ChineseItem, definition: String) -> List<Example> {
    let none: List<Example> = []
    match List.find(item.examples, r => r.definition == definition) {
        Some(r) => List.map(r.examples, e => Example { text: if e.simp != "" { e.simp } else { e.trad }, translation: e.en }),
        None => none,
    }
}

fn chinese_definitions(item: ChineseItem, prefix: String) -> List<ShownDefinition> {
    let none: List<ShownDefinition> = []
    List.fold(item.definitions, none, (out, d) => List.concat(out, [ShownDefinition {
        id: "{prefix}:{List.length(out)}",
        text: d,
        examples: examples_shown(chinese_examples(item, d), "{prefix}:{List.length(out)}", "zh"),
    }]))
}

// One reading of a Chinese word as the page shows it: the word's forms,
// `simp / trad` where they differ, its pinyin and Jyutping, and its senses.
type ShownChinese = ShownChinese {
    id: String,
    simp: String,
    trad: String,
    both: Bool,
    pinyin: String,
    jyutping: String,
    definitions: List<ShownDefinition>,
}

// A word's readings that have senses (`+page.svelte:711-716`), each keyed
// `<id>:<n>` by its place among the word's items. Where its forms are one,
// it is shown as `trad || simp || word` (`+page.svelte`'s Chinese headword).
fn chinese_shown(w: ChineseWord, word: String) -> List<ShownChinese> {
    let none: List<ShownChinese> = []
    let all = List.fold(w.items, none, (out, item) => List.concat(out, [ShownChinese {
        id: "{w.id}:{List.length(out)}",
        simp: w.simp,
        trad: if w.trad != "" { w.trad } else { if w.simp != "" { w.simp } else { word } },
        both: w.simp != "" & w.trad != "" & w.simp != w.trad,
        pinyin: item.pinyin,
        jyutping: item.jyutping,
        definitions: chinese_definitions(item, "{w.id}:{List.length(out)}"),
    }]))
    List.filter(all, s => List.length(s.definitions) > 0)
}

// A written form or reading as the page shows it: its text, its notes
// (`HeadwordInfo.svelte`) and whether it is common, and whether a
// separator `、` goes before it.
type ShownHeadword = ShownHeadword {
    id: String,
    text: String,
    tags: List<Numbered>,
    common: Bool,
    first: Bool,
}

// The label a table of `kind` gives `code`, or none.
fn labelled(labels: List<Label>, kind: String, code: String) -> Option<String> {
    match List.find(labels, l => l.kind == kind & l.code == code) {
        Some(l) => if l.text == "" { None } else { Some(l.text) },
        None => None,
    }
}

// JMdict's `-` read as `_`: kiokun.com's table writes `adj_na` for the
// entries' `adj-na`.
fn underscored(code: String) -> String {
    String.from_codepoints(List.map(String.codepoints(code), c => if c == 45 { 95 } else { c }))
}

// A code's label of `kind` (`japaneseLabels.ts`): the table's label for the
// code as written, else for the code with each `-` read as `_`, else the
// code itself. kiokun.com looks up the code as written alone, and so shows
// `adj-na` where its table means `na adj.`; the integrator's ruling of
// 2026-10-09 shows the label the table means (the word page ADR's
// Differences).
fn label(labels: List<Label>, kind: String, code: String) -> String {
    match labelled(labels, kind, code) {
        Some(text) => text,
        None => match labelled(labels, kind, underscored(code)) {
            Some(text) => text,
            None => code,
        },
    }
}

// A form's note (`getHeadInfoLabel`): JMdict's short code read as the
// table's own name for it, the search-only codes as irregular ones.
fn head_info(labels: List<Label>, tag: String) -> String {
    let named = match tag {
        "iK" => "ikanji",
        "ik" => "ikana",
        "io" => "io",
        "oK" => "okanji",
        "ok" => "okana",
        "rK" => "rkanji",
        "rk" => "rkana",
        "sK" => "ikanji",
        "sk" => "ikana",
        other => other,
    }
    match List.find(labels, l => l.kind == "head_info" & l.code == named) {
        Some(l) => if l.text == "" { tag } else { l.text },
        None => tag,
    }
}

// The forms the page shows, in the dictionary's order, without the forms
// JMdict marks search-only (`sK`, `sk`; `WordEntry.svelte:19-23`), each note
// labelled (`HeadwordInfo.svelte`).
fn headwords(items: List<Headword>, hidden: String, prefix: String, labels: List<Label>) -> List<ShownHeadword> {
    let shown = List.filter(items, h => !List.any(h.tags, t => t == hidden))
    let none: List<ShownHeadword> = []
    List.fold(shown, none, (out, h) => List.concat(out, [ShownHeadword {
        id: "{prefix}:{List.length(out)}",
        text: h.text,
        tags: numbered(List.map(h.tags, t => head_info(labels, t)), "{prefix}:{List.length(out)}"),
        common: h.common,
        first: List.length(out) == 0,
    }]))
}

// One sense as the page shows it (`Sense.svelte`): its glosses joined by
// "; ", each with its type where it has one; its notes; its labels.
type ShownSense = ShownSense {
    id: String,
    glosses: List<ShownGloss>,
    info: String,
    labels: List<Numbered>,
    examples: ShownExamples,
}

// `japaneseExamplesForSense` (`src/lib/japanese-examples.ts`): each example
// whose Japanese sentence has a text, with its English where it has one; a
// sentence's language is its `land` or its `lang`.
fn japanese_examples(s: Sense) -> List<Example> {
    let none: List<Example> = []
    List.fold(s.examples, none, (out, e) => match List.find(e.sentences, t => t.land == "jpn" | t.lang == "jpn") {
        Some(j) => if j.text == "" { out } else {
            List.concat(out, [Example {
                text: j.text,
                translation: match List.find(e.sentences, t => t.land == "eng" | t.lang == "eng") {
                    Some(en) => en.text,
                    None => "",
                },
            }])
        },
        None => out,
    })
}

type ShownGloss = ShownGloss {
    id: String,
    text: String,
    kind: String,
    first: Bool,
}

fn glosses_shown(gs: List<Gloss>, prefix: String) -> List<ShownGloss> {
    let none: List<ShownGloss> = []
    List.fold(gs, none, (out, g) => List.concat(out, [ShownGloss {
        id: "{prefix}:{List.length(out)}",
        text: g.text,
        kind: if g.kind == "none" { "" } else { g.kind },
        first: List.length(out) == 0,
    }]))
}

// Part of speech, field, misc and dialect, in that order, each labelled from
// its own table (`Sense.svelte:47-62`).
fn sense_labels(s: Sense, labels: List<Label>) -> List<String> {
    let pos = List.map(s.pos, c => label(labels, "pos", c))
    let field = List.map(s.field, c => label(labels, "field", c))
    let misc = List.map(s.misc, c => label(labels, "misc", c))
    let dialect = List.map(s.dialect, c => label(labels, "dial", c))
    List.concat(List.concat(pos, field), List.concat(misc, dialect))
}

fn senses_shown(ss: List<Sense>, prefix: String, labels: List<Label>) -> List<ShownSense> {
    let none: List<ShownSense> = []
    List.fold(ss, none, (out, s) => List.concat(out, [ShownSense {
        id: "{prefix}:{List.length(out)}",
        glosses: glosses_shown(s.glosses, "{prefix}:{List.length(out)}:g"),
        info: String.join(s.info, "; "),
        labels: numbered(sense_labels(s, labels), "{prefix}:{List.length(out)}:l"),
        examples: examples_shown(japanese_examples(s), "{prefix}:{List.length(out)}", "ja"),
    }]))
}

// One Japanese word as the page shows it (`WordEntry.svelte`): its written
// forms, or its readings where it has none; its first reading; its senses,
// numbered where there is more than one (`Definitions.svelte`).
type ShownJapanese = ShownJapanese {
    id: String,
    kanji: List<ShownHeadword>,
    kana: List<ShownHeadword>,
    reading: String,
    pitch: Pitch,
    senses: List<ShownSense>,
    many: Bool,
}

fn japanese_shown(w: JapaneseWord, labels: List<Label>, pitch: List<PitchReading>) -> ShownJapanese {
    let kanji = headwords(w.kanji, "sK", "{w.id}:k", labels)
    let kana = headwords(w.kana, "sk", "{w.id}:r", labels)
    let reading = match List.get(kana, 0) {
        Some(r) => r.text,
        None => "",
    }
    ShownJapanese {
        id: w.id,
        kanji: kanji,
        kana: if List.length(kanji) == 0 { kana } else { [] },
        reading: reading,
        pitch: pitch_shown(pitch, speak_of(w), reading, w.id),
        senses: senses_shown(w.senses, "{w.id}:s", labels),
        many: List.length(w.senses) > 1,
    }
}

// One Korean word as the page shows it (`+page.svelte:805-861`): its
// definitions without kiokun's placeholder text "Sentence".
type ShownKorean = ShownKorean {
    id: String,
    hangul: String,
    hanja: String,
    pos: String,
    definitions: List<ShownDefinition>,
    many: Bool,
    examples: ShownExamples,
}

fn korean_examples(items: List<KoreanExample>) -> List<Example> {
    List.map(items, e => Example { text: e.korean, translation: e.translation })
}

fn korean_shown(w: KoreanWord) -> ShownKorean {
    let kept = List.filter(w.senses, s => s.text != "" & s.text != "Sentence")
    let none: List<ShownDefinition> = []
    ShownKorean {
        id: w.id,
        hangul: w.hangul,
        hanja: w.hanja,
        pos: w.pos,
        definitions: List.fold(kept, none, (out, s) => List.concat(out, [ShownDefinition {
            id: "{w.id}:{List.length(out)}",
            text: s.text,
            examples: examples_shown(korean_examples(s.examples), "{w.id}:{List.length(out)}", "ko"),
        }])),
        many: List.length(kept) > 1,
        examples: examples_shown(korean_examples(w.examples), "{w.id}:w", "ko"),
    }
}

// One Japanese name as the page shows it (`JapaneseNames.svelte`): its
// forms joined by `、`, and each translation's texts joined by ", " with
// its kinds labelled.
type ShownName = ShownName {
    id: String,
    kanji: String,
    kana: String,
    translations: List<ShownTranslation>,
}

type ShownTranslation = ShownTranslation {
    id: String,
    text: String,
    kinds: List<Numbered>,
}

// `JapaneseNames.svelte`'s `typeLabels`; another kind is shown as it is.
fn name_kind(kind: String) -> String {
    match kind {
        "surname" => "surname",
        "fem" => "female given name",
        "masc" => "male given name",
        "given" => "given name",
        "place" => "place name",
        "unclass" => "unclassified name",
        "company" => "company name",
        "product" => "product name",
        "work" => "work of art",
        "person" => "full name of a particular person",
        "station" => "railway station",
        other => other,
    }
}

fn name_shown(n: JapaneseName) -> ShownName {
    let none: List<ShownTranslation> = []
    ShownName {
        id: n.id,
        kanji: String.join(n.kanji, "、"),
        kana: String.join(n.kana, "、"),
        translations: List.fold(n.translations, none, (out, t) => List.concat(out, [ShownTranslation {
            id: "{n.id}:{List.length(out)}",
            text: String.join(t.texts, ", "),
            kinds: numbered(List.map(t.kinds, name_kind), "{n.id}:{List.length(out)}"),
        }])),
    }
}

// ---------------------------------------------------------------------------
// The character header (`[word]/+page.svelte:572-690`), shown where the entry
// has a Chinese or a Japanese character.

// The first index at or after `i` where `needle` begins in `hay`.
fn found_at(hay: String, needle: String, i: Int) -> Option<Int> {
    if i + String.length(needle) > String.length(hay) {
        None
    } else {
        if String.slice(hay, i, i + String.length(needle)) == needle { Some(i) } else { found_at(hay, needle, i + 1) }
    }
}

// `text` without each `marker` and the space before it, matched ignoring
// ASCII case, as `/\s*\(trad\)/gi` removes it.
fn without(text: String, marker: String) -> String {
    match found_at(String.to_lower_ascii(text), marker, 0) {
        Some(at) => without("{String.trim(String.slice(text, 0, at))}{String.slice(text, at + String.length(marker), String.length(text))}", marker),
        None => text,
    }
}

// `normalizeLearnerGloss` (`src/lib/character-forms.ts:105-112`): the
// source markers `(trad/jp)`, `(trad)`, `(simp)` and `(jp)` removed, in that
// order, and the rest trimmed.
fn learner(gloss: String) -> String {
    String.trim(without(without(without(without(gloss, "(trad/jp)"), "(trad)"), "(simp)"), "(jp)"))
}

// `learnerGlossForEntry` (`character-forms.ts:139-146`): the mnemonic's
// keyword, else its meaning, else the character's gloss, the first that is
// not empty.
fn learner_gloss(e: Entry) -> String {
    let keyword = match e.mnemonic {
        Some(m) => m.keyword,
        None => "",
    }
    let meaning = match e.mnemonic {
        Some(m) => m.meaning,
        None => "",
    }
    let gloss = match e.chinese_char {
        Some(c) => c.gloss,
        None => "",
    }
    learner(if keyword != "" { keyword } else { if meaning != "" { meaning } else { gloss } })
}

// The values, each once, in their order, without the empty ones
// (`uniqueReadings`).
fn distinct(values: List<String>) -> List<String> {
    let none: List<String> = []
    List.fold(values, none, (out, v) => if v == "" | List.any(out, s => s == v) { out } else { List.concat(out, [v]) })
}

// Every reading of the entry's Chinese words, as the file lists them.
fn word_pinyins(e: Entry) -> List<String> {
    let none: List<String> = []
    List.fold(e.chinese, none, (out, w) => List.concat(out, List.map(List.filter(w.items, i => i.pinyin != ""), i => i.pinyin)))
}

// The Mandarin readings the header shows (`buildHeaderReadings`): the
// character's by frequency that its words read, or all of them where its
// words read none of them; else its readings in older sources; else its
// words' readings.
fn mandarin(e: Entry) -> List<String> {
    let words = word_pinyins(e)
    let none: List<String> = []
    let frequencies = match e.chinese_char {
        Some(c) => c.frequencies,
        None => none,
    }
    let old = match e.chinese_char {
        Some(c) => c.old,
        None => none,
    }
    let read = List.filter(frequencies, p => List.any(words, w => w == p))
    let shown = if List.length(read) > 0 { read } else { frequencies }
    if List.length(shown) > 0 { shown } else { if List.length(old) > 0 { old } else { words } }
}

// KANJIDIC's readings: its groups' where the file has groups, else its flat
// list (`readingMeaning?.groups?.flatMap(..) || readingMeaning?.readings`).
fn kanji_readings(e: Entry) -> List<KanjiReading> {
    let none: List<KanjiReading> = []
    match e.japanese_char {
        Some(j) => if j.grouped { List.fold(j.groups, none, (out, g) => List.concat(out, g.readings)) } else { j.readings },
        None => none,
    }
}

fn of_kind(readings: List<KanjiReading>, kind: String) -> List<String> {
    List.map(List.filter(readings, r => r.kind == kind), r => r.value)
}

// One reading of the header: its label, its values joined, the class and
// the language its values are written in, and whether a `·` goes before it.
type HeaderReading = HeaderReading {
    id: String,
    label: String,
    value: String,
    class_name: String,
    lang: String,
    first: Bool,
}

type ReadingRow = ReadingRow {
    label: String,
    values: List<String>,
    class_name: String,
    lang: String,
    separator: String,
}

// Mandarin, Cantonese, on'yomi, kun'yomi and Korean, each where it has a
// reading (`buildHeaderReadings`, `[word]/+page.svelte:244-332`).
fn header_readings(e: Entry) -> List<HeaderReading> {
    let none: List<String> = []
    let kanji = kanji_readings(e)
    let rows = [
        ReadingRow { label: "Mandarin", values: distinct(mandarin(e)), class_name: "text-pinyin", lang: "zh-Latn", separator: ", " },
        ReadingRow {
            label: "Cantonese",
            values: distinct(match e.chinese_char {
                Some(c) => c.cantonese,
                None => none,
            }),
            class_name: "text-cantonese",
            lang: "yue-Latn",
            separator: ", ",
        },
        ReadingRow { label: "Japanese on’yomi", values: distinct(of_kind(kanji, "ja_on")), class_name: "text-onyomi", lang: "ja", separator: "、" },
        ReadingRow { label: "Japanese kun’yomi", values: distinct(of_kind(kanji, "ja_kun")), class_name: "text-kunyomi", lang: "ja", separator: "、" },
        ReadingRow {
            label: "Korean",
            values: distinct(match e.korean_char {
                Some(k) => k.readings,
                None => none,
            }),
            class_name: "text-korean",
            lang: "ko",
            separator: ", ",
        },
    ]
    let present = List.filter(rows, r => List.length(r.values) > 0)
    let shown: List<HeaderReading> = []
    List.fold(present, shown, (out, r) => List.concat(out, [HeaderReading {
        id: r.label,
        label: r.label,
        value: String.join(r.values, r.separator),
        class_name: "character-reading-value font-cjk {r.class_name}",
        lang: r.lang,
        first: List.length(out) == 0,
    }]))
}

// The header as the page shows it: the learner gloss with the HSK level and
// the former JLPT level beside it; the mnemonic's dictionary meanings where
// it is remembered by a keyword; the readings.
type Header = Header {
    shown: Bool,
    forms: List<ShownForm>,
    gloss: String,
    hsk: String,
    jlpt: String,
    lexical: String,
    readings: List<HeaderReading>,
}

fn header(e: Entry, forms: List<Form>) -> Header {
    let hsk = match e.chinese_char {
        Some(c) => match c.hsk {
            Some(n) => if n != 0 { "HSK {n}" } else { "" },
            None => "",
        },
        None => "",
    }
    let jlpt = match e.japanese_char {
        Some(j) => match j.jlpt {
            Some(n) => if n != 0 { "N{n}" } else { "" },
            None => "",
        },
        None => "",
    }
    let lexical = match e.mnemonic {
        Some(m) => if m.keyword != "" & m.lexical != "" { m.lexical } else { "" },
        None => "",
    }
    let has_chinese = match e.chinese_char {
        Some(_) => true,
        None => false,
    }
    let has_japanese = match e.japanese_char {
        Some(_) => true,
        None => false,
    }
    Header {
        shown: has_chinese | has_japanese,
        forms: forms_shown(forms, learner_gloss(e)),
        gloss: learner_gloss(e),
        hsk: hsk,
        jlpt: jlpt,
        lexical: lexical,
        readings: header_readings(e),
    }
}

// ---------------------------------------------------------------------------
// The loader (`[word]/+page.ts`): a stub's mnemonic kept, every traditional
// variant's Chinese words, and the related forms, read and merged.

// Unicode's `Script=Han`, as `/^\p{Script=Han}$/u` tests it in a browser
// (`character-forms.ts:90-96`): the ranges Node 22's regular expressions
// give (Unicode 16.0, ICU 77.1), in decimal.
fn is_han_script(c: Int) -> Bool {
    (c >= 11904 & c <= 11929) | (c >= 11931 & c <= 12019) | (c >= 12032 & c <= 12245) | c == 12293 | c == 12295 | (c >= 12321 & c <= 12329) | (c >= 12344 & c <= 12347) | (c >= 13312 & c <= 19903) | (c >= 19968 & c <= 40959) | (c >= 63744 & c <= 64109) | (c >= 64112 & c <= 64217) | (c >= 94178 & c <= 94179) | (c >= 94192 & c <= 94193) | (c >= 131072 & c <= 173791) | (c >= 173824 & c <= 177977) | (c >= 177984 & c <= 178205) | (c >= 178208 & c <= 183969) | (c >= 183984 & c <= 191456) | (c >= 191472 & c <= 192093) | (c >= 194560 & c <= 195101) | (c >= 196608 & c <= 201546) | (c >= 201552 & c <= 205743)
}

// One Han character (`isHanCharacterForm`).
fn is_han_form(text: String) -> Bool {
    let points = String.codepoints(text)
    List.length(points) == 1 & List.all(points, is_han_script)
}

fn one_character(text: String) -> Bool {
    List.length(String.codepoints(text)) == 1
}

// Runs of white space as one space (`/\s+/g`, ' '): each code point Unicode
// calls White_Space, as `String.trim` reads it.
fn spaced(text: String) -> String {
    let none: List<Int> = []
    let points = List.fold(String.codepoints(text), none, (out, c) => if String.trim(String.from_codepoints([c])) == "" {
        match List.get(out, List.length(out) - 1) {
            Some(last) => if last == 32 { out } else { List.concat(out, [32]) },
            None => [32],
        }
    } else {
        List.concat(out, [c])
    })
    String.from_codepoints(points)
}

// `normalizedConcept` (`character-forms.ts:114-119`): the learner gloss,
// lower-cased, its spaces collapsed. Its NFKC step is not taken: Pleris has
// no Unicode normalization (the ADR's Not claimed).
fn concept(gloss: String) -> String {
    spaced(String.to_lower(learner(gloss)))
}

// `mnemonicCardsForEntry` (`character-forms.ts:121-132`): the card, then its
// variants, each character once, none without a character.
fn cards_of(e: Entry) -> List<Card> {
    let none: List<Card> = []
    let all = match e.mnemonic {
        Some(m) => List.concat([m], e.variants),
        None => e.variants,
    }
    List.fold(all, none, (out, c) => if c.character == "" | List.any(out, s => s.character == c.character) { out } else { List.concat(out, [c]) })
}

fn meaning_of(cards: List<Card>, character: String) -> String {
    match List.find(cards, c => c.character == character) {
        Some(c) => c.meaning,
        None => "",
    }
}

fn chinese_character(e: Entry) -> String {
    match e.chinese_char {
        Some(c) => c.character,
        None => "",
    }
}

fn traditional_of(e: Entry) -> List<String> {
    let none: List<String> = []
    match e.chinese_char {
        Some(c) => c.traditional,
        None => none,
    }
}

fn simplified_of(e: Entry) -> List<String> {
    let none: List<String> = []
    match e.chinese_char {
        Some(c) => c.simplified,
        None => none,
    }
}

// `equivalentTraditionalTarget` (`character-forms.ts:154-183`): the one
// traditional form a merged simplified entry equals in meaning, where both
// are one character and their cards teach one concept; else none. 后/後 and
// 制/製 keep their own pages.
fn equivalent_target(e: Entry) -> Option<String> {
    let redirected = match e.redirect {
        Some(_) => true,
        None => false,
    }
    let source = if chinese_character(e) != "" { chinese_character(e) } else { e.key }
    let target = e.simplified_form_of
    let traditional = List.filter(traditional_of(e), v => v != "" & v != source)
    let cards = cards_of(e)
    let source_concept = concept(meaning_of(cards, source))
    let target_concept = concept(meaning_of(cards, target))
    if redirected | target == "" | !one_character(source) | !one_character(target) | source == target {
        None
    } else {
        if List.length(traditional) != 1 | !List.any(traditional, v => v == target) {
            None
        } else {
            if source_concept != "" & source_concept == target_concept { Some(target) } else { None }
        }
    }
}

// Where kiokun.com moves the word's page (`[word]/+page.ts:419-425`):
// `equivalentTraditionalTarget` of the word's own file, where that names
// another word.
fn moved_from(first: Option<Entry>, word: String) -> Option<String> {
    match first {
        Some(f) => match equivalent_target(f) {
            Some(t) => if t != word { Some(t) } else { None },
            None => None,
        },
        None => None,
    }
}

// `mergeSemanticMnemonicVariants` (`+page.ts:136-150`): the cards other than
// the primary, each character once.
fn other_cards(cards: List<Card>, primary: Option<Card>) -> List<Card> {
    let none: List<Card> = []
    let first = match primary {
        Some(p) => p.character,
        None => "",
    }
    let seeded = match primary {
        Some(p) => [p],
        None => none,
    }
    let kept = List.fold(cards, seeded, (out, c) => if List.any(out, s => s.character == c.character) { out } else { List.concat(out, [c]) })
    match primary {
        Some(_) => List.filter(kept, c => c.character != first),
        None => kept,
    }
}

fn with_card(e: Entry, card: Option<Card>, variants: List<Card>) -> Entry {
    Entry {
        key: e.key,
        redirect: e.redirect,
        chinese: e.chinese,
        japanese: e.japanese,
        korean: e.korean,
        names: e.names,
        chinese_char: e.chinese_char,
        japanese_char: e.japanese_char,
        korean_char: e.korean_char,
        mnemonic: card,
        variants: variants,
        simplified_form_of: e.simplified_form_of,
        contains: e.contains,
        in_chinese: e.in_chinese,
        in_japanese: e.in_japanese,
        in_korean: e.in_korean,
    }
}

// A stub followed to its target (`+page.ts:438-462`): the stub's card stays
// the primary, and the variants are the target's card and variants and the
// stub's, each once.
fn followed_from(target: Entry, stub: Entry) -> Entry {
    let primary = match stub.mnemonic {
        Some(m) => Some(m),
        None => target.mnemonic,
    }
    let target_cards = match target.mnemonic {
        Some(m) => List.concat([m], target.variants),
        None => target.variants,
    }
    with_card(target, primary, other_cards(List.concat(target_cards, stub.variants), primary))
}

// Records not yet in `into` by id, appended (`mergeUniqueBy`).
fn more_chinese(into: List<ChineseWord>, more: List<ChineseWord>) -> List<ChineseWord> {
    List.fold(more, into, (out, w) => if List.any(out, s => s.id == w.id) { out } else { List.concat(out, [w]) })
}

fn more_japanese(into: List<JapaneseWord>, more: List<JapaneseWord>) -> List<JapaneseWord> {
    List.fold(more, into, (out, w) => if List.any(out, s => s.id == w.id) { out } else { List.concat(out, [w]) })
}

fn more_korean(into: List<KoreanWord>, more: List<KoreanWord>) -> List<KoreanWord> {
    List.fold(more, into, (out, w) => if List.any(out, s => s.id == w.id) { out } else { List.concat(out, [w]) })
}

fn more_names(into: List<JapaneseName>, more: List<JapaneseName>) -> List<JapaneseName> {
    List.fold(more, into, (out, w) => if List.any(out, s => s.id == w.id) { out } else { List.concat(out, [w]) })
}

// Contains' previews not yet in `into` by form and readings, appended
// (`mergeUniqueBy`, `+page.ts:198-202`).
fn more_contains(into: List<Preview>, more: List<Preview>) -> List<Preview> {
    List.fold(more, into, (out, p) => if List.any(out, s => s.w == p.w & s.p == p.p & s.jp == p.jp & s.kr == p.kr) { out } else { List.concat(out, [p]) })
}

// Appears in's previews not yet in `into` by form, appended; none without a
// form (`+page.ts:203-217`).
fn more_previews(into: List<Preview>, more: List<Preview>) -> List<Preview> {
    List.fold(more, into, (out, p) => if p.w == "" | List.any(out, s => s.w == p.w) { out } else { List.concat(out, [p]) })
}

fn with_chinese(e: Entry, chinese: List<ChineseWord>) -> Entry {
    Entry {
        key: e.key,
        redirect: e.redirect,
        chinese: chinese,
        japanese: e.japanese,
        korean: e.korean,
        names: e.names,
        chinese_char: e.chinese_char,
        japanese_char: e.japanese_char,
        korean_char: e.korean_char,
        mnemonic: e.mnemonic,
        variants: e.variants,
        simplified_form_of: e.simplified_form_of,
        contains: e.contains,
        in_chinese: e.in_chinese,
        in_japanese: e.in_japanese,
        in_korean: e.in_korean,
    }
}

// `mergeEquivalentFormData` (`+page.ts:116-150`): an equivalent written
// form's words, names and cards, on the canonical page.
fn merged_form(into: Entry, related: Entry) -> Entry {
    let related_cards = match related.mnemonic {
        Some(m) => List.concat(into.variants, List.concat([m], related.variants)),
        None => List.concat(into.variants, related.variants),
    }
    Entry {
        key: into.key,
        redirect: into.redirect,
        chinese: more_chinese(into.chinese, related.chinese),
        japanese: more_japanese(into.japanese, related.japanese),
        korean: more_korean(into.korean, related.korean),
        names: more_names(into.names, related.names),
        chinese_char: into.chinese_char,
        japanese_char: into.japanese_char,
        korean_char: into.korean_char,
        mnemonic: into.mnemonic,
        variants: other_cards(related_cards, into.mnemonic),
        simplified_form_of: into.simplified_form_of,
        contains: more_contains(into.contains, related.contains),
        in_chinese: more_previews(into.in_chinese, related.in_chinese),
        in_japanese: more_previews(into.in_japanese, related.in_japanese),
        in_korean: more_previews(into.in_korean, related.in_korean),
    }
}

// Each word once, in order, without the empty ones.
fn words_once(words: List<String>) -> List<String> {
    distinct(words)
}

// The traditional variants a stub's Chinese words are read from
// (`+page.ts:464-492`): where the stub names more than one.
fn variant_words(stub: Option<Entry>) -> List<String> {
    let none: List<String> = []
    match stub {
        Some(s) => if List.length(traditional_of(s)) > 1 { traditional_of(s) } else { none },
        None => none,
    }
}

// The related forms read (`loadRelatedCharacterForms`, `+page.ts:236-280`):
// the canonical character's simplified variants, the form it is the
// simplified form of, and the stub's key, each once and not the canonical
// character, at most twelve.
fn related_words(data: Entry, stub: Option<Entry>) -> List<String> {
    let canonical = if chinese_character(data) != "" { chinese_character(data) } else { data.key }
    let stub_key = match stub {
        Some(s) => s.key,
        None => "",
    }
    let all = List.concat(List.concat(simplified_of(data), [data.simplified_form_of]), [stub_key])
    List.take(List.filter(words_once(all), w => w != canonical), 12)
}

fn place_of(word: String) -> Place {
    Place { subdirectory: shards.subdirectory(word), file: file_name(word) }
}

// The words whose files the page reads besides its own: the variants, then
// the related forms.
fn extra_words(data: Entry, stub: Option<Entry>) -> List<String> {
    List.concat(variant_words(stub), related_words(data, stub))
}

// One word asked for, and what its file held.
type Read = Read {
    word: String,
    entry: Option<Entry>,
}

// Each word beside what was read for it, in order.
fn reads_of(words: List<String>, read: List<Option<Entry>>) -> List<Read> {
    let none: List<Read> = []
    List.fold(words, none, (out, w) => List.concat(out, [Read {
        word: w,
        entry: match List.get(read, List.length(out)) {
            Some(e) => e,
            None => None,
        },
    }]))
}

// The entry `word`'s file holds, where it records `word`.
fn read_of(reads: List<Read>, word: String) -> Option<Entry> {
    match List.find(reads, r => r.word == word) {
        Some(r) => recorded(r.entry, word),
        None => None,
    }
}

// A related form's entry: the stub where it is the stub, else what was read.
fn related_entry(stub: Option<Entry>, reads: List<Read>, word: String) -> Option<Entry> {
    match stub {
        Some(s) => if s.key == word { Some(s) } else { read_of(reads, word) },
        None => read_of(reads, word),
    }
}

// The related entries, each once, none the page's own.
fn with_related(out: List<Entry>, entry: Option<Entry>, own: String) -> List<Entry> {
    match entry {
        Some(e) => if e.key == own | List.any(out, r => r.key == e.key) { out } else { List.concat(out, [e]) },
        None => out,
    }
}

// What a related form tells the header (`relatedCharacterFormContext`).
type Context = Context {
    key: String,
    simplified_form_of: String,
    character: String,
    simplified: List<String>,
    traditional: List<String>,
    hong_kong: String,
    japanese: String,
    korean: String,
    hanja: String,
}

fn context_of(e: Entry) -> Context {
    Context {
        key: e.key,
        simplified_form_of: e.simplified_form_of,
        character: chinese_character(e),
        simplified: simplified_of(e),
        traditional: traditional_of(e),
        hong_kong: match e.chinese_char {
            Some(c) => c.hong_kong,
            None => "",
        },
        japanese: match e.japanese_char {
            Some(j) => j.literal,
            None => "",
        },
        korean: match e.korean_char {
            Some(k) => k.character,
            None => "",
        },
        hanja: match e.korean_char {
            Some(k) => k.hanja,
            None => "",
        },
    }
}

// The page's entry, as the loader leaves it, the stub it came from, and the
// related forms' contexts.
type Loaded = Loaded {
    data: Entry,
    stub: Option<Entry>,
    contexts: List<Context>,
}

// The variants' Chinese words merged, then each related form: its context
// kept once, and its data merged where it is an equivalent form of the
// canonical character (`+page.ts:464-492`, `:236-280`).
fn loaded(data: Entry, stub: Option<Entry>, words: List<String>, read: List<Option<Entry>>) -> Loaded {
    let reads = reads_of(words, read)
    let variants = List.fold(variant_words(stub), data.chinese, (out, v) => match read_of(reads, v) {
        Some(e) => more_chinese(out, e.chinese),
        None => out,
    })
    let merged = with_chinese(data, variants)
    let canonical = if chinese_character(merged) != "" { chinese_character(merged) } else { merged.key }
    let none: List<Entry> = []
    let related = List.fold(related_words(data, stub), none, (out, w) => with_related(out, related_entry(stub, reads, w), merged.key))
    let final = List.fold(related, merged, (into, r) => match equivalent_target(r) {
        Some(t) => if t == canonical { merged_form(into, r) } else { into },
        None => into,
    })
    Loaded { data: final, stub: stub, contexts: List.map(related, context_of) }
}

// ---------------------------------------------------------------------------
// The header's written forms (`buildCharacterHeaderForms`,
// `character-forms.ts:205-351`).

type Roles = Roles {
    character: String,
    roles: List<String>,
}

// `role` added to `character`'s roles, the character added in order where it
// is a Han character not yet listed.
fn add_role(table: List<Roles>, character: String, role: String) -> List<Roles> {
    if !is_han_form(character) {
        table
    } else {
        if List.any(table, r => r.character == character) {
            List.map(table, r => if r.character == character & role != "" & !List.any(r.roles, x => x == role) {
                Roles { character: r.character, roles: List.concat(r.roles, [role]) }
            } else {
                r
            })
        } else {
            List.concat(table, [Roles { character: character, roles: if role == "" { [] } else { [role] } }])
        }
    }
}

fn add_roles(table: List<Roles>, characters: List<String>, role: String) -> List<Roles> {
    List.fold(characters, table, (t, c) => add_role(t, c, role))
}

// `addContext` (`character-forms.ts:217-262`).
fn add_context(table: List<Roles>, x: Context) -> List<Roles> {
    let different = List.any(x.simplified, c => c != x.character)
    let mapped = List.length(x.traditional) > 0
    let merged = x.simplified_form_of != ""
    let traditional_role = !mapped | List.any(x.traditional, c => c == x.character) | merged
    let simplified_role = !different | List.any(x.simplified, c => c == x.character) | mapped
    let t1 = if x.character != "" & traditional_role { add_role(table, x.character, "traditional") } else { table }
    let t2 = if x.character != "" & simplified_role { add_role(t1, x.character, "simplified") } else { t1 }
    let t3 = add_roles(add_roles(t2, x.traditional, "traditional"), x.simplified, "simplified")
    let t4 = if x.hong_kong != "" {
        add_role(t3, x.hong_kong, "hong-kong")
    } else {
        if x.character != "" & traditional_role { add_role(t3, x.character, "hong-kong") } else { t3 }
    }
    add_role(add_role(add_role(t4, x.japanese, "japanese"), x.korean, "korean"), x.hanja, "korean")
}

fn role_rank(role: String) -> Int {
    match role {
        "traditional" => 0,
        "hong-kong" => 1,
        "simplified" => 2,
        "japanese" => 3,
        "korean" => 4,
        _ => 5,
    }
}

fn by_role(a: String, b: String) -> Int {
    role_rank(a) - role_rank(b)
}

fn role_label(role: String) -> String {
    match role {
        "traditional" => "Traditional",
        "simplified" => "Simplified",
        "hong-kong" => "Hong Kong",
        "japanese" => "Japanese",
        "korean" => "Korean",
        other => other,
    }
}

// `ROLE_SHORT` (`[word]/+page.svelte`).
fn role_short(role: String) -> String {
    match role {
        "traditional" => "Trad",
        "simplified" => "Simp",
        "hong-kong" => "HK",
        "japanese" => "JP",
        "korean" => "KR",
        other => other,
    }
}

fn has_role(roles: List<String>, role: String) -> Bool {
    List.any(roles, r => r == role)
}

// `languageTagForRoles` (`character-forms.ts:279-287`).
fn language_tag(roles: List<String>) -> String {
    if has_role(roles, "japanese") & !has_role(roles, "traditional") & !has_role(roles, "simplified") {
        "ja"
    } else {
        if has_role(roles, "korean") & List.length(roles) == 1 {
            "ko"
        } else {
            if has_role(roles, "hong-kong") & List.length(roles) == 1 { "zh-HK" } else { if has_role(roles, "simplified") & !has_role(roles, "traditional") { "zh-Hans" } else { "zh-Hant" } }
        }
    }
}

// One written form as the header shows it.
type Form = Form {
    id: String,
    character: String,
    label: String,
    short: String,
    meaning: String,
    lang: String,
}

// The characters kiokun.com asks the component glosses for that can be a
// form (`collectSupportKeys`, `word-character-learning.ts:155-196`): the
// word's own, the entry's and the stub's forms, and the cards'.
fn support_characters(word: String, data: Entry, stub: Option<Entry>, cards: List<Card>) -> List<String> {
    let none: List<String> = []
    let glyphs = List.map(List.filter(String.codepoints(word), c => String.trim(String.from_codepoints([c])) != ""), c => String.from_codepoints([c]))
    let own = context_of(data)
    let redirect = match data.redirect {
        Some(r) => r,
        None => "",
    }
    let from_stub = match stub {
        Some(s) => List.concat(List.concat([s.key, chinese_character(s)], simplified_of(s)), traditional_of(s)),
        None => none,
    }
    let entry = List.concat(List.concat([data.key, redirect, own.character, own.hong_kong], own.simplified), List.concat(own.traditional, [own.japanese, own.korean, own.hanja]))
    distinct(List.concat(List.concat(glyphs, entry), List.concat(from_stub, List.map(cards, c => c.character))))
}

fn gloss_of(glosses: List<CharGloss>, character: String) -> String {
    match List.find(glosses, g => g.character == character) {
        Some(g) => learner(g.gloss),
        None => "",
    }
}

// `collectMnemonicCards` (`word-character-learning.ts:237-255`): the
// entry's card and variants, then the stub's, each character once.
fn header_cards(data: Entry, stub: Option<Entry>) -> List<Card> {
    let none: List<Card> = []
    let own = match data.mnemonic {
        Some(m) => List.concat([m], data.variants),
        None => data.variants,
    }
    let from_stub = match stub {
        Some(s) => match s.mnemonic {
            Some(m) => List.concat([m], s.variants),
            None => s.variants,
        },
        None => none,
    }
    List.fold(List.concat(own, from_stub), none, (out, c) => if List.any(out, s => s.character == c.character) { out } else { List.concat(out, [c]) })
}

fn forms_of(word: String, l: Loaded, glosses: List<CharGloss>) -> List<Form> {
    let cards = header_cards(l.data, l.stub)
    let none: List<Roles> = []
    let primary = add_context(none, context_of(l.data))
    let every = List.fold(l.contexts, primary, add_context)
    let listed = add_roles(add_roles(every, [chinese_character(l.data)], ""), List.map(cards, c => c.character), "")
    let table = if one_character(word) { add_role(listed, word, "") } else { listed }
    let shown: List<Form> = []
    List.fold(table, shown, (out, r) => List.concat(out, [form_of(r, primary, cards, glosses, List.length(out))]))
}

// A form's roles are the ones the page's own entry gives it, where it gives
// any, else every context's, in `ROLE_ORDER`; its meaning is its card's,
// else its component gloss (`withCharacterFormGlosses`).
fn form_of(r: Roles, primary: List<Roles>, cards: List<Card>, glosses: List<CharGloss>, n: Int) -> Form {
    let own = match List.find(primary, p => p.character == r.character) {
        Some(p) => if List.length(p.roles) > 0 { p.roles } else { r.roles },
        None => r.roles,
    }
    let roles = List.sort_by(own, by_role)
    let carded = learner(meaning_of(cards, r.character))
    Form {
        id: "form:{n}",
        character: r.character,
        label: if List.length(roles) > 0 { String.join(List.map(roles, role_label), " / ") } else { "Related form" },
        short: if List.length(roles) > 0 { String.join(List.map(roles, role_short), " · ") } else { "Form" },
        meaning: if carded != "" { carded } else { gloss_of(glosses, r.character) },
        lang: language_tag(roles),
    }
}

// A form's meaning is shown where it has one, and, where it is the only
// form, where it is not the headline's concept
// (`shouldShowCharacterFormMeaning`).
type ShownForm = ShownForm {
    id: String,
    character: String,
    label: String,
    short: String,
    meaning: String,
    lang: String,
    aria: String,
    title: String,
}

fn forms_shown(forms: List<Form>, gloss: String) -> List<ShownForm> {
    let many = List.length(forms) > 1
    List.map(forms, f => ShownForm {
        id: f.id,
        character: f.character,
        label: f.label,
        short: f.short,
        meaning: if f.meaning == "" { "" } else { if many | concept(f.meaning) != concept(gloss) { f.meaning } else { "" } },
        lang: f.lang,
        aria: "{f.character}: {f.label}",
        title: "Learner meaning for {f.character}",
    })
}

// ---------------------------------------------------------------------------
// The page's description of itself (`src/lib/seo.ts`, `buildDictionarySeo`).

// A text's length as JavaScript counts it, in UTF-16 units: a code point
// past U+FFFF is two.
fn units(text: String) -> Int {
    List.fold(String.codepoints(text), 0, (n, c) => n + if c > 65535 { 2 } else { 1 })
}

type Taken = Taken {
    points: List<Int>,
    units: Int,
    open: Bool,
}

// The longest prefix of at most `limit` UTF-16 units that splits no code
// point (`text.slice(0, limit)` splits a surrogate pair; this stops before).
fn prefix_units(text: String, limit: Int) -> String {
    let none: List<Int> = []
    let taken = List.fold(String.codepoints(text), Taken { points: none, units: 0, open: true }, (t, c) => take_unit(t, c, limit))
    String.from_codepoints(taken.points)
}

fn take_unit(t: Taken, c: Int, limit: Int) -> Taken {
    let width = if c > 65535 { 2 } else { 1 }
    if t.open & t.units + width <= limit { Taken { points: List.concat(t.points, [c]), units: t.units + width, open: true } } else { Taken { points: t.points, units: t.units, open: false } }
}

// The first place `c` is in `points` at or after `from`, or -1.
fn first_index(points: List<Int>, c: Int, from: Int) -> Int {
    match List.get(points, from) {
        Some(p) => if p == c { from } else { first_index(points, c, from + 1) },
        None => -1,
    }
}

// Each `<..>` a space (`/<[^>]*>/g`): a `<` with no `>` after it stays.
fn untagged(points: List<Int>) -> List<Int> {
    let open = first_index(points, 60, 0)
    let close = if open == -1 { -1 } else { first_index(points, 62, open) }
    if open == -1 | close == -1 {
        points
    } else {
        List.concat(List.concat(List.slice(points, 0, open), [32]), untagged(List.drop(points, close + 1)))
    }
}

// `cleanText`: tags out, white space runs one space, trimmed.
fn clean_text(value: String) -> String {
    String.trim(spaced(String.from_codepoints(untagged(String.codepoints(value)))))
}

// `truncate`: the clean text, or its first `length` less one UTF-16 units,
// trimmed at the end, and `…`.
fn truncate(value: String, length: Int) -> String {
    let text = clean_text(value)
    let kept = String.trim(prefix_units(text, if length > 1 { length - 1 } else { 0 }))
    if units(text) <= length { text } else { "{kept}…" }
}

// `unique`: each clean, none empty, each once.
fn unique_clean(values: List<String>) -> List<String> {
    distinct(List.map(values, clean_text))
}

type Split = Split {
    done: List<String>,
    current: List<Int>,
}

// The pieces between `;` and `；`.
fn pieces(text: String) -> List<String> {
    let none: List<String> = []
    let nothing: List<Int> = []
    let split = List.fold(String.codepoints(text), Split { done: none, current: nothing }, (s, c) => if c == 59 | c == 65307 {
        Split { done: List.concat(s.done, [String.from_codepoints(s.current)]), current: nothing }
    } else {
        Split { done: s.done, current: List.concat(s.current, [c]) }
    })
    List.concat(split.done, [String.from_codepoints(split.current)])
}

fn leading_digits(points: List<Int>, n: Int) -> Int {
    match List.get(points, n) {
        Some(c) => if c >= 48 & c <= 57 { leading_digits(points, n + 1) } else { n },
        None => n,
    }
}

// A piece without its leading `1.` or `2)` (`/^\d+[.)]\s*/`).
fn unnumbered(piece: String) -> String {
    let points = String.codepoints(String.trim(piece))
    let digits = leading_digits(points, 0)
    let after = match List.get(points, digits) {
        Some(c) => c == 46 | c == 41,
        None => false,
    }
    if digits > 0 & after { String.trim(String.from_codepoints(List.drop(points, digits + 1))) } else { String.trim(String.from_codepoints(points)) }
}

// `/^(?:CL|classifier)\s*:/i`.
fn classifier(piece: String) -> Bool {
    let lower = String.to_lower_ascii(piece)
    let after_classifier = String.trim(String.slice(lower, 10, String.length(lower)))
    let after_cl = String.trim(String.slice(lower, 2, String.length(lower)))
    (String.starts_with(lower, "classifier") & String.starts_with(after_classifier, ":")) | (String.starts_with(lower, "cl") & String.starts_with(after_cl, ":"))
}

// `definitionFragments`: each value cleaned and split at `;`, unnumbered,
// each once, longer than one unit and at most 96, no classifier.
fn fragments(values: List<String>) -> List<String> {
    let none: List<String> = []
    let all = List.fold(values, none, (out, v) => List.concat(out, List.map(pieces(clean_text(v)), unnumbered)))
    List.filter(unique_clean(all), v => units(v) > 1 & units(v) <= 96 & !classifier(v))
}

// `dictionaryDefinitions`: the Chinese words' senses, the Japanese words'
// English glosses, KANJIDIC's English meanings, the Korean words'
// definitions and the hanja table's English meanings.
fn definitions_of(e: Entry) -> List<String> {
    let none: List<String> = []
    let chinese = List.fold(e.chinese, none, (out, w) => List.fold(w.items, out, (o, i) => List.concat(o, i.definitions)))
    let japanese = List.fold(e.japanese, none, (out, w) => List.fold(w.senses, out, (o, s) => List.concat(o, List.map(List.filter(s.glosses, g => g.lang == "" | g.lang == "eng"), g => g.text))))
    let kanji = match e.japanese_char {
        Some(j) => List.map(List.filter(j.meanings, m => m.lang == "" | m.lang == "en"), m => m.value),
        None => none,
    }
    let korean = List.fold(e.korean, none, (out, w) => List.concat(out, w.definitions))
    let hanja = match e.korean_char {
        Some(k) => k.meanings_en,
        None => none,
    }
    fragments(List.concat(List.concat(List.concat(chinese, japanese), List.concat(kanji, korean)), hanja))
}

// `dictionaryForms`: the word and the character's forms, at most six.
fn seo_forms(word: String, e: Entry) -> List<String> {
    let own = context_of(e)
    List.take(unique_clean(List.concat(List.concat([word, own.character, own.hong_kong], own.simplified), List.concat(own.traditional, [own.japanese, own.korean]))), 6)
}

// What the page says of itself in its head.
type Seo = Seo {
    title: String,
    description: String,
}

// `buildDictionarySeo` (`seo.ts:163-198`): the word and up to three other
// forms, its learner gloss and first definitions; truncated as kiokun.com
// truncates them.
fn seo_of(word: String, e: Entry) -> Seo {
    let forms = seo_forms(word, e)
    let character = List.length(String.codepoints(word)) == 1
    let gloss = learner_gloss(e)
    let shown = List.take(unique_clean(List.concat([gloss], definitions_of(e))), 5)
    let suffix = String.join(List.take(List.filter(forms, f => f != word), 3), "・")
    let subject = if suffix != "" { "{word} ({suffix})" } else { word }
    let meaning = String.join(List.take(shown, 3), ", ")
    let kind = if character { "Character" } else { "Word" }
    let titled = if meaning != "" { "{subject} — {meaning}" } else { subject }
    let described = if meaning != "" { "{subject} means {meaning}" } else { subject }
    Seo {
        title: truncate("{titled} | Kiokun", 68),
        description: truncate("{described}. {kind} readings, definitions, examples, and learning tools across Chinese, Japanese, and Korean.", 158),
    }
}
// ---------------------------------------------------------------------------
// Pitch accent (`src/lib/components/PitchAccent.svelte`), beside a Japanese
// word's first reading.

// The forms the page shows of a word (`WordEntry.svelte:19-23`).
fn display_forms(items: List<Headword>, hidden: String) -> List<Headword> {
    List.filter(items, h => !List.any(h.tags, t => t == hidden))
}

// The word `WordEntry.svelte` speaks and looks pitch up by: its first written
// form, else its first reading.
fn speak_of(w: JapaneseWord) -> String {
    match List.get(display_forms(w.kanji, "sK"), 0) {
        Some(k) => k.text,
        None => match List.get(display_forms(w.kana, "sk"), 0) {
            Some(k) => k.text,
            None => "",
        },
    }
}

// A code point's UTF-16 units.
fn utf16_units(c: Int) -> List<Int> {
    if c > 65535 { [55296 + (c - 65536) / 1024, 56320 + (c - 65536) % 1024] } else { [c] }
}

// The pitch shard a word is in (`PitchAccent.svelte`'s `simpleHash`): the
// hash `h * 31 + unit` over its UTF-16 units, in 32 bits, its low byte in two
// hexadecimal digits. Not the entries' shard rule, which reads code points.
fn pitch_shard(word: String) -> String {
    let h = List.fold(String.codepoints(word), 0, (h, c) => List.fold(utf16_units(c), h, (g, u) => (g * 31 + u) % 4294967296))
    let low = h % 256
    String.from_codepoints([shards.hex(low / 16), shards.hex(low % 16)])
}

// The accent shown (`PitchAccent.svelte`): the reading's where the data has
// the reading, else the first reading's; either may be none.
fn accent_of(readings: List<PitchReading>, reading: String) -> Option<Int> {
    match List.find(readings, r => r.reading == reading) {
        Some(r) => if reading != "" { r.accent } else { first_accent(readings) },
        None => first_accent(readings),
    }
}

fn first_accent(readings: List<PitchReading>) -> Option<Int> {
    match List.get(readings, 0) {
        Some(r) => r.accent,
        None => None,
    }
}

// The small kana a mora joins: ゃゅょャュョ.
fn small_kana(c: Int) -> Bool {
    c == 12419 | c == 12421 | c == 12423 | c == 12515 | c == 12517 | c == 12519
}

// `renderPattern`'s morae: each character, with the small kana after it.
fn morae_of(points: List<Int>) -> List<String> {
    let none: List<String> = []
    match List.get(points, 0) {
        Some(c) => match List.get(points, 1) {
            Some(next) => if small_kana(next) {
                List.concat([String.from_codepoints([c, next])], morae_of(List.drop(points, 2)))
            } else {
                List.concat([String.from_codepoints([c])], morae_of(List.drop(points, 1)))
            },
            None => [String.from_codepoints([c])],
        },
        None => none,
    }
}

// `countMorae`: each kana, not the small ones, `っ` and `ッ` counted.
fn mora_count(text: String) -> Int {
    List.length(List.filter(String.codepoints(text), c => !small_kana(c) & (c == 12387 | c == 12483 | (c >= 12352 & c <= 12447) | (c >= 12448 & c <= 12543))))
}

// `pitchType`: no fall 平板, after the first mora 頭高, after the last 尾高,
// elsewhere 中高.
fn pitch_type(accent: Int, count: Int) -> String {
    if accent == 0 { "平板" } else { if accent == 1 { "頭高" } else { if accent == count { "尾高" } else { "中高" } } }
}

type Mora = Mora {
    id: String,
    text: String,
    class_name: String,
}

// A word's pitch as the page shows it: each mora, high or low, and the
// pattern's name.
type Pitch = Pitch {
    shown: Bool,
    title: String,
    label: String,
    morae: List<Mora>,
}

fn pitch_shown(readings: List<PitchReading>, word: String, reading: String, prefix: String) -> Pitch {
    let none: List<Mora> = []
    let display = if reading != "" { reading } else { word }
    match accent_of(readings, reading) {
        Some(a) => Pitch {
            shown: true,
            title: "{pitch_type(a, mora_count(display))} (accent: {a})",
            label: pitch_type(a, mora_count(display)),
            morae: List.fold(morae_of(String.codepoints(display)), none, (out, m) => List.concat(out, [Mora {
                id: "{prefix}:m{List.length(out)}",
                text: m,
                class_name: if (a == 0 & List.length(out) > 0) | (a == 1 & List.length(out) == 0) | (a > 1 & List.length(out) > 0 & List.length(out) < a) { "pitch-mora high" } else { "pitch-mora" },
            }])),
        },
        None => Pitch { shown: false, title: "", label: "", morae: none },
    }
}

// Each Japanese word's readings in the pitch data, in the words' order.
type WordPitch = WordPitch {
    readings: List<PitchReading>,
}

// The entry a stub names, where the word's file is a stub.
fn target_of(first: Option<Entry>) -> Option<String> {
    match first {
        Some(f) => f.redirect,
        None => None,
    }
}

// The page's entry: a stub's target with the stub's card kept, else the
// stub where its target is not found, else the word's own entry
// (`+page.ts:438-462`).
fn data_of(first: Option<Entry>, followed: Option<Entry>) -> Option<Entry> {
    match first {
        Some(f) => match f.redirect {
            Some(_) => match followed {
                Some(t) => Some(followed_from(t, f)),
                None => Some(f),
            },
            None => Some(f),
        },
        None => None,
    }
}

// The stub the page came from, where it came from one.
fn stub_of(first: Option<Entry>) -> Option<Entry> {
    match first {
        Some(f) => match f.redirect {
            Some(_) => Some(f),
            None => None,
        },
        None => None,
    }
}

fn words_for(data: Option<Entry>, stub: Option<Entry>) -> List<String> {
    let none: List<String> = []
    match data {
        Some(d) => extra_words(d, stub),
        None => none,
    }
}

fn characters_for(word: String, page: Option<Loaded>) -> List<String> {
    let none: List<String> = []
    match page {
        Some(l) => distinct(List.concat(support_characters(word, l.data, l.stub, header_cards(l.data, l.stub)), List.map(l.data.contains, p => p.w))),
        None => none,
    }
}

// ---------------------------------------------------------------------------
// Contains and Appears in (`src/lib/Contains.svelte`, `src/lib/AppearsIn.svelte`,
// `src/lib/contains-order.ts`, `src/lib/appears-in-order.ts`).

// The characters `[...text]` gives: one string a code point.
fn characters(text: String) -> List<String> {
    List.map(String.codepoints(text), c => String.from_codepoints([c]))
}

// Where `part` first begins in `text`, or -1 (`String.indexOf`). Counted in
// code points, not UTF-16 units: each use compares two places in one text,
// and their order is the same either way.
fn index_of(text: String, part: String) -> Int {
    match found_at(text, part, 0) {
        Some(at) => at,
        None => -1,
    }
}

// `sortContainsWords` (`[word]/+page.svelte:140-150`): previews found in the
// word first, by where; the rest after, as they were. The sort is stable.
fn by_place(word: String, a: Preview, b: Preview) -> Int {
    let at_a = index_of(word, a.w)
    let at_b = index_of(word, b.w)
    if at_a == -1 & at_b == -1 { 0 } else { if at_a == -1 { 1 } else { if at_b == -1 { -1 } else { at_a - at_b } } }
}

// `buildContainsWordForms` (`[word]/+page.svelte:152-178`): the Chinese
// words' forms, the Japanese words' written forms, the Korean words' hanja,
// the word and the entry's key, each once. kiokun.com also adds a Korean
// word's `hanjaForm`, which its builder never writes.
fn contains_forms(e: Entry, word: String) -> List<String> {
    let none: List<String> = []
    let chinese = List.fold(e.chinese, none, (out, w) => List.concat(out, [w.simp, w.trad]))
    let japanese = List.fold(e.japanese, none, (out, w) => List.concat(out, List.map(w.kanji, k => k.text)))
    let korean = List.map(e.korean, w => w.hanja)
    distinct(List.concat(List.concat(chinese, japanese), List.concat(korean, [word, e.key])))
}

// One preview as `orderContainsWords` places it: its place among the
// previews, and its characters.
type Candidate = Candidate {
    item: Preview,
    index: Int,
    chars: List<String>,
}

// A candidate placed in a form, from `start` to `end`.
type Placed = Placed {
    candidate: Candidate,
    start: Int,
    end: Int,
}

// Does `chars` begin at `at` in `form`?
fn matches_at(form: List<String>, chars: List<String>, at: Int) -> Bool {
    match List.get(chars, 0) {
        Some(c) => match List.get(form, at) {
            Some(f) => if f == c { matches_at(form, List.drop(chars, 1), at + 1) } else { false },
            None => false,
        },
        None => true,
    }
}

// `lexicalQuality`: a definition 4, common 2, a frequency rank 1.
fn quality(p: Preview) -> Int {
    let defined = if p.d != "" { 4 } else { 0 }
    let common = if p.c { 2 } else { 0 }
    let ranked = match p.fr {
        Some(_) => 1,
        None => 0,
    }
    defined + common + ranked
}

fn quality_of(placed: List<Placed>) -> Int {
    List.fold(placed, 0, (total, p) => total + quality(p.candidate.item))
}

// `lengthImbalance`: the longest piece's length less the shortest's.
fn imbalance(placed: List<Placed>) -> Int {
    let lengths = List.map(placed, p => p.end - p.start)
    let longest = List.fold(lengths, 0, (m, n) => if n > m { n } else { m })
    let shortest = List.fold(lengths, 1000000000, (m, n) => if n < m { n } else { m })
    longest - shortest
}

// The first place the two breakdowns' previews differ: -1 where `a`'s comes
// first, 1 where `b`'s does, 0 where none differs.
fn first_difference(a: List<Placed>, b: List<Placed>) -> Int {
    match List.get(a, 0) {
        Some(x) => match List.get(b, 0) {
            Some(y) => if x.candidate.index != y.candidate.index {
                if x.candidate.index < y.candidate.index { -1 } else { 1 }
            } else {
                first_difference(List.drop(a, 1), List.drop(b, 1))
            },
            None => 0,
        },
        None => 0,
    }
}

// `isBetterBreakdown`: fewer pieces; then better words; then pieces nearer
// one length; then the earlier previews.
fn better_breakdown(candidate: List<Placed>, current: Option<List<Placed>>) -> Bool {
    match current {
        Some(now) => if List.length(candidate) != List.length(now) {
            List.length(candidate) < List.length(now)
        } else {
            if quality_of(candidate) != quality_of(now) {
                quality_of(candidate) > quality_of(now)
            } else {
                if imbalance(candidate) != imbalance(now) { imbalance(candidate) < imbalance(now) } else { first_difference(candidate, now) < 0 }
            }
        },
        None => true,
    }
}

// The best breakdown from `stop` to the range's end, as `table` holds it:
// `table[i]` is the best from `end - i`.
fn best_at(table: List<Option<List<Placed>>>, end: Int, stop: Int) -> Option<List<Placed>> {
    match List.get(table, end - stop) {
        Some(best) => best,
        None => None,
    }
}

// One candidate tried at `cursor`: where it fits, with the best breakdown
// after it, kept where it beats `best`.
fn tried(form: List<String>, start: Int, end: Int, cursor: Int, table: List<Option<List<Placed>>>, best: Option<List<Placed>>, c: Candidate) -> Option<List<Placed>> {
    let stop = cursor + List.length(c.chars)
    if stop > end | (cursor == start & stop == end) | !matches_at(form, c.chars, cursor) {
        best
    } else {
        match best_at(table, end, stop) {
            Some(tail) => if better_breakdown(List.concat([Placed { candidate: c, start: cursor, end: stop }], tail), best) {
                Some(List.concat([Placed { candidate: c, start: cursor, end: stop }], tail))
            } else {
                best
            },
            None => best,
        }
    }
}

// Each cursor's best breakdown, from the range's end back to `cursor`.
fn table_from(form: List<String>, candidates: List<Candidate>, start: Int, end: Int, cursor: Int, table: List<Option<List<Placed>>>) -> List<Option<List<Placed>>> {
    let none: Option<List<Placed>> = None
    if cursor < start {
        table
    } else {
        table_from(form, candidates, start, end, cursor - 1, List.concat(table, [List.fold(candidates, none, (best, c) => tried(form, start, end, cursor, table, best, c))]))
    }
}

// `bestBreakdown`: the best way to write `form` from `start` to `end` in
// previews, never the whole range in one. kiokun.com finds each cursor's
// best once (its `memo`); so does this, from the end back.
fn breakdown(form: List<String>, candidates: List<Candidate>, start: Int, end: Int) -> Option<List<Placed>> {
    let done: List<Placed> = []
    best_at(table_from(form, candidates, start, end, end - 1, [Some(done)]), end, start)
}

// A range of a form, from `start` to `end`.
type Range = Range {
    start: Int,
    end: Int,
}

// `buildHierarchy`'s result: the pieces placed, breadth first, each once,
// and how many the whole form broke into.
type Hierarchy = Hierarchy {
    ordered: List<Placed>,
    top: Int,
}

// One level of `buildHierarchy`: each range's breakdown, its pieces kept
// once each, and the pieces longer than one character the next level's
// ranges.
type Level = Level {
    ordered: List<Placed>,
    next: List<Range>,
    top: Int,
}

fn placed_once(ordered: List<Placed>, pieces: List<Placed>) -> List<Placed> {
    List.fold(pieces, ordered, (out, p) => if List.any(out, q => q.candidate.index == p.candidate.index) { out } else { List.concat(out, [p]) })
}

fn level_of(form: List<String>, candidates: List<Candidate>, ranges: List<Range>, ordered: List<Placed>, top: Int, first: Bool) -> Level {
    let none: List<Range> = []
    List.fold(ranges, Level { ordered: ordered, next: none, top: top }, (l, r) => match breakdown(form, candidates, r.start, r.end) {
        Some(pieces) => Level {
            ordered: placed_once(l.ordered, pieces),
            next: List.concat(l.next, List.map(List.filter(pieces, p => p.end - p.start > 1), p => Range { start: p.start, end: p.end })),
            top: if first { List.length(pieces) } else { l.top },
        },
        None => l,
    })
}

fn levels(form: List<String>, candidates: List<Candidate>, ranges: List<Range>, ordered: List<Placed>, top: Int, first: Bool) -> Hierarchy {
    if List.length(ranges) == 0 {
        Hierarchy { ordered: ordered, top: top }
    } else {
        let l = level_of(form, candidates, ranges, ordered, top, first)
        levels(form, candidates, l.next, l.ordered, l.top, false)
    }
}

// `buildHierarchy`: the form broken into previews, breadth first. A count
// of 1000000000 stands for kiokun.com's `Infinity`: no form has as many
// characters.
fn hierarchy(form: List<String>, candidates: List<Candidate>) -> Hierarchy {
    let none: List<Placed> = []
    if List.length(form) < 2 { Hierarchy { ordered: none, top: 1000000000 } } else { levels(form, candidates, [Range { start: 0, end: List.length(form) }], none, 1000000000, true) }
}

// `isBetterHierarchy`: fewer pieces at the top; then more pieces placed.
fn better_hierarchy(candidate: Hierarchy, current: Hierarchy) -> Bool {
    if candidate.top != current.top { candidate.top < current.top } else { List.length(candidate.ordered) > List.length(current.ordered) }
}

// The form whose hierarchy is best so far.
type Chosen = Chosen {
    form: String,
    hierarchy: Hierarchy,
}

fn chosen_of(candidates: List<Candidate>, best: Chosen, form: String) -> Chosen {
    let h = hierarchy(characters(form), candidates)
    if better_hierarchy(h, best.hierarchy) { Chosen { form: form, hierarchy: h } } else { best }
}

// `compareRemaining`: the longer preview first; then the earlier in the
// form; then the earlier preview.
fn by_remaining(form: String, a: Candidate, b: Candidate) -> Int {
    let at_a = if index_of(form, a.item.w) == -1 { 1000000000 } else { index_of(form, a.item.w) }
    let at_b = if index_of(form, b.item.w) == -1 { 1000000000 } else { index_of(form, b.item.w) }
    if List.length(a.chars) != List.length(b.chars) {
        List.length(b.chars) - List.length(a.chars)
    } else {
        if at_a != at_b { at_a - at_b } else { a.index - b.index }
    }
}

// `orderContainsWords` (`contains-order.ts:29-57`): the previews that break
// the word down, breadth first, in reading order; then the rest.
fn ordered_contains(words: List<Preview>, forms: List<String>) -> List<Candidate> {
    let none: List<Candidate> = []
    let candidates = List.filter(List.fold(words, none, (out, p) => List.concat(out, [Candidate { item: p, index: List.length(out), chars: characters(p.w) }])), c => List.length(c.chars) > 0)
    let unique = distinct(forms)
    let first = match List.get(unique, 0) {
        Some(f) => f,
        None => "",
    }
    let nothing: List<Placed> = []
    let chosen = List.fold(unique, Chosen { form: first, hierarchy: Hierarchy { ordered: nothing, top: 1000000000 } }, (best, f) => chosen_of(candidates, best, f))
    let placed = List.map(chosen.hierarchy.ordered, p => p.candidate)
    let rest = List.filter(candidates, c => !List.any(placed, p => p.index == c.index))
    List.concat(placed, List.sort_by(rest, (a, b) => by_remaining(chosen.form, a, b)))
}

// A card of Contains: a preview, and the written forms it stands for where
// the word's forms differ at its place (`buildContainsCards`).
type ContainsCard = ContainsCard {
    candidate: Candidate,
    forms: List<String>,
}

// The forms' characters at `position`, each once.
fn at_position(forms: List<List<String>>, position: Int) -> List<String> {
    distinct(List.map(forms, chars => match List.get(chars, position) {
        Some(c) => c,
        None => "",
    }))
}

// Is `w` the character at `at`?
fn has_at(chars: List<String>, at: Int, w: String) -> Bool {
    match List.get(chars, at) {
        Some(c) => c == w,
        None => false,
    }
}

// The first place where one of the forms has the character `w`.
fn position_of(forms: List<List<String>>, w: String, at: Int, length: Int) -> Int {
    if at >= length { -1 } else { if List.any(forms, chars => has_at(chars, at, w)) { at } else { position_of(forms, w, at + 1, length) } }
}

type Carded = Carded {
    cards: List<ContainsCard>,
    used: List<Int>,
}

fn carded(previews: List<Candidate>, forms: List<List<String>>, length: Int, state: Carded, c: Candidate) -> Carded {
    let position = if List.length(c.chars) == 1 { position_of(forms, c.item.w, 0, length) } else { -1 }
    if List.any(state.used, u => u == c.index) {
        state
    } else {
        if position == -1 {
            Carded { cards: List.concat(state.cards, [ContainsCard { candidate: c, forms: [] }]), used: List.concat(state.used, [c.index]) }
        } else {
            let variants = at_position(forms, position)
            let matched = List.filter(previews, p => List.length(p.chars) == 1 & List.any(variants, v => v == p.item.w))
            match List.get(matched, 0) {
                Some(m) => Carded {
                    cards: List.concat(state.cards, [ContainsCard { candidate: m, forms: variants }]),
                    used: List.concat(state.used, List.map(matched, p => p.index)),
                },
                None => state,
            }
        }
    }
}

// `buildContainsCards` (`Contains.svelte:47-85`): where the word has
// several forms of one length, the one-character previews at one place are
// one card, written with each form's character there (学/學).
fn contains_cards(previews: List<Candidate>, word_forms: List<String>) -> List<ContainsCard> {
    let plain = List.map(previews, c => ContainsCard { candidate: c, forms: [] })
    let forms = List.map(distinct(word_forms), characters)
    let length = match List.get(forms, 0) {
        Some(f) => List.length(f),
        None => 0,
    }
    let none: List<ContainsCard> = []
    let nobody: List<Int> = []
    if List.length(forms) < 2 | length == 0 | List.any(forms, f => List.length(f) != length) {
        plain
    } else {
        let cards = List.fold(previews, Carded { cards: none, used: nobody }, (state, c) => carded(previews, forms, length, state, c)).cards
        if List.length(cards) > 0 { cards } else { plain }
    }
}

// `cleanGloss` (`Contains.svelte:104-108`): one source marker taken off the
// end, matched ignoring ASCII case.
fn clean_gloss(gloss: String) -> String {
    let t = String.trim(gloss)
    let lower = String.to_lower_ascii(t)
    let marker = match List.find(["(simp)", "(trad/jp)", "(trad)", "(jp)"], m => String.ends_with(lower, m)) {
        Some(m) => m,
        None => "",
    }
    if marker == "" { t } else { String.trim(String.slice(t, 0, String.length(t) - String.length(marker))) }
}

// One card of Contains as the page shows it (`Contains.svelte:140-200`):
// its written forms, each reading kiokun.com shows, and its definition.
type ShownContains = ShownContains {
    id: String,
    w: String,
    text: String,
    p: String,
    ct: String,
    jp: String,
    jo: String,
    kr: String,
    readings: Bool,
    japanese: Bool,
    on_and_kun: Bool,
    jp_class: String,
    kun_label: String,
    definition: String,
}

// `displayDefinition`: the first of the card's characters with a component
// gloss, cleaned; else the preview's definition.
fn contains_definition(card: ContainsCard, glosses: List<CharGloss>) -> String {
    let p = card.candidate.item
    match List.find(distinct(List.concat([p.w], card.forms)), c => List.any(glosses, g => g.character == c & g.gloss != "")) {
        Some(c) => match List.find(glosses, g => g.character == c & g.gloss != "") {
            Some(g) => clean_gloss(g.gloss),
            None => p.d,
        },
        None => p.d,
    }
}

fn contains_shown(card: ContainsCard, glosses: List<CharGloss>, n: Int) -> ShownContains {
    let p = card.candidate.item
    let jo = if p.jo != p.jp { p.jo } else { "" }
    ShownContains {
        id: "contains:{n}",
        w: p.w,
        text: if List.length(card.forms) > 0 { String.join(card.forms, "/") } else { p.w },
        p: p.p,
        ct: p.ct,
        jp: p.jp,
        jo: jo,
        kr: p.kr,
        readings: p.p != "" | p.ct != "" | p.jp != "" | jo != "" | p.kr != "",
        japanese: p.jp != "" | jo != "",
        on_and_kun: p.jp != "" & jo != "",
        jp_class: if jo != "" { "japanese-reading kunyomi-reading" } else { "japanese-reading" },
        kun_label: if jo != "" { "Japanese kun’yomi: {p.jp}" } else { "Japanese reading: {p.jp}" },
        definition: contains_definition(card, glosses),
    }
}

// A list shown ten at a time (`displayCount`, `pageSize` 10): the first
// ten, and the rest behind a disclosure, which needs no script.
type ContainsList = ContainsList {
    first: List<ShownContains>,
    rest: List<ShownContains>,
    more: String,
}

// Contains (`[word]/+page.svelte:916-925`, `Contains.svelte`): the word's
// previews ordered by where they sit, broken down, carded, and shown.
fn contains_of(e: Entry, word: String, glosses: List<CharGloss>) -> ContainsList {
    let sorted = List.sort_by(e.contains, (a, b) => by_place(word, a, b))
    let forms = contains_forms(e, word)
    let cards = contains_cards(ordered_contains(sorted, forms), forms)
    let none: List<ShownContains> = []
    let shown = List.fold(cards, none, (out, c) => List.concat(out, [contains_shown(c, glosses, List.length(out))]))
    ContainsList {
        first: List.take(shown, 10),
        rest: List.drop(shown, 10),
        more: "{List.length(shown) - 10} more",
    }
}

// INVISIBLE (`appears-in-order.ts:14`): zero-width characters and white
// space taken out.
fn visible_text(text: String) -> String {
    String.from_codepoints(List.filter(String.codepoints(text), c => c != 8203 & c != 8204 & c != 8205 & c != 8288 & c != 65279 & String.trim(String.from_codepoints([c])) != ""))
}

// `readingOf`: the pinyin, else the Japanese reading, else the Korean, seen
// and lower-cased.
fn reading_of(p: Preview) -> String {
    String.to_lower(visible_text(if p.p != "" { p.p } else { if p.jp != "" { p.jp } else { p.kr } }))
}

// `isChineseProperNoun`: pinyin that begins with an upper-case letter
// (`/^\p{Lu}/u`): one that upper-cases to itself and lower-cases to
// another.
fn proper_noun(p: Preview) -> Bool {
    let first = String.slice(visible_text(p.p), 0, 1)
    first != "" & String.to_upper(first) == first & String.to_lower(first) != first
}

// `dedupeAppearsIn`: the first preview of each written form, reading and
// definition; none without a form.
fn deduped(words: List<Preview>) -> List<Preview> {
    let none: List<Preview> = []
    List.fold(words, none, (out, p) => if p.w == "" | List.any(out, q => q.w == p.w & reading_of(q) == reading_of(p) & String.trim(q.d) == String.trim(p.d)) { out } else { List.concat(out, [p]) })
}

// `rankOf`: a rank above zero, else last.
fn rank_of(p: Preview) -> Int {
    match p.fr {
        Some(n) => if n > 0 { n } else { 1000000000 },
        None => 1000000000,
    }
}

type Ranked = Ranked {
    item: Preview,
    index: Int,
}

fn by_appearance(chinese: Bool, a: Ranked, b: Ranked) -> Int {
    let proper = (if proper_noun(a.item) { 1 } else { 0 }) - (if proper_noun(b.item) { 1 } else { 0 })
    let common = (if b.item.c { 1 } else { 0 }) - (if a.item.c { 1 } else { 0 })
    let first = if chinese { proper } else { common }
    if first != 0 {
        first
    } else {
        if rank_of(a.item) != rank_of(b.item) { if rank_of(a.item) < rank_of(b.item) { -1 } else { 1 } } else { a.index - b.index }
    }
}

// `rankAppearsIn` (`appears-in-order.ts:59-82`): Chinese words before names,
// Japanese common words first, each by frequency rank; Korean as the file
// lists them.
fn ranked(words: List<Preview>, language: String) -> List<Preview> {
    let unique = deduped(words)
    let none: List<Ranked> = []
    if language == "korean" {
        unique
    } else {
        List.map(List.sort_by(List.fold(unique, none, (out, p) => List.concat(out, [Ranked { item: p, index: List.length(out) }])), (a, b) => by_appearance(language == "chinese", a, b)), r => r.item)
    }
}

// One word of Appears in as the page shows it (`AppearsIn.svelte:160-290`):
// its reading the column's own, else the pinyin.
type ShownAppears = ShownAppears {
    id: String,
    w: String,
    reading: String,
    ct: String,
    d: String,
    c: Bool,
}

type AppearsList = AppearsList {
    id: String,
    heading: String,
    lang: String,
    first: List<ShownAppears>,
    rest: List<ShownAppears>,
    more: String,
}

fn appears_of(words: List<Preview>, language: String, heading: String, lang: String) -> AppearsList {
    let none: List<ShownAppears> = []
    let shown = List.fold(ranked(words, language), none, (out, p) => List.concat(out, [ShownAppears {
        id: "{language}-words:{List.length(out)}",
        w: p.w,
        reading: if language == "japanese" & p.jp != "" { p.jp } else { if language == "korean" & p.kr != "" { p.kr } else { p.p } },
        ct: if language == "chinese" { p.ct } else { "" },
        d: p.d,
        c: language == "japanese" & p.c,
    }]))
    AppearsList {
        id: "{language}-words",
        heading: heading,
        lang: lang,
        first: List.take(shown, 10),
        rest: List.drop(shown, 10),
        more: "{List.length(shown) - 10} more items",
    }
}

// Appears in (`[word]/+page.svelte:927-936`): each language's words that
// contain this one.
type Appears = Appears {
    chinese: AppearsList,
    japanese: AppearsList,
    korean: AppearsList,
    shown: Bool,
    columns: String,
}

fn appears_in(e: Entry) -> Appears {
    let chinese = appears_of(e.in_chinese, "chinese", "Chinese Words", "zh")
    let japanese = appears_of(e.in_japanese, "japanese", "Japanese Words", "ja")
    let korean = appears_of(e.in_korean, "korean", "Korean Words", "ko")
    let count = List.length(List.filter([List.length(chinese.first), List.length(japanese.first), List.length(korean.first)], n => n > 0))
    Appears {
        chinese: chinese,
        japanese: japanese,
        korean: korean,
        shown: count > 0,
        columns: if count == 3 { "word-columns three-columns" } else { if count == 2 { "word-columns two-columns" } else { "word-columns" } },
    }
}

// The word page's content: the word looked up, the character header, and
// each language's words.
type WordShown = WordShown {
    word: String,
    seo: Seo,
    header: Header,
    chinese: List<ShownChinese>,
    japanese: List<ShownJapanese>,
    korean: List<ShownKorean>,
    names: List<ShownName>,
    contains: ContainsList,
    appears: Appears,
    edrdg: Bool,
}

// Each Japanese word's pitch readings, by its place among the words.
fn pitch_at(pitches: List<WordPitch>, n: Int) -> List<PitchReading> {
    let none: List<PitchReading> = []
    match List.get(pitches, n) {
        Some(p) => p.readings,
        None => none,
    }
}

fn japanese_all(words: List<JapaneseWord>, labels: List<Label>, pitches: List<WordPitch>) -> List<ShownJapanese> {
    let none: List<ShownJapanese> = []
    List.fold(words, none, (out, w) => List.concat(out, [japanese_shown(w, labels, pitch_at(pitches, List.length(out)))]))
}

fn shown(word: String, l: Loaded, labels: List<Label>, glosses: List<CharGloss>, pitches: List<WordPitch>) -> WordShown {
    let none: List<ShownChinese> = []
    let e = l.data
    WordShown {
        word: word,
        seo: seo_of(word, e),
        header: header(e, forms_of(word, l, glosses)),
        chinese: List.fold(e.chinese, none, (out, w) => List.concat(out, chinese_shown(w, word))),
        japanese: japanese_all(e.japanese, labels, pitches),
        korean: List.map(e.korean, korean_shown),
        names: List.map(e.names, name_shown),
        contains: contains_of(e, word, glosses),
        appears: appears_in(e),
        edrdg: edrdg_shown(e),
    }
}

// Does the page show the Electronic Dictionary Research and Development
// Group's data: JMdict's words, JMnedict's names, KANJIDIC2's character, or
// a preview read from them (a Japanese word's reading, gloss or common
// flag; a character's on'yomi)? EDRDG's licence asks a web dictionary to
// acknowledge the files "on each screen display"
// (https://www.edrdg.org/edrdg/licence.html, checked 2026-10-10).
fn edrdg_shown(e: Entry) -> Bool {
    let previewed = List.any(e.contains, p => p.jp != "" | p.jo != "") | List.length(e.in_japanese) > 0
    List.length(e.japanese) > 0 | List.length(e.names) > 0 | previewed | match e.japanese_char {
        Some(_) => true,
        None => false,
    }
}

// **A word's page** (`[word]/+page.ts`): kiokun's entry for `word`, its
// redirect followed, as the page shows it; `NotFound` where kiokun has none.
public query Word(word: String) -> Result<WordShown, KiokunError>
    freshness   1.hours
    consistency snapshot
    cache       shared
    key         word
{
    // The word's file is in the subdirectory the shard rule names
    // (`shards.Place`, ADR-0041). A stub's `redirect` is followed one hop
    // (`[word]/+page.ts:438-462`), and the stub itself is shown where the
    // entry it names is not found. The host reads are written here, in the
    // query's own body: a host call reached only through a helper is not
    // among the component's imports (the compiler's `host_calls` reads the
    // declaration's body alone).
    let labels = read_labels()
    let first = recorded(read_entry(shards.subdirectory(word), file_name(word)), word)
    let target = target_of(first)
    let followed = match target {
        Some(t) => recorded(read_entry(shards.subdirectory(t), file_name(t)), t),
        None => None,
    }
    let data = data_of(first, followed)
    let stub = stub_of(first)
    let words = words_for(data, stub)
    let read = read_entries(List.map(words, place_of))
    let page = match data {
        Some(d) => Some(loaded(d, stub, words, read)),
        None => None,
    }
    let glosses = read_glosses(characters_for(word, page))
    let none: List<WordPitch> = []
    let pitches = match page {
        Some(l) => List.map(l.data.japanese, w => WordPitch { readings: read_pitch(pitch_shard(speak_of(w)), speak_of(w)) }),
        None => none,
    }
    // A simplified form that equals its one traditional form in meaning is
    // moved to that form's page, for good (`[word]/+page.ts:415-425`,
    // ADR-0295): the word's own file decides, before a stub is followed or
    // forms merged.
    let moved = moved_from(first, word)
    match moved {
        Some(t) => Err(Moved(t)),
        None => match page {
            Some(l) => Ok(shown(word, l, labels, glosses, pitches)),
            None => Err(NotFound),
        },
    }
}

// A sense's examples (`SenseExampleList.svelte`): the first, and the rest
// behind a disclosure, which needs no script. kiokun.com links each to its
// sentence reader, which the rewrite does not serve yet, and writes its
// Chinese with pinyin above it, which needs the reader's word breaks.
view SenseExamples(examples: ShownExamples) {
    {#if examples.first}
        <div class="sense-examples">
            <div class="sense-example-label">{examples.label}</div>
            <div class="sense-example-list">
                {#each examples.first as x (x.id)}
                    <span class="sense-example">
                        <span class="sense-example-source" lang={examples.lang}>{x.text}</span>
                        {#if x.translation}<span class="sense-example-translation">{x.translation}</span>{/if}
                    </span>
                {/each}
                {#if examples.rest}
                    <details class="sense-example-disclosure">
                        <summary>{examples.more}</summary>
                        {#each examples.rest as x (x.id)}
                            <span class="sense-example">
                                <span class="sense-example-source" lang={examples.lang}>{x.text}</span>
                                {#if x.translation}<span class="sense-example-translation">{x.translation}</span>{/if}
                            </span>
                        {/each}
                    </details>
                {/if}
            </div>
        </div>
    {/if}
}

// One card of Contains (`Contains.svelte:146-195`): a link to the word's
// page, its forms, each reading, and its definition.
view ContainsCardView(card: ShownContains) {
    <a href="/word/{card.w}" class="character-card">
        <div class="character">{card.text}</div>
        {#if card.readings}
            <div class="pronunciations">
                {#if card.p}<span class="chinese-reading">{card.p}</span>{/if}
                {#if card.ct}<span class="cantonese-reading">{card.ct}</span>{/if}
                {#if card.japanese}
                    <span class="japanese-readings" lang="ja">
                        {#if card.jp}<span class={card.jp_class} aria-label={card.kun_label}>{card.jp}</span>{/if}
                        {#if card.on_and_kun}<span class="japanese-reading-separator" aria-hidden="true">·</span>{/if}
                        {#if card.jo}<span class="japanese-onyomi-reading" aria-label="Japanese on’yomi: {card.jo}">{card.jo}</span>{/if}
                    </span>
                {/if}
                {#if card.kr}<span class="korean-reading">{card.kr}</span>{/if}
            </div>
        {/if}
        {#if card.definition}<div class="definition">{card.definition}</div>{/if}
    </a>
}

// Contains (`Contains.svelte:140-205`): the first ten cards, and the rest
// behind a disclosure saying how many there are.
view ContainsSection(list: ContainsList) {
    {#if list.first}
        <section id="contains" aria-labelledby="contains-heading">
            <h2 id="contains-heading">Contains</h2>
            <div class="characters-row">
                {#each list.first as c (c.id)}<ContainsCardView card={c} />{/each}
            </div>
            {#if list.rest}
                <details class="remaining">
                    <summary class="remaining-count">{list.more}</summary>
                    <div class="characters-row">
                        {#each list.rest as c (c.id)}<ContainsCardView card={c} />{/each}
                    </div>
                </details>
            {/if}
        </section>
    {/if}
}

// One word of Appears in (`AppearsIn.svelte:160-290`): a link to its page,
// JMdict's star for a common Japanese word, its reading, and its definition.
view AppearsCard(item: ShownAppears) {
    <a href="/word/{item.w}" class="word-card">
        <div class="word-header">
            <span class="word-text">{#if item.c}<span class="common-star" title="Common word">⭐</span>{/if}{item.w}</span>
            {#if item.reading}<span class="pronunciation" title={item.reading}>{item.reading}</span>{/if}
            {#if item.ct}<span class="cantonese-pronunciation" title="Cantonese (Jyutping)">{item.ct}</span>{/if}
        </div>
        {#if item.d}
            <div class="definition-row"><div class="definition" title={item.d}>{item.d}</div></div>
        {/if}
    </a>
}

// One column of Appears in: its heading, its first ten words, and the rest
// behind a disclosure saying how many there are.
view AppearsColumn(list: AppearsList) {
    {#if list.first}
        <div class="column" lang={list.lang}>
            <h2 id={list.id}>{list.heading}</h2>
            <div class="word-list">
                {#each list.first as w (w.id)}<AppearsCard item={w} />{/each}
            </div>
            {#if list.rest}
                <details class="remaining">
                    <summary class="remaining-count">{list.more}</summary>
                    <div class="word-list">
                        {#each list.rest as w (w.id)}<AppearsCard item={w} />{/each}
                    </div>
                </details>
            {/if}
        </div>
    {/if}
}

// Appears in (`AppearsIn.svelte:150-300`): a column for each language's
// words that contain this one.
view AppearsSection(appears: Appears) {
    {#if appears.shown}
        <section id="appears-in" class={appears.columns}>
            <AppearsColumn list={appears.chinese} />
            <AppearsColumn list={appears.japanese} />
            <AppearsColumn list={appears.korean} />
        </section>
    {/if}
}

// The word's page. Its route is `/word/{word}` until the host's own paths
// move under `/_pw/` (the integrator's ruling of 2026-10-08), then
// kiokun.com's `/{word}`.
page WordPage(word: String) {
    route        "/word/{word}"
    not_found_on KiokunError.NotFound
    redirect_on  KiokunError.Moved permanent
    placement    origin
    cache        shared

    let page = query Word(word)

    view {
        <title>{page.seo.title}</title>
        <meta name="description" content="{page.seo.description}" />
        <meta name="robots" content="index, follow" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Kiokun" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:title" content="{page.seo.title}" />
        <meta property="og:description" content="{page.seo.description}" />
        <meta name="twitter:title" content="{page.seo.title}" />
        <meta name="twitter:description" content="{page.seo.description}" />
        <main>
            <h1 id="headword">{page.word}</h1>
            {#if page.header.shown}
                <div id="character-header" class="character-identity-grid">
                    {#if page.header.forms}
                        <div class="character-form-list">
                            {#each page.header.forms as f (f.id)}
                                <div class="character-form">
                                    <div class="character-specimen" aria-label={f.aria}>
                                        <div lang={f.lang}>{f.character}</div>
                                    </div>
                                    <div class="form-roles" title={f.label}>
                                        <span class="visually-hidden">{f.label}</span>
                                        <span aria-hidden="true">{f.short}</span>
                                    </div>
                                    {#if f.meaning}<div class="form-meaning" title={f.title}>{f.meaning}</div>{/if}
                                </div>
                            {/each}
                        </div>
                    {/if}
                    {#if page.header.gloss}
                        <div class="character-summary">
                            <div class="character-title-row">
                                <h2 id="entry-gloss" class="entry-gloss">{page.header.gloss}</h2>
                                {#if page.header.hsk}<span class="level-badge hsk" title="Chinese proficiency test level">{page.header.hsk}</span>{/if}
                                {#if page.header.jlpt}<span class="level-badge jlpt" title="Japanese proficiency test level">{page.header.jlpt}</span>{/if}
                            </div>
                            {#if page.header.lexical}
                                <div id="mnemonic-keyword"><span>Mnemonic keyword</span><span aria-hidden="true"> · </span><span>Actual meanings:</span> {page.header.lexical}</div>
                            {/if}
                        </div>
                    {/if}
                    {#if page.header.readings}
                        <div class="character-readings" aria-label="Character readings">
                            {#each page.header.readings as r (r.id)}
                                {#if !r.first}<span class="reading-separator" aria-hidden="true">·</span>{/if}
                                <span class="character-reading-group" aria-label="{r.label}: {r.value}">
                                    <span class="reading-label">{r.label}</span>
                                    <span class={r.class_name} lang={r.lang}>{r.value}</span>
                                </span>
                            {/each}
                        </div>
                    {/if}
                </div>
            {/if}
            {#if page.chinese}
                <section id="chinese" aria-labelledby="chinese-heading">
                    <h2 id="chinese-heading">Chinese</h2>
                    {#each page.chinese as c (c.id)}
                        <div class="chinese-word-entry" lang="zh">
                            <div class="chinese-headwords">
                                <span class="chinese-word-text">
                                    {#if c.both}
                                        <span lang="zh-Hans">{c.simp}</span> / <span lang="zh-Hant">{c.trad}</span>
                                    {:else}
                                        {c.trad}
                                    {/if}
                                </span>
                                {#if c.pinyin}<span class="chinese-pronunciation">[{c.pinyin}]</span>{/if}
                                {#if c.jyutping}<span class="cantonese-pronunciation" title="Cantonese (Jyutping)">[{c.jyutping}]</span>{/if}
                            </div>
                            <ol class="chinese-definitions">
                                {#each c.definitions as d (d.id)}
                                    <li class="chinese-definition">
                                        <div>{d.text}</div>
                                        <SenseExamples examples={d.examples} />
                                    </li>
                                {/each}
                            </ol>
                        </div>
                    {/each}
                </section>
            {/if}
            {#if page.japanese}
                <section id="japanese" aria-labelledby="japanese-heading">
                    <h2 id="japanese-heading">Japanese</h2>
                    {#each page.japanese as j (j.id)}
                        <div class="word-entry" lang="ja">
                            <div class="headwords">
                                {#each j.kanji as k (k.id)}
                                    {#if !k.first}<span class="separator">、</span>{/if}
                                    <span class="kanji-item">
                                        <span class="kanji-text">{k.text}</span>
                                        {#each k.tags as t (t.id)}<span class="info-tag">({t.text})</span>{/each}
                                        {#if k.common}<span class="common" title="Common word">★</span>{/if}
                                    </span>
                                {/each}
                                {#each j.kana as k (k.id)}
                                    {#if !k.first}<span class="separator">、</span>{/if}
                                    <span class="kana-item">
                                        <span class="kana-text">{k.text}</span>
                                        {#each k.tags as t (t.id)}<span class="info-tag">({t.text})</span>{/each}
                                        {#if k.common}<span class="common" title="Common word">★</span>{/if}
                                    </span>
                                {/each}
                                {#if j.reading}
                                    <span class="pronunciation-slot" lang="ja">
                                        <span class="kana-pronunciation">{j.reading}</span>
                                        {#if j.pitch.shown}
                                            <span class="pitch-display" title={j.pitch.title}>
                                                {#each j.pitch.morae as m (m.id)}<span class={m.class_name}>{m.text}</span>{/each}
                                                <span class="pitch-label">{j.pitch.label}</span>
                                            </span>
                                        {/if}
                                    </span>
                                {/if}
                            </div>
                            {#if j.many}
                                <ol class="sense-list">
                                    {#each j.senses as s (s.id)}
                                        <li class="sense-item">
                                            <div class="sense-primary">
                                                {#each s.glosses as g (g.id)}{#if !g.first}; {/if}{#if g.kind}<span class="gloss-type">({g.kind})</span> {/if}<span>{g.text}</span>{/each}
                                                {#if s.info}<span class="info-text"> ({s.info})</span>{/if}
                                            </div>
                                            {#if s.labels}
                                                <div class="sense-meta" aria-label="Definition labels">
                                                    {#each s.labels as l (l.id)}<span class="tag">{l.text}</span> {/each}
                                                </div>
                                            {/if}
                                            <SenseExamples examples={s.examples} />
                                        </li>
                                    {/each}
                                </ol>
                            {:else}
                                {#each j.senses as s (s.id)}
                                    <div class="single-sense">
                                        <div class="sense-primary">
                                            {#each s.glosses as g (g.id)}{#if !g.first}; {/if}{#if g.kind}<span class="gloss-type">({g.kind})</span> {/if}<span>{g.text}</span>{/each}
                                            {#if s.info}<span class="info-text"> ({s.info})</span>{/if}
                                        </div>
                                        {#if s.labels}
                                            <div class="sense-meta" aria-label="Definition labels">
                                                {#each s.labels as l (l.id)}<span class="tag">{l.text}</span> {/each}
                                            </div>
                                        {/if}
                                        <SenseExamples examples={s.examples} />
                                    </div>
                                {/each}
                            {/if}
                        </div>
                    {/each}
                </section>
            {/if}
            {#if page.korean}
                <section id="korean" aria-labelledby="korean-heading" lang="ko">
                    <h2 id="korean-heading">Korean</h2>
                    {#each page.korean as k (k.id)}
                        <div class="korean-word-entry">
                            <div class="korean-headwords">
                                <span class="korean-word-text">{k.hangul}</span>
                                {#if k.hanja}<span class="korean-hanja">[{k.hanja}]</span>{/if}
                            </div>
                            {#if k.pos}<div class="korean-pos-tags"><span class="tag">{k.pos}</span></div>{/if}
                            {#if k.definitions}
                                <ol class="korean-definitions">
                                    {#each k.definitions as d (d.id)}
                                        <li class="korean-definition">
                                            <div>{d.text}</div>
                                            <SenseExamples examples={d.examples} />
                                        </li>
                                    {/each}
                                </ol>
                            {/if}
                            <SenseExamples examples={k.examples} />
                        </div>
                    {/each}
                </section>
            {/if}
            {#if page.names}
                <section id="names" aria-labelledby="names-heading">
                    <h2 id="names-heading">Japanese Names</h2>
                    <div class="names-grid">
                        {#each page.names as n (n.id)}
                            <div class="name-entry">
                                <div class="name-headwords" lang="ja">
                                    {#if n.kanji}<span class="kanji-forms">{n.kanji}</span>{/if}
                                    <span class="kana-forms">{n.kana}</span>
                                </div>
                                <div class="name-translations">
                                    {#each n.translations as t (t.id)}
                                        <div class="translation-line">
                                            <span class="translation-text">{t.text}</span>
                                            {#each t.kinds as kd (kd.id)}<span class="tag">{kd.text}</span>{/each}
                                        </div>
                                    {/each}
                                </div>
                            </div>
                        {/each}
                    </div>
                </section>
            {/if}
            <ContainsSection list={page.contains} />
            <AppearsSection appears={page.appears} />
            {#if page.edrdg}
                <footer class="data-sources">
                    <p>This page uses the <a href="https://www.edrdg.org/wiki/index.php/JMdict-EDICT_Dictionary_Project">JMdict</a>, JMnedict and <a href="https://www.edrdg.org/wiki/index.php/KANJIDIC_Project">KANJIDIC2</a> dictionary files. These files are the property of the <a href="https://www.edrdg.org/">Electronic Dictionary Research and Development Group</a>, and are used in conformance with the Group's <a href="https://www.edrdg.org/edrdg/licence.html">licence</a>.</p>
                </footer>
            {/if}
        </main>
    }
}
