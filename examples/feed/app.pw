// @corpus: reference
// @id: FEED
// @category: a reference app unlike the store: a feed
// @milestone: E14
//
// The owner's reference app (NEXT 22): a Twitter-shaped feed, to find what
// the store does not. Users, posts with their replies as deep as they go, a
// timeline read a page at a time, posting, replying and liking. Its data is
// the deployment's (ADR-0218): `feed:data/…` is what the host's feed layer
// supplies.

module feed.app

import List
import String
import context.{ current_session, current_user }
import capability.{ Session, SessionId }
// Track `notifications` (ADR-0270): a user's id is the platform's, the
// principal's `UserId`, which a handle, `User<UserId>`, is over. An id names
// someone and grants nothing; a handle is the host's alone to make.
import capability.{ UserId }
import capability

opaque type PostId = String
opaque type InteractionId = String

// **A post's text** (ADR-0225): something, and at most 280 characters,
// each a code point as `String.length` counts it. Every construction is
// shown to hold it at build, and the host holds a browser's to it.
opaque type PostText = String where String.length(value) >= 1 & String.length(value) <= 280

// **A draft as a post's text, or none** (ADR-0225): the program's own
// checked constructor, as ADR-0179 asks.
fn post_text(draft: String) -> Option<PostText> !{} {
    if String.length(draft) >= 1 & String.length(draft) <= 280 {
        Some(PostText(draft))
    } else {
        None
    }
}

type User = User { id: UserId, handle: String, name: String }

type Post = Post {
    id: PostId,
    author: User,
    text: String,
    likes: Int,
    replies: List<Post>,
    images: List<Image>, // Track `uploads` (ADR-0260): none, or one.
}

// **A post as a timeline shows it** (ADR-0222): who wrote it, what it says,
// and its likes. Its replies are its thread's.
type Item = Item {
    id: PostId,
    author: User,
    text: String,
    likes: Int,
    // Whether the reader wrote it (track `identity`): the timeline is
    // private, and a post its author may delete shows a Delete button.
    mine: Bool,
    images: List<Image>, // Track `uploads` (ADR-0260): none, or one.
}

// --- Track `uploads` (ADR-0260): an image on a post. -----------------------

// **An image a post carries**: where it is served, its width and height as
// a browser shows it, so its page keeps its place before it loads
// (ADR-0187), and its author's words for whoever cannot see it.
type Image = Image { src: String, width: Int, height: Int, alt: String }

// **An image's words for whoever cannot see it**: something, and at most
// 1000 characters. A post's image has them, or is not posted.
opaque type AltText = String where String.length(value) >= 1 & String.length(value) <= 1000

// **A draft as an image's words, or none**, as `post_text` is a post's.
fn alt_text(draft: String) -> Option<AltText> !{} {
    if String.length(draft) >= 1 & String.length(draft) <= 1000 {
        Some(AltText(draft))
    } else {
        None
    }
}

// **The image the session attached, waiting for its post**: where its page
// shows it, and its width and height. The upload itself is the host's: a
// page never holds it.
type Attached = Attached { src: String, width: Int, height: Int }

// **An attached image, claimed by a command** (ADR-0250): an acquisition,
// which the command commits with its post or discards, on every path.
opaque type Upload = String

// **What a post's image may be**: the host reads a form's file posted to its
// route within these, sniffing its kind from its bytes, and serves what a
// post commits under `/images`.
upload PostImage
    route      "/uploads/post-image"
    serves     "/images"
    max_bytes  5_000_000
    types      png, jpeg, webp, gif
    max_width  4096
    max_height 4096

// --- end of track `uploads`'s types. -----------------------------------------

// **Who follows whom** (ADR-0257): a row a follow writes and an unfollow
// deletes, the follower first.
type Follow = Follow { follower: UserId, followee: UserId }

// **A post as its author's page lists it** (ADR-0257): what it says and its
// likes. Its author is the page's.
type Authored = Authored { id: PostId, text: String, likes: Int }

// **A user's page** (ADR-0257): who they are, how many follow them and how
// many they follow, and their newest posts. Every reader's: what the reader
// is to them is the reader's own, `Relation`.
type Profile = Profile {
    user: User,
    followers: Int,
    following: Int,
    posts: List<Authored>,
}

// **What the reader is to a user** (ADR-0257): the user, one who follows
// them, or one who does not.
type Relation =
    | Yourself
    | Following
    | NotFollowing

type FeedError =
    | Unavailable
    | NotFound

event Posted(author: UserId)
event Liked(post: PostId)
event Followed(follower: UserId, followee: UserId)
event Unfollowed(follower: UserId, followee: UserId)
event Deleted(post: PostId)

// **Who reads the page** (track `identity`, ADR-0258): whether the session
// is signed in, and the name its provider gave. Who a session is belongs to
// the deployment: the host signs a session in through the deployment's
// identity provider and keeps its principal, and nothing of it is any other
// session's.
// `account`: signed in to an account, which can sign out; the development
// guest model's guest (every session its own) has none.
type Viewer = Viewer { signed_in: Bool, account: Bool, name: String }

// **What the feed's database guarantees** (ADR-0207, ADR-0246): one
// PostgreSQL, as the host's feed layer opens it.
// - A command's writes commit in a serializable transaction: the layer sets
//   it on each, whatever the connection's default (read committed).
// - A read is of the latest commit, on the primary.
// - It tells no change itself: the program's own events tell them, written
//   with each command's writes in the outbox, in the same transaction.
// The host compares these with what the database it opens provides, and
// does not serve on a mismatch.
source FeedData
    holds        Post, User, Follow, Notification, Message
    transactions serializable
    reads        strong
    changes      none

fn timeline(s: Session<SessionId>, limit: Int) -> List<Item> !{ database.read<Post> }
    host "feed:data/posts#timeline"

fn thread(id: PostId) -> Result<Post, FeedError> !{ database.read<Post> }
    host "feed:data/posts#thread"

fn author(s: Session<SessionId>) -> UserId !{ database.read<User> }
    host "feed:data/users#of-session"

fn publish(s: Session<SessionId>, text: PostText) -> Result<Post, FeedError> !{ database.write<Post> }
    host "feed:data/posts#publish"

// Track `notifications` (ADR-0274): a reply, a like, a follow and a delete
// each write the notifications they tell of, or take with them, in their own
// transaction: `database.write<Notification>`.
fn add_reply(s: Session<SessionId>, to: PostId, text: PostText) -> Result<Post, FeedError> !{ database.write<Post>, database.write<Notification> }
    host "feed:data/posts#reply"

fn add_like(s: Session<SessionId>, post: PostId) -> Result<Post, FeedError> !{ database.write<Post>, database.write<Notification> }
    host "feed:data/posts#like"

// **The image the session attached** (track `uploads`): none, or the one.
// A list, since a handler that reads it takes no `Option` apart (ADR-0033).
fn attached(s: Session<SessionId>) -> List<Attached> !{ database.read<Attached> }
    host "feed:data/uploads#attached"

// **The session's attached image, claimed** (track `uploads`): held by the
// command until it commits it with a post or discards it. None attached is
// not found.
fn claim(s: Session<SessionId>) -> Result<Upload, FeedError> !{ database.read<Attached>, resource.acquire<Upload> }
    host "feed:data/uploads#claim"

// **A post with its image** (track `uploads`): the image committed with the
// post, in its transaction, and the claim ended.
fn publish_image(s: Session<SessionId>, text: PostText, alt: AltText, image: Upload) -> Result<Post, FeedError> !{ database.write<Post>, resource.release<Upload> }
    host "feed:data/posts#publish-image"

// **An attached image, discarded** (track `uploads`): the claim ended, and
// nothing posted.
fn discard(s: Session<SessionId>, image: Upload) -> Result<Attached, FeedError> !{ database.write<Attached>, resource.release<Upload> }
    host "feed:data/uploads#discard"

// **The timeline of those the session's user follows** (ADR-0257): their
// posts and its own, newest first, at most `limit`.
fn following_timeline(s: Session<SessionId>, limit: Int) -> List<Item> !{ database.read<Post>, database.read<Follow> }
    host "feed:data/posts#following"

// **A user's page** (ADR-0257), or none for one the feed does not know.
fn profile(id: UserId) -> Result<Profile, FeedError> !{ database.read<User>, database.read<Post>, database.read<Follow> }
    host "feed:data/users#profile"

// **What the session's user is to `user`** (ADR-0257).
fn relation(s: Session<SessionId>, user: UserId) -> Relation !{ database.read<User>, database.read<Follow> }
    host "feed:data/users#relation"

// **The session's user follows `user`** (ADR-0257): once, whatever how
// often; one the feed does not know, or itself, is not found.
fn add_follow(s: Session<SessionId>, user: UserId) -> Result<UserId, FeedError> !{ database.read<User>, database.write<Follow>, database.write<Notification> }
    host "feed:data/users#follow"

// **The session's user follows `user` no more** (ADR-0257): one it does not
// follow is no change; one the feed does not know is not found.
fn remove_follow(s: Session<SessionId>, user: UserId) -> Result<UserId, FeedError> !{ database.read<User>, database.write<Follow> }
    host "feed:data/users#unfollow"

fn remove(s: Session<SessionId>, post: PostId) -> Result<PostId, FeedError> !{ database.write<Post>, database.write<Notification> }
    host "feed:data/posts#delete"

// Who the session is, which the platform's session capability reads: a
// principal is the session's, as its id is.
fn viewer(s: Session<SessionId>) -> Viewer !{ session.read }
    host "feed:data/users#viewer"

// **The session's reader** (track `identity`): private to it. Signing in or
// out gives the browser a new session, so its pages ask again.
session query Me(session: Session<SessionId>) -> Viewer
    freshness     0.seconds
    consistency   read_your_writes
    cache         private
    key           session
    concurrency   one_per_key
    on_key_change cancel
    timeout       2.seconds
{
    viewer(session)
}

session query Timeline(session: Session<SessionId>, limit: Int) -> List<Item>
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    key            session, limit
    invalidates_on Posted(_), Liked(_), Deleted(_)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    timeline(session, limit)
}

// **The timeline of those you follow** (ADR-0257): their posts and your
// own, newest first, read as the home timeline is. A follow or an unfollow
// drops it, by its own `invalidates`.
session query FollowingTimeline(session: Session<SessionId>, limit: Int) -> List<Item>
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    key            session, limit
    invalidates_on Posted(_), Liked(_), Deleted(_)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    following_timeline(session, limit)
}

// **A user's page** (ADR-0257), every reader's: its counts change when
// someone follows them or they follow someone, and its posts when they post
// or one is liked.
public query Profile(id: UserId) -> Result<Profile, FeedError>
    freshness      5.seconds
    consistency    snapshot
    cache          shared
    key            id
    invalidates_on Followed(_, id), Unfollowed(_, id), Followed(id, _),
        Unfollowed(id, _), Posted(id), Liked(_), Deleted(_)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    profile(id)
}

// **What the reader is to a user** (ADR-0257): the reader's own.
session query Relation(session: Session<SessionId>, user: UserId) -> Relation
    freshness     0.seconds
    consistency   read_your_writes
    cache         private
    key           session, user
    concurrency   one_per_key
    on_key_change cancel
    timeout       2.seconds
{
    relation(session, user)
}

// **The image the session attached** (track `uploads`): the reader's own,
// read again whenever its page is, since a form posts it.
session query Attached(session: Session<SessionId>) -> List<Attached>
    freshness     0.seconds
    consistency   read_your_writes
    cache         private
    key           session
    concurrency   one_per_key
    on_key_change cancel
    timeout       2.seconds
{
    attached(session)
}

public query Thread(id: PostId) -> Result<Post, FeedError>
    freshness      5.seconds
    consistency    snapshot
    cache          shared
    key            id
    invalidates_on Liked(id), Posted(_), Deleted(_)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    thread(id)
}

command post(text: PostText) -> Result<Post, FeedError>
    requires      SignedIn
    idempotent_by InteractionId
    emits         Posted(author(current_session()))
    optimistic    Timeline(current_session(), _) as feed => pending(feed, text)
{
    publish(current_session(), text)
}

// **A post with the image the session attached** (track `uploads`): the
// image claimed, and committed with the post or the command refused. PW2005
// holds the body to ending the claim on every path (ADR-0250).
command post_image(text: PostText, alt: AltText) -> Result<Post, FeedError>
    requires      SignedIn
    idempotent_by InteractionId
    emits         Posted(author(current_session()))
    invalidates   Attached(current_session())
{
    let image = claim(current_session())?
    publish_image(current_session(), text, alt, image)
}

// **The attached image, removed** (track `uploads`): claimed and discarded.
command discard_image() -> Result<Attached, FeedError>
    requires      SignedIn
    idempotent_by InteractionId
    invalidates   Attached(current_session())
{
    let image = claim(current_session())?
    discard(current_session(), image)
}

// **A reply** (ADR-0231): a post, in its thread and in no timeline. The
// thread page passes its `id`, the page's parameter, which keys the thread it
// shows, so a reply is shown there before the server answers (ADR-0236,
// ruling 0122-d).
command reply(to: PostId, text: PostText) -> Result<Post, FeedError>
    requires      SignedIn
    idempotent_by InteractionId
    emits         Posted(author(current_session())), Notified(owner(to))
    optimistic    Thread(to) as thread => replied(thread, text)
{
    add_reply(current_session(), to, text)
}

// **A reply shown before the server answers** (ADR-0236): last among the
// thread's replies, by "You", keyed apart from every other pending one.
fn replied(thread: Post, text: PostText) -> Post !{} {
    let you = User { id: UserId("you"), handle: "@you", name: "You" }
    let id = PostId("pending-reply-{List.length(thread.replies)}")
    let mine = Post { id: id, author: you, text: text.value, likes: 0, replies: [], images: [] }
    Post {
        id: thread.id,
        author: thread.author,
        text: thread.text,
        likes: thread.likes,
        replies: List.concat(thread.replies, [mine]),
        images: thread.images,
    }
}

// **A post shown before the server answers** (ADR-0222): first in the
// timeline, by "You", keyed apart from every other pending one.
fn pending(feed: List<Item>, text: PostText) -> List<Item> !{} {
    let you = User { id: UserId("you"), handle: "@you", name: "You" }
    let id = PostId("pending-{List.length(feed)}")
    List.concat([Item { id: id, author: you, text: text.value, likes: 0, mine: true, images: [] }], feed)
}

// **A row shown before the server answers waits** (ADR-0275): its id is one
// the page made, `pending()`'s or `replied()`'s, which no server has, so
// nothing on the timeline's row acts or links until the server's row stands
// in its place. A like pressed on one found no such post (ADR-0274). A reply
// shown before the server answers still links to itself: the thread's
// replies are a view that contains itself, which computes no value in its
// template yet (ruling 0073-a).
fn waits(id: PostId) -> Bool !{} {
    String.starts_with(id.value, "pending-")
}

// **A count, in words** (ADR-0226): "1 reply", "3 likes". The thread
// page computes its counts with it, in the template.
fn counted(n: Int, one: String, many: String) -> String !{} {
    if n == 1 {
        "1 {one}"
    } else {
        "{n} {many}"
    }
}

command like(post: PostId) -> Result<Post, FeedError>
    requires      SignedIn
    idempotent_by InteractionId
    emits         Liked(post), Notified(owner(post))
    optimistic    Timeline(current_session(), _) as feed => liked(feed, post),
        FollowingTimeline(current_session(), _) as feed => liked(feed, post),
        Thread(post) as thread => liked_thread(thread, post)
{
    add_like(current_session(), post)
}

// **Following someone** (ADR-0257): their posts in your following timeline
// from now on, and one more follower on their page. Shown before the server
// answers: the button, and the count.
command follow(user: UserId) -> Result<UserId, FeedError>
    requires      SignedIn
    idempotent_by InteractionId
    emits         Followed(author(current_session()), user)
    invalidates   FollowingTimeline(current_session(), _), Relation(current_session(), user)
    optimistic    Relation(current_session(), user) as now => followed(now),
        Profile(user) as person => counted_follower(person, 1)
{
    add_follow(current_session(), user)
}

// **Following someone no more** (ADR-0257).
command unfollow(user: UserId) -> Result<UserId, FeedError>
    requires      SignedIn
    idempotent_by InteractionId
    emits         Unfollowed(author(current_session()), user)
    invalidates   FollowingTimeline(current_session(), _), Relation(current_session(), user)
    optimistic    Relation(current_session(), user) as now => unfollowed(now),
        Profile(user) as person => counted_follower(person, -1)
{
    remove_follow(current_session(), user)
}

// **A follow, shown before the server answers** (ADR-0257): the reader
// follows them, unless they are the reader.
fn followed(now: Relation) -> Relation !{} {
    match now {
        Yourself => Yourself,
        _ => Following,
    }
}

// **An unfollow, shown before the server answers** (ADR-0257).
fn unfollowed(now: Relation) -> Relation !{} {
    match now {
        Yourself => Yourself,
        _ => NotFollowing,
    }
}

// **A page's follower count, by `by`** (ADR-0257).
fn counted_follower(person: Profile, by: Int) -> Profile !{} {
    Profile {
        user: person.user,
        followers: person.followers + by,
        following: person.following,
        posts: person.posts,
    }
}

// **A post deleted by its author** (track `identity`, ADR-0115):
// `OwnsPost(post)` is the deployment's predicate over the command's
// parameter, evaluated before the body runs, so another reader's post is
// refused and nothing of it runs. It and its replies go.
command delete(post: PostId) -> Result<PostId, FeedError>
    requires      SignedIn, OwnsPost(post)
    idempotent_by InteractionId
    emits         Deleted(post)
{
    remove(current_session(), post)
}

// **A like on the thread page, shown before the server answers**
// (ADR-0238): the thread's count one more, where the thread is the post.
fn liked_thread(thread: Post, post: PostId) -> Post !{} {
    if thread.id == post {
        Post {
            id: thread.id,
            author: thread.author,
            text: thread.text,
            likes: thread.likes + 1,
            replies: thread.replies,
            images: thread.images,
        }
    } else {
        thread
    }
}

// **A like shown before the server answers** (ADR-0228): the post's count
// one more, in the timeline the page shows.
fn liked(feed: List<Item>, post: PostId) -> List<Item> !{} {
    List.map(feed, (i) => if i.id == post {
        Item { id: i.id, author: i.author, text: i.text, likes: i.likes + 1, mine: i.mine, images: i.images }
    } else {
        i
    })
}

session page Home() {
    route     "/"
    placement origin
    cache     private

    signal shown: Int = 20
    signal draft: String = ""
    signal alt: String = "" // Track `uploads`: the attached image's words.
    let feed = query Timeline(current_session(), shown)
    let me = query Me(current_session())
    let staged = query Attached(current_session()) // Track `uploads`.
    let waiting = query Unread(current_user()) // Track `notifications`.
    let unread_dms = query UnreadMessages(current_user()) // Track `messages`.

    view {
        <title>Home</title>
        <main>
            <h1>Home</h1>
            <nav aria-label="Timelines"><a href="/" aria-current="page">Everyone</a> <a href="/following">Following</a></nav>
            {#if me.signed_in}
            <p id="me">Signed in as {me.name}</p>
            <p id="unread"><a href="/notifications">Notifications: {waiting} unread</a></p>
            <p id="dm-unread"><a href="/messages">Messages: {unread_dms} unread</a></p>
            {#if me.account}<form method="post" action="/sign-out"><button type="submit">Sign out</button></form>{/if}
            {:else}
            <p id="signed-out" role="status">Sign in to post, reply or like.</p>
            <form method="get" action="/sign-in"><button type="submit">Sign in</button></form>
            <form method="get" action="/sign-up"><button type="submit">Sign up</button></form>
            {/if}
            {#if me.signed_in}
                {#each staged as a (a.src)}
                    <figure class="attached">
                        <img class="attached-image" src={a.src} width={a.width} height={a.height} alt="The image you attached">
                        <figcaption>Attached, and posted with what you write next.</figcaption>
                    </figure>
                    <button class="remove-image" type="button" on:press={() => match discard_image() {
                        Ok(_) => alt = "",
                        Err(_) => alt = alt,
                    }}>Remove image</button>
                {/each}
                <form id="attach" method="post" action="/uploads/post-image" enctype="multipart/form-data">
                    <label>An image to attach <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif"></label>
                    <button type="submit">Attach</button>
                </form>
            {/if}
            <form on:submit|prevent={() => match post_text(draft) {
                Some(text) => if List.length(staged) > 0 {
                    match alt_text(alt) {
                        Some(words) => match post_image(text, words) {
                            Ok(_) => draft = "",
                            Err(_) => draft = draft,
                        },
                        None => draft = draft,
                    }
                } else {
                    match post(text) {
                        Ok(_) => draft = "",
                        Err(_) => draft = draft,
                    }
                },
                None => draft = draft,
            }}>
                <label>What's happening? <textarea bind:value={draft}></textarea></label>
                <label>The image, in words, for whoever cannot see it <textarea id="alt" bind:value={alt}></textarea></label>
                <p id="left">{280 - String.length(draft)} left</p>
                {#if String.length(draft) > 280}<p id="over" role="alert">Too long to post.</p>{/if}
                <button type="submit" disabled={String.length(draft) == 0 | String.length(draft) > 280}>Post</button>
            </form>
            <ul>
                {#each feed as p (p.id)}
                    <li>
                        {#if waits(p.id)}
                            <a class="author">{p.author.name}</a>
                            <a class="handle">{p.author.handle}</a>
                        {:else}
                            <a class="author" href="/post/{p.id}">{p.author.name}</a>
                            <a class="handle" href="/user/{p.author.id}">{p.author.handle}</a>
                        {/if}
                        <p>{p.text}</p>
                        {#each p.images as shown_image (shown_image.src)}
                            <img class="photo" src={shown_image.src} width={shown_image.width} height={shown_image.height} alt={shown_image.alt}>
                        {/each}
                        <button type="button" disabled={waits(p.id)} on:press={resumable(captures = { p }) => match like(p.id) {
                            Ok(_) => draft = draft,
                            Err(_) => draft = draft,
                        }}>Like</button>
                        <span class="likes">{counted(p.likes, "like", "likes")}</span>
                        {#if p.mine}<button type="button" class="delete" disabled={waits(p.id)} on:press={resumable(captures = { p }) => match delete(p.id) {
                            Ok(_) => draft = draft,
                            Err(_) => draft = draft,
                        }}>Delete</button>{/if}
                    </li>
                {/each}
            </ul>
            <button type="button" on:press={() => shown = shown + 20}>Load more</button>
        </main>
    }
}

// A post and its replies, each a post with its own, as deep as they go
// (ADR-0203: a view that contains itself).
view Replies(post: Post) {
    <article>
        <p><a href="/post/{post.id}">{post.author.name}</a></p>
        {#each post.images as thread_image (thread_image.src)}
            <img class="photo" src={thread_image.src} width={thread_image.width} height={thread_image.height} alt={thread_image.alt}>
        {/each}
        <p>{post.text}</p>
        <ul>
            {#each post.replies as reply (reply.id)}
                <li><Replies post={reply} /></li>
            {/each}
        </ul>
    </article>
}

page PostPage(id: PostId) {
    route        "/post/{id}"
    not_found_on FeedError.NotFound
    placement    origin
    cache        private

    signal answer: String = ""
    let thread = query Thread(id)

    view {
        <title>Post</title>
        <main>
            <Replies post={thread} />
            <p id="counts">{counted(List.length(thread.replies), "reply", "replies")} · {counted(thread.likes, "like", "likes")}</p>
            <button id="like" type="button" on:press={resumable(captures = { id }) => match like(id) {
                Ok(_) => answer = answer,
                Err(_) => answer = answer,
            }}>Like</button>
            {#if List.length(thread.replies) == 0}<p id="quiet">No replies yet.</p>{/if}
            <form on:submit|prevent={resumable(captures = { id }) => match post_text(answer) {
                Some(text) => match reply(id, text) {
                    Ok(_) => answer = "",
                    Err(_) => answer = answer,
                },
                None => answer = answer,
            }}>
                <label>Your reply <textarea bind:value={answer}></textarea></label>
                <button type="submit" disabled={String.length(answer) == 0 | String.length(answer) > 280}>Reply</button>
            </form>
        </main>
    }
}

// **The timeline of those you follow** (ADR-0257): their posts and your own.
session page FollowingPage() {
    route     "/following"
    placement origin
    cache     private

    signal shown: Int = 20
    let feed = query FollowingTimeline(current_session(), shown)

    view {
        <title>Following</title>
        <main>
            <h1>Following</h1>
            <nav aria-label="Timelines"><a href="/">Everyone</a> <a href="/following" aria-current="page">Following</a></nav>
            {#if List.length(feed) == 0}<p id="nobody">Follow someone to see their posts here.</p>{/if}
            <ul>
                {#each feed as item (item.id)}
                    <li>
                        <a class="author" href="/post/{item.id}">{item.author.name}</a>
                        <a class="handle" href="/user/{item.author.id}">{item.author.handle}</a>
                        <p>{item.text}</p>
                        {#each item.images as followed_image (followed_image.src)}
                            <img class="photo" src={followed_image.src} width={followed_image.width} height={followed_image.height} alt={followed_image.alt}>
                        {/each}
                        <button type="button" on:press={resumable(captures = { item }) => match like(item.id) {
                            Ok(_) => shown = shown,
                            Err(_) => shown = shown,
                        }}>Like</button>
                        <span class="likes">{counted(item.likes, "like", "likes")}</span>
                        {#if item.mine}<button type="button" class="delete" on:press={resumable(captures = { item }) => match delete(item.id) {
                            Ok(_) => shown = shown,
                            Err(_) => shown = shown,
                        }}>Delete</button>{/if}
                    </li>
                {/each}
            </ul>
            <button type="button" on:press={() => shown = shown + 20}>Load more</button>
        </main>
    }
}

// **A user's page** (ADR-0257): who they are, who follows them and whom they
// follow, a Follow or an Unfollow for the reader, and their newest posts.
session page ProfilePage(id: UserId) {
    route        "/user/{id}"
    not_found_on FeedError.NotFound
    placement    origin
    cache        private

    signal pressed: Int = 0
    let person = query Profile(id)
    let relation = query Relation(current_session(), id)

    view {
        <title>Profile</title>
        <main>
            <h1>{person.user.name}</h1>
            <p id="handle">{person.user.handle}</p>
            <p id="follow-counts">{counted(person.followers, "follower", "followers")} · {person.following} following</p>
            {#match relation}
                {:Yourself}
                    <p id="you">This is you.</p>
                {:Following}
                    <button id="unfollow" type="button" on:press={resumable(captures = { id }) => match unfollow(id) {
                        Ok(_) => pressed = pressed + 1,
                        Err(_) => pressed = pressed,
                    }}>Unfollow</button>
                {:NotFollowing}
                    <button id="follow" type="button" on:press={resumable(captures = { id }) => match follow(id) {
                        Ok(_) => pressed = pressed + 1,
                        Err(_) => pressed = pressed,
                    }}>Follow</button>
            {/match}
            <p id="message-them"><a href="/messages/{id}">Message</a></p>
            <ul>
                {#each person.posts as post (post.id)}
                    <li>
                        <a href="/post/{post.id}">{post.text}</a>
                        <span class="likes">{counted(post.likes, "like", "likes")}</span>
                    </li>
                {/each}
            </ul>
        </main>
    }
}

// --- Track `notifications` (ADR-0274): what others do that involves you. ---

// **A notification's id**: the layer's, never one a deleted one had.
opaque type NotificationId = String

// **What someone did that involves you**: liked a post of yours, replied to
// one, or followed you.
type Act =
    | LikedYourPost
    | RepliedToYourPost
    | FollowedYou

// **A notification** (track `notifications`): who did what, the post it is
// about (the post liked, or the reply written; none for a follow), and
// whether you have read it. Its user's alone.
type Notification = Notification {
    id: NotificationId,
    actor: User,
    act: Act,
    posts: List<PostId>,
    unread: Bool,
}

// **Something happened that involves `user`**: a like or a reply to a post
// of theirs. A follow tells them by `Followed`'s followee.
event Notified(user: UserId)

// **The reader's notifications**, newest first, at most `limit`: by the
// reader's handle, which the host alone makes, so only the reader's.
fn notifications(reader: capability.User<UserId>, limit: Int) -> List<Notification> !{ database.read<Notification>, database.read<User> }
    host "feed:data/notifications#list"

// **How many of the reader's notifications are unread.**
fn unread_count(reader: capability.User<UserId>) -> Int !{ database.read<Notification> }
    host "feed:data/notifications#unread"

// **Every notification of the reader, read**: how many were unread.
fn read_all(reader: capability.User<UserId>) -> Result<Int, FeedError> !{ database.write<Notification> }
    host "feed:data/notifications#read"

// **Who wrote a post**, an id that grants nothing; none for a post that is
// not there.
fn owner(post: PostId) -> UserId !{ database.read<Post> }
    host "feed:data/posts#author"

// **The reader's notifications** (track `notifications`): private to their
// user, by cache and by session. A like or a reply to one of their posts,
// and a follow of them, drops the entries at that user in each of their
// sessions, and their open pages are told; a deleted post takes its
// notifications with it, whoever's they were.
private query Notifications(reader: capability.User<UserId>, limit: Int) -> List<Notification>
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    key            reader, limit
    invalidates_on Notified(reader), Followed(_, reader), Deleted(_)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    notifications(reader, limit)
}

// **How many of the reader's notifications are unread**, on each page that
// shows its reader, live.
private query Unread(reader: capability.User<UserId>) -> Int
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    key            reader
    invalidates_on Notified(reader), Followed(_, reader), Deleted(_)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    unread_count(reader)
}

// **Your notifications, read**: the count and the list of each of your
// sessions read again. None unread, shown before the server answers.
command mark_read() -> Result<Int, FeedError>
    requires      SignedIn
    idempotent_by InteractionId
    invalidates   Notifications(current_user(), _), Unread(current_user())
    optimistic    Unread(current_user()) as n => none_unread(n)
{
    read_all(current_user())
}

// **None unread**, shown before the server answers.
fn none_unread(n: Int) -> Int !{} {
    0
}

// **What a notification says someone did.**
fn described(act: Act) -> String !{} {
    match act {
        LikedYourPost => "liked your post",
        RepliedToYourPost => "replied to your post",
        FollowedYou => "followed you",
    }
}

// **What others did that involves you** (track `notifications`): newest
// first, a page at a time, and Mark all read.
session page NotificationsPage() {
    route     "/notifications"
    placement origin
    cache     private

    signal listed: Int = 20
    let notes = query Notifications(current_user(), listed)
    let unread = query Unread(current_user())

    view {
        <title>Notifications</title>
        <main>
            <h1>Notifications</h1>
            <nav aria-label="Timelines"><a href="/">Everyone</a> <a href="/following">Following</a></nav>
            <p id="unread-here" role="status">{counted(unread, "unread", "unread")}</p>
            <button id="mark-read" type="button" on:press={() => match mark_read() {
                Ok(_) => listed = listed,
                Err(_) => listed = listed,
            }}>Mark all read</button>
            {#if List.length(notes) == 0}<p id="no-notifications">Nothing yet: a like or a reply to a post of yours, or a follow, is shown here.</p>{/if}
            <ul id="notifications">
                {#each notes as note (note.id)}
                    <li class="notification">
                        <a class="actor" href="/user/{note.actor.id}">{note.actor.name}</a>
                        <span class="act">{described(note.act)}</span>
                        {#each note.posts as about (about)}<a class="about" href="/post/{about}">See it</a>{/each}
                        {#if note.unread}<span class="new">New</span>{/if}
                    </li>
                {/each}
            </ul>
            <button id="more-notifications" type="button" on:press={() => listed = listed + 20}>Load more</button>
        </main>
    }
}

// --- end of track `notifications`. ------------------------------------------

// --- Track `messages` (ADR-XXXX): direct messages. ---------------------------

// **A message's id**: the layer's, never one another message had.
opaque type MessageId = String

// **A message's text**: something, and at most 10,000 characters, each a
// code point as `String.length` counts it. Every construction is shown to
// hold it at build, and the host holds a browser's to it.
opaque type MessageText = String where String.length(value) >= 1 & String.length(value) <= 10000

// **A draft as a message's text, or none**, as `post_text` is a post's.
fn message_text(draft: String) -> Option<MessageText> !{} {
    if String.length(draft) >= 1 & String.length(draft) <= 10000 {
        Some(MessageText(draft))
    } else {
        None
    }
}

// **A message, as its reader sees it**: who sent it, what it says, and
// whether the reader has yet to read it. Never a post, and it notifies no
// one.
type Message = Message { id: MessageId, from: User, text: String, unread: Bool }

// **A conversation, read from one side** (track `messages`): the other
// user, the reader as the feed shows them, the newest messages between them
// oldest first, whether the reader may not send (`closed`: the other neither
// follows them nor has messaged them, or is them), and whether the other is
// the reader. Its reader's alone: the other reads the same rows as their own.
type Conversation = Conversation {
    with: User,
    me: User,
    messages: List<Message>,
    closed: Bool,
    yourself: Bool,
}

// **A conversation as the reader's list shows it**: the other user, the
// last message, and how many from them the reader has yet to read.
type ConversationItem = ConversationItem { with: User, last: String, unread: Int }

// **`from` sent `to` a message.** Both their sessions are told, each through
// a parameter of its own (ADR-0270): no third user's entry is dropped.
event Messaged(from: UserId, to: UserId)

// **The reader's conversation with `with`**: the newest `limit` messages
// either sent the other, by the reader's handle, which the host alone makes.
// None with one the feed does not know.
fn conversation(reader: capability.User<UserId>, with: UserId, limit: Int) -> Result<Conversation, FeedError> !{ database.read<Message>, database.read<User>, database.read<Follow> }
    host "feed:data/messages#conversation"

// **The reader's conversations**, newest first.
fn conversations(reader: capability.User<UserId>) -> List<ConversationItem> !{ database.read<Message>, database.read<User> }
    host "feed:data/messages#list"

// **How many messages the reader has yet to read**, in every conversation.
fn unread_messages(reader: capability.User<UserId>) -> Int !{ database.read<Message> }
    host "feed:data/messages#unread"

// **A message from the session's user to `to`**, written in the command's
// transaction, and the conversation read for its sender.
fn add_message(s: Session<SessionId>, to: UserId, text: MessageText) -> Result<Message, FeedError> !{ database.write<Message> }
    host "feed:data/messages#send"

// **The reader's conversation with `with`, read**: how many were unread.
fn read_messages(reader: capability.User<UserId>, with: UserId) -> Result<Int, FeedError> !{ database.write<Message> }
    host "feed:data/messages#read"

// **The reader's conversation with `with`** (track `messages`): private to
// the reader, by cache and by session, keyed by the reader's handle and the
// other's id. A message either sends the other drops it in each of the
// reader's sessions; and whether the reader may send is read again when the
// other follows or unfollows them, or messages them.
private query Conversation(reader: capability.User<UserId>, with: UserId, limit: Int) -> Result<Conversation, FeedError>
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    key            reader, with, limit
    invalidates_on Messaged(reader, with), Messaged(with, reader), Followed(with, reader),
                   Unfollowed(with, reader)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    conversation(reader, with, limit)
}

// **The reader's conversations**, newest first: a message the reader sends
// or is sent drops it in each of their sessions.
private query Conversations(reader: capability.User<UserId>) -> List<ConversationItem>
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    key            reader
    invalidates_on Messaged(reader, _), Messaged(_, reader)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    conversations(reader)
}

// **How many messages the reader has yet to read**, on each page that shows
// its reader, live.
private query UnreadMessages(reader: capability.User<UserId>) -> Int
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    key            reader
    invalidates_on Messaged(reader, _), Messaged(_, reader)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    unread_messages(reader)
}

// **A message to `to`** (track `messages`): only where `to` follows the
// sender or has messaged them before, and never to oneself: `MayMessage(to)`
// is the deployment's predicate, evaluated in the command's transaction
// before the body runs. Shown before the server answers, last in the
// conversation.
command send(to: UserId, text: MessageText) -> Result<Message, FeedError>
    requires      SignedIn, MayMessage(to)
    idempotent_by InteractionId
    emits         Messaged(author(current_session()), to)
    optimistic    Conversation(current_user(), to, _) as talk => sent(talk, text)
{
    add_message(current_session(), to, text)
}

// **The reader's conversation with `with`, read**: the conversation, the
// list and the count of each of the reader's sessions read again.
command read_conversation(with: UserId) -> Result<Int, FeedError>
    requires      SignedIn
    idempotent_by InteractionId
    invalidates   Conversation(current_user(), with, _), Conversations(current_user()),
                  UnreadMessages(current_user())
{
    read_messages(current_user(), with)
}

// **A message shown before the server answers** (ADR-0222): last in the
// conversation, from the reader, keyed by an id the page made.
fn sent(talk: Conversation, text: MessageText) -> Conversation !{} {
    let id = MessageId("pending-{List.length(talk.messages)}")
    let mine = Message { id: id, from: talk.me, text: text.value, unread: false }
    Conversation {
        with: talk.with,
        me: talk.me,
        messages: List.concat(talk.messages, [mine]),
        closed: talk.closed,
        yourself: talk.yourself,
    }
}

// **A message shown before the server answers waits** (ADR-0275): its id is
// the page's, which no server has, so nothing on it links until the
// server's row stands in its place. By the timeline's own rule, `waits`.
fn message_waits(id: MessageId) -> Bool !{} {
    waits(PostId(id.value))
}

// **Why the reader may not send**, where they may not.
fn why_not(talk: Conversation) -> String !{} {
    if talk.yourself {
        "You cannot message yourself."
    } else {
        "You can message {talk.with.name} once they follow you, or once they have messaged you."
    }
}

// **The reader's conversations** (track `messages`): newest first, each
// with its last message and how many are unread.
session page MessagesPage() {
    route     "/messages"
    placement origin
    cache     private

    let talks = query Conversations(current_user())
    let dm_count = query UnreadMessages(current_user())

    view {
        <title>Messages</title>
        <main>
            <h1>Messages</h1>
            <nav aria-label="Timelines"><a href="/">Everyone</a> <a href="/following">Following</a></nav>
            <p id="dm-unread-here" role="status">{counted(dm_count, "unread message", "unread messages")}</p>
            {#if List.length(talks) == 0}<p id="no-conversations">No messages yet: open someone's page, and Message them.</p>{/if}
            <ul id="conversations">
                {#each talks as talk (talk.with.id)}
                    <li class="conversation">
                        <a class="with" href="/messages/{talk.with.id}">{talk.with.name}</a>
                        <span class="last">{talk.last}</span>
                        {#if talk.unread > 0}<span class="dm-new">{talk.unread} unread</span>{/if}
                    </li>
                {/each}
            </ul>
        </main>
    }
}

// **A conversation, from the reader's side** (track `messages`): its
// messages oldest first, Mark read, and a composer where the reader may
// send; where they may not, why.
session page ConversationPage(with: UserId) {
    route        "/messages/{with}"
    not_found_on FeedError.NotFound
    placement    origin
    cache        private

    signal earlier: Int = 50
    signal message_draft: String = ""
    let talk = query Conversation(current_user(), with, earlier)
    let me = query Me(current_session())

    view {
        <title>Conversation</title>
        <main>
            <h1>{talk.with.name}</h1>
            <nav aria-label="Messages"><a href="/messages">All messages</a> <a href="/user/{with}">Their page</a></nav>
            <button id="earlier-messages" type="button" on:press={() => earlier = earlier + 50}>Load earlier</button>
            {#if List.length(talk.messages) == 0}<p id="no-messages">No messages yet.</p>{/if}
            <ol id="messages">
                {#each talk.messages as m (m.id)}
                    <li class="message">
                        {#if message_waits(m.id)}
                            <span class="from">{m.from.name}</span>
                            <span class="sending">Sending</span>
                        {:else}
                            <a class="from" href="/user/{m.from.id}">{m.from.name}</a>
                        {/if}
                        <p class="text">{m.text}</p>
                        {#if m.unread}<span class="dm-new">New</span>{/if}
                    </li>
                {/each}
            </ol>
            <button id="mark-conversation-read" type="button" on:press={resumable(captures = { with }) => match read_conversation(with) {
                Ok(_) => earlier = earlier,
                Err(_) => earlier = earlier,
            }}>Mark read</button>
            <form id="composer" hidden={talk.closed} on:submit|prevent={resumable(captures = { with }) => match message_text(message_draft) {
                Some(text) => match send(with, text) {
                    Ok(_) => message_draft = "",
                    Err(_) => message_draft = message_draft,
                },
                None => message_draft = message_draft,
            }}>
                <label>Your message <textarea bind:value={message_draft}></textarea></label>
                <button type="submit" disabled={String.length(message_draft) == 0 | String.length(message_draft) > 10000}>Send</button>
            </form>
            {#if talk.closed}<p id="may-not-send" role="status">{why_not(talk)}</p>{/if}
            {#if me.signed_in}{:else}<p id="sign-in-to-send" role="status">Sign in to send messages.</p>{/if}
        </main>
    }
}

// --- end of track `messages`. -----------------------------------------------
