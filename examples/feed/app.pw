// @corpus: reference
// @id: FEED
// @category: a reference app unlike the store: a feed
// @milestone: E14
//
// The owner's reference app (NEXT 22): a Twitter-shaped feed, to find what
// the store does not. Users, posts with their replies as deep as they go, a
// timeline read a page at a time, posting, replying and liking. Its data is
// the deployment's (ADR-0218): `feed:data/…` is what the host's feed layer
// supplies.

module feed.app

import List
import String
import context.{ current_session }
import capability.{ Session, SessionId }

opaque type UserId = String
opaque type PostId = String
opaque type InteractionId = String

// **A post's text** (ADR-0225): something, and at most 280 characters,
// each a code point as `String.length` counts it. Every construction is
// shown to hold it at build, and the host holds a browser's to it.
opaque type PostText = String where String.length(value) >= 1 & String.length(value) <= 280

// **A draft as a post's text, or none** (ADR-0225): the program's own
// checked constructor, as ADR-0179 asks.
fn post_text(draft: String) -> Option<PostText> !{} {
    if String.length(draft) >= 1 & String.length(draft) <= 280 {
        Some(PostText(draft))
    } else {
        None
    }
}

type User = User { id: UserId, handle: String, name: String }

type Post = Post {
    id: PostId,
    author: User,
    text: String,
    likes: Int,
    replies: List<Post>,
}

// **A post as a timeline shows it** (ADR-0222): who wrote it, what it says,
// and its likes. Its replies are its thread's.
type Item = Item {
    id: PostId,
    author: User,
    text: String,
    likes: Int,
}

// **Who follows whom** (ADR-0257): a row a follow writes and an unfollow
// deletes, the follower first.
type Follow = Follow { follower: UserId, followee: UserId }

// **A post as its author's page lists it** (ADR-0257): what it says and its
// likes. Its author is the page's.
type Authored = Authored { id: PostId, text: String, likes: Int }

// **A user's page** (ADR-0257): who they are, how many follow them and how
// many they follow, and their newest posts. Every reader's: what the reader
// is to them is the reader's own, `Relation`.
type Profile = Profile {
    user: User,
    followers: Int,
    following: Int,
    posts: List<Authored>,
}

// **What the reader is to a user** (ADR-0257): the user, one who follows
// them, or one who does not.
type Relation =
    | Yourself
    | Following
    | NotFollowing

type FeedError =
    | Unavailable
    | NotFound

event Posted(author: UserId)
event Liked(post: PostId)
event Followed(follower: UserId, followee: UserId)
event Unfollowed(follower: UserId, followee: UserId)

// **What the feed's database guarantees** (ADR-0207, ADR-0246): one
// PostgreSQL, as the host's feed layer opens it.
// - A command's writes commit in a serializable transaction: the layer sets
//   it on each, whatever the connection's default (read committed).
// - A read is of the latest commit, on the primary.
// - It tells no change itself: the program's own events tell them, written
//   with each command's writes in the outbox, in the same transaction.
// The host compares these with what the database it opens provides, and
// does not serve on a mismatch.
source FeedData
    holds        Post, User, Follow
    transactions serializable
    reads        strong
    changes      none

fn timeline(s: Session<SessionId>, limit: Int) -> List<Item> !{ database.read<Post> }
    host "feed:data/posts#timeline"

fn thread(id: PostId) -> Result<Post, FeedError> !{ database.read<Post> }
    host "feed:data/posts#thread"

fn author(s: Session<SessionId>) -> UserId !{ database.read<User> }
    host "feed:data/users#of-session"

fn publish(s: Session<SessionId>, text: PostText) -> Result<Post, FeedError> !{ database.write<Post> }
    host "feed:data/posts#publish"

fn add_reply(s: Session<SessionId>, to: PostId, text: PostText) -> Result<Post, FeedError> !{ database.write<Post> }
    host "feed:data/posts#reply"

fn add_like(s: Session<SessionId>, post: PostId) -> Result<Post, FeedError> !{ database.write<Post> }
    host "feed:data/posts#like"

// **The timeline of those the session's user follows** (ADR-0257): their
// posts and its own, newest first, at most `limit`.
fn following_timeline(s: Session<SessionId>, limit: Int) -> List<Item> !{ database.read<Post>, database.read<Follow> }
    host "feed:data/posts#following"

// **A user's page** (ADR-0257), or none for one the feed does not know.
fn profile(id: UserId) -> Result<Profile, FeedError> !{ database.read<User>, database.read<Post>, database.read<Follow> }
    host "feed:data/users#profile"

// **What the session's user is to `user`** (ADR-0257).
fn relation(s: Session<SessionId>, user: UserId) -> Relation !{ database.read<User>, database.read<Follow> }
    host "feed:data/users#relation"

// **The session's user follows `user`** (ADR-0257): once, whatever how
// often; one the feed does not know, or itself, is not found.
fn add_follow(s: Session<SessionId>, user: UserId) -> Result<UserId, FeedError> !{ database.read<User>, database.write<Follow> }
    host "feed:data/users#follow"

// **The session's user follows `user` no more** (ADR-0257): one it does not
// follow is no change; one the feed does not know is not found.
fn remove_follow(s: Session<SessionId>, user: UserId) -> Result<UserId, FeedError> !{ database.read<User>, database.write<Follow> }
    host "feed:data/users#unfollow"

session query Timeline(session: Session<SessionId>, limit: Int) -> List<Item>
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    key            session, limit
    invalidates_on Posted(_), Liked(_)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    timeline(session, limit)
}

// **The timeline of those you follow** (ADR-0257): their posts and your
// own, newest first, read as the home timeline is. A follow or an unfollow
// drops it, by its own `invalidates`.
session query FollowingTimeline(session: Session<SessionId>, limit: Int) -> List<Item>
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    key            session, limit
    invalidates_on Posted(_), Liked(_)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    following_timeline(session, limit)
}

// **A user's page** (ADR-0257), every reader's: its counts change when
// someone follows them or they follow someone, and its posts when they post
// or one is liked.
public query Profile(id: UserId) -> Result<Profile, FeedError>
    freshness      5.seconds
    consistency    snapshot
    cache          shared
    key            id
    invalidates_on Followed(_, id), Unfollowed(_, id), Followed(id, _),
                   Unfollowed(id, _), Posted(id), Liked(_)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    profile(id)
}

// **What the reader is to a user** (ADR-0257): the reader's own.
session query Relation(session: Session<SessionId>, user: UserId) -> Relation
    freshness      0.seconds
    consistency    read_your_writes
    cache          private
    key            session, user
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    relation(session, user)
}

public query Thread(id: PostId) -> Result<Post, FeedError>
    freshness      5.seconds
    consistency    snapshot
    cache          shared
    key            id
    invalidates_on Liked(id), Posted(_)
    concurrency    one_per_key
    on_key_change  cancel
    timeout        2.seconds
{
    thread(id)
}

command post(text: PostText) -> Result<Post, FeedError>
    requires      SignedIn
    idempotent_by InteractionId
    emits         Posted(author(current_session()))
    optimistic    Timeline(current_session(), _) as feed => pending(feed, text)
{
    publish(current_session(), text)
}

// **A reply** (ADR-0231): a post, in its thread and in no timeline. The
// thread page passes its `id`, the page's parameter, which keys the thread it
// shows, so a reply is shown there before the server answers (ADR-0236,
// ruling 0122-d).
command reply(to: PostId, text: PostText) -> Result<Post, FeedError>
    requires      SignedIn
    idempotent_by InteractionId
    emits         Posted(author(current_session()))
    optimistic    Thread(to) as thread => replied(thread, text)
{
    add_reply(current_session(), to, text)
}

// **A reply shown before the server answers** (ADR-0236): last among the
// thread's replies, by "You", keyed apart from every other pending one.
fn replied(thread: Post, text: PostText) -> Post !{} {
    let you = User { id: UserId("you"), handle: "@you", name: "You" }
    let id = PostId("pending-reply-{List.length(thread.replies)}")
    let mine = Post { id: id, author: you, text: text.value, likes: 0, replies: [] }
    Post {
        id: thread.id,
        author: thread.author,
        text: thread.text,
        likes: thread.likes,
        replies: List.concat(thread.replies, [mine]),
    }
}

// **A post shown before the server answers** (ADR-0222): first in the
// timeline, by "You", keyed apart from every other pending one.
fn pending(feed: List<Item>, text: PostText) -> List<Item> !{} {
    let you = User { id: UserId("you"), handle: "@you", name: "You" }
    let id = PostId("pending-{List.length(feed)}")
    List.concat([Item { id: id, author: you, text: text.value, likes: 0 }], feed)
}

// **A count, in words** (ADR-0226): "1 reply", "3 likes". The thread
// page computes its counts with it, in the template.
fn counted(n: Int, one: String, many: String) -> String !{} {
    if n == 1 {
        "1 {one}"
    } else {
        "{n} {many}"
    }
}

command like(post: PostId) -> Result<Post, FeedError>
    requires      SignedIn
    idempotent_by InteractionId
    emits         Liked(post)
    optimistic    Timeline(current_session(), _) as feed => liked(feed, post),
                  FollowingTimeline(current_session(), _) as feed => liked(feed, post),
                  Thread(post) as thread => liked_thread(thread, post)
{
    add_like(current_session(), post)
}

// **Following someone** (ADR-0257): their posts in your following timeline
// from now on, and one more follower on their page. Shown before the server
// answers: the button, and the count.
command follow(user: UserId) -> Result<UserId, FeedError>
    requires      SignedIn
    idempotent_by InteractionId
    emits         Followed(author(current_session()), user)
    invalidates   FollowingTimeline(current_session(), _), Relation(current_session(), user)
    optimistic    Relation(current_session(), user) as now => followed(now),
                  Profile(user) as person => counted_follower(person, 1)
{
    add_follow(current_session(), user)
}

// **Following someone no more** (ADR-0257).
command unfollow(user: UserId) -> Result<UserId, FeedError>
    requires      SignedIn
    idempotent_by InteractionId
    emits         Unfollowed(author(current_session()), user)
    invalidates   FollowingTimeline(current_session(), _), Relation(current_session(), user)
    optimistic    Relation(current_session(), user) as now => unfollowed(now),
                  Profile(user) as person => counted_follower(person, -1)
{
    remove_follow(current_session(), user)
}

// **A follow, shown before the server answers** (ADR-0257): the reader
// follows them, unless they are the reader.
fn followed(now: Relation) -> Relation !{} {
    match now {
        Yourself => Yourself,
        _ => Following,
    }
}

// **An unfollow, shown before the server answers** (ADR-0257).
fn unfollowed(now: Relation) -> Relation !{} {
    match now {
        Yourself => Yourself,
        _ => NotFollowing,
    }
}

// **A page's follower count, by `by`** (ADR-0257).
fn counted_follower(person: Profile, by: Int) -> Profile !{} {
    Profile {
        user: person.user,
        followers: person.followers + by,
        following: person.following,
        posts: person.posts,
    }
}

// **A like on the thread page, shown before the server answers**
// (ADR-0238): the thread's count one more, where the thread is the post.
fn liked_thread(thread: Post, post: PostId) -> Post !{} {
    if thread.id == post {
        Post {
            id: thread.id,
            author: thread.author,
            text: thread.text,
            likes: thread.likes + 1,
            replies: thread.replies,
        }
    } else {
        thread
    }
}

// **A like shown before the server answers** (ADR-0228): the post's count
// one more, in the timeline the page shows.
fn liked(feed: List<Item>, post: PostId) -> List<Item> !{} {
    List.map(feed, (i) => if i.id == post {
        Item { id: i.id, author: i.author, text: i.text, likes: i.likes + 1 }
    } else {
        i
    })
}

session page Home() {
    route     "/"
    placement origin
    cache     private

    signal shown: Int = 20
    signal draft: String = ""
    let feed = query Timeline(current_session(), shown)

    view {
        <title>Home</title>
        <main>
            <h1>Home</h1>
            <nav aria-label="Timelines"><a href="/" aria-current="page">Everyone</a> <a href="/following">Following</a></nav>
            <form on:submit|prevent={() => match post_text(draft) {
                Some(text) => match post(text) {
                    Ok(_) => draft = "",
                    Err(_) => draft = draft,
                },
                None => draft = draft,
            }}>
                <label>What's happening? <textarea bind:value={draft}></textarea></label>
                <p id="left">{280 - String.length(draft)} left</p>
                {#if String.length(draft) > 280}<p id="over" role="alert">Too long to post.</p>{/if}
                <button type="submit" disabled={String.length(draft) == 0 | String.length(draft) > 280}>Post</button>
            </form>
            <ul>
                {#each feed as p (p.id)}
                    <li>
                        <a class="author" href="/post/{p.id}">{p.author.name}</a>
                        <a class="handle" href="/user/{p.author.id}">{p.author.handle}</a>
                        <p>{p.text}</p>
                        <button type="button" on:press={resumable(captures = { p }) => match like(p.id) {
                            Ok(_) => draft = draft,
                            Err(_) => draft = draft,
                        }}>Like</button>
                        <span class="likes">{counted(p.likes, "like", "likes")}</span>
                    </li>
                {/each}
            </ul>
            <button type="button" on:press={() => shown = shown + 20}>Load more</button>
        </main>
    }
}

// A post and its replies, each a post with its own, as deep as they go
// (ADR-0203: a view that contains itself).
view Replies(post: Post) {
    <article>
        <p><a href="/post/{post.id}">{post.author.name}</a></p>
        <p>{post.text}</p>
        <ul>
            {#each post.replies as reply (reply.id)}
                <li><Replies post={reply} /></li>
            {/each}
        </ul>
    </article>
}

page PostPage(id: PostId) {
    route        "/post/{id}"
    not_found_on FeedError.NotFound
    placement    origin
    cache        private

    signal answer: String = ""
    let thread = query Thread(id)

    view {
        <title>Post</title>
        <main>
            <Replies post={thread} />
            <p id="counts">{counted(List.length(thread.replies), "reply", "replies")} · {counted(thread.likes, "like", "likes")}</p>
            <button id="like" type="button" on:press={resumable(captures = { id }) => match like(id) {
                Ok(_) => answer = answer,
                Err(_) => answer = answer,
            }}>Like</button>
            {#if List.length(thread.replies) == 0}<p id="quiet">No replies yet.</p>{/if}
            <form on:submit|prevent={resumable(captures = { id }) => match post_text(answer) {
                Some(text) => match reply(id, text) {
                    Ok(_) => answer = "",
                    Err(_) => answer = answer,
                },
                None => answer = answer,
            }}>
                <label>Your reply <textarea bind:value={answer}></textarea></label>
                <button type="submit" disabled={String.length(answer) == 0 | String.length(answer) > 280}>Reply</button>
            </form>
        </main>
    }
}

// **The timeline of those you follow** (ADR-0257): their posts and your own.
session page FollowingPage() {
    route     "/following"
    placement origin
    cache     private

    signal shown: Int = 20
    let feed = query FollowingTimeline(current_session(), shown)

    view {
        <title>Following</title>
        <main>
            <h1>Following</h1>
            <nav aria-label="Timelines"><a href="/">Everyone</a> <a href="/following" aria-current="page">Following</a></nav>
            {#if List.length(feed) == 0}<p id="nobody">Follow someone to see their posts here.</p>{/if}
            <ul>
                {#each feed as item (item.id)}
                    <li>
                        <a class="author" href="/post/{item.id}">{item.author.name}</a>
                        <a class="handle" href="/user/{item.author.id}">{item.author.handle}</a>
                        <p>{item.text}</p>
                        <button type="button" on:press={resumable(captures = { item }) => match like(item.id) {
                            Ok(_) => shown = shown,
                            Err(_) => shown = shown,
                        }}>Like</button>
                        <span class="likes">{counted(item.likes, "like", "likes")}</span>
                    </li>
                {/each}
            </ul>
            <button type="button" on:press={() => shown = shown + 20}>Load more</button>
        </main>
    }
}

// **A user's page** (ADR-0257): who they are, who follows them and whom they
// follow, a Follow or an Unfollow for the reader, and their newest posts.
session page ProfilePage(id: UserId) {
    route        "/user/{id}"
    not_found_on FeedError.NotFound
    placement    origin
    cache        private

    signal pressed: Int = 0
    let person = query Profile(id)
    let relation = query Relation(current_session(), id)

    view {
        <title>Profile</title>
        <main>
            <h1>{person.user.name}</h1>
            <p id="handle">{person.user.handle}</p>
            <p id="follow-counts">{counted(person.followers, "follower", "followers")} · {person.following} following</p>
            {#match relation}
                {:Yourself}
                    <p id="you">This is you.</p>
                {:Following}
                    <button id="unfollow" type="button" on:press={resumable(captures = { id }) => match unfollow(id) {
                        Ok(_) => pressed = pressed + 1,
                        Err(_) => pressed = pressed,
                    }}>Unfollow</button>
                {:NotFollowing}
                    <button id="follow" type="button" on:press={resumable(captures = { id }) => match follow(id) {
                        Ok(_) => pressed = pressed + 1,
                        Err(_) => pressed = pressed,
                    }}>Follow</button>
            {/match}
            <ul>
                {#each person.posts as post (post.id)}
                    <li>
                        <a href="/post/{post.id}">{post.text}</a>
                        <span class="likes">{counted(post.likes, "like", "likes")}</span>
                    </li>
                {/each}
            </ul>
        </main>
    }
}
