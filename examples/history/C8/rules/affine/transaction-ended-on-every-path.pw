// @expect: clean
// The control for the "not consumed" half. Same acquisition, same early exit —
// the transaction ends before the return. A rule that reported every `return`
// after an acquisition, or banned early returns in a body holding one, would
// catch this.

module rules.affine_paths

import Carts
import Database
// 2026-08-10: PW0021 learned to examine bare calls, and a rule fixture that
// calls a name nothing declares is not the clean program it claims to be.
import context.{ current_session }

command clear_cart() -> Result<(), CartError>
    requires SignedIn
{
    let tx = Database.begin()
    if Carts.is_empty(current_session()) {
        Database.rollback(tx)
        return Ok(())
    }
    // `clear` takes a session, not a transaction. Repaired 2026-08-20
    // when `PW0604` began checking call arity and found the same wrong
    // call in three files — a fixture describing a library that does not
    // exist, copied.
    Carts.clear(current_session())
    tx.commit()
}
