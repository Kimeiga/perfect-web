// @corpus: rejected
// @id: R-011
// @category: open transaction not committed or rolled back
// @rule: PW0309
// @invariant: affine_not_consumed_once
// @charter: §7.7
// @milestone: 9
// @expect-error: affine resource `tx: DatabaseTransaction` is not consumed on every path
// @expect-error: a transaction must end exactly once, in `commit` or `rollback`
//
// A transaction is an affine handle. The early return leaves one path where it
// is never resolved, which the compiler must reject.

module cart.write

import Carts
import Database
// 2026-08-10: PW0021 learned to examine bare calls, and this fixture was
// calling a name it never imported. A rejected fixture must isolate ONE
// defect; a second, silent one made it evidence for less than it claimed.
//
// 2026-08-20: and again, in the same file. `PW0604` began checking call arity
// and found `Carts.clear(tx, current_session())` against a `clear` that
// declares one parameter. The fixture was describing a library that does not
// exist — the `Stores.find` shape `tests/platform_contracts.rs` was written
// for, where the fixture's own text establishes what the library must be.
// Two silent second defects in one fixture, found by two different checks
// three days apart, is a fact about the corpus and not about this file.
import context.{ current_session }

command clear_cart() -> Result<(), CartError>
    requires SignedIn
{
    let tx = Database.begin()
    if Carts.is_empty(current_session()) {
        // ERROR: `tx` is still live on this path.
        return Ok(())
    }
    Carts.clear(current_session())
    tx.commit()
}
