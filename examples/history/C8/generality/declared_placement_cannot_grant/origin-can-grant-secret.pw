// @status: NEIGHBOUR
// @invariant: declared_placement_cannot_grant
// @dimension: valid neighbour — a different capability, in its own world
//
// A secret read at the origin, which is exactly where secrets live. A rule
// that treated `placement origin` as suspicious would catch this.
module generality.place_origin_ok

import secrets
import capability.{ Secret, Payments }

query Key(session: SessionId) -> Secret<Payments>
    placement origin
    cache     private
{
    secrets.payments()
}
