// @status: GENERAL
// @invariant: cache_key_omits_partition
// @dimension: indirect invalid — a different partition, and a longer key
//
// The key has two components and still omits the one that matters. A rule
// checking that a key EXISTS, or that it is non-trivial, would pass this.

module generality.key_user

import Menus
import context

query Recent(store: StoreId, limit: Int) -> Result<List<MenuItem>, MenuError>
    cache shared
    key   store, limit
{
    Menus.for_user(store, limit, context.current_user())
}
