// @expect: PW5102
// A shared cache entry outlives the deployment that wrote it.
//
// Without the build in the key, markup generated by one release is served to a
// client running another. That is the mismatch E7V refuses in a resume
// manifest — except that a cache hit compares nothing, so nothing refuses, and
// the two halves of the page simply disagree about what the code does.
//
// The neighbour differs from this file in exactly one line.

module rules.materialization_no_build_key

import domain.{ StoreId }
import Resources.{ Menu }
import Events.{ MenuChanged }

materialize DriftingFragment(id: StoreId) {
    placement      edge
    partition      public
    depends_on     Menu(id)
    invalidates_on MenuChanged(id)
    regenerate     on_invalidation
    stampede       single_flight
    fallback       last_known_good
}
