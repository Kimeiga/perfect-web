// @expect: clean
// The control for the capture rules. Same `resumable`, same captures clause —
// what is captured is an identifier rather than the live thing. A rule that
// reported every `resumable(captures = ..)` would catch this.

module rules.resume_good

import domain.{ StoreId }

// 2026-08-10: PW0021 learned to examine bare calls, and a rule fixture that
// calls a name nothing declares is not the clean program it claims to be.
fn refresh(id: StoreId) -> () !{} { todo }

view Panel(store_id: StoreId) !{} {
    <button on:press={resumable(captures = { store_id }) => refresh(store_id)}>
        Refresh
    </button>
}
