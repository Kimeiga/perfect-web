// @expect: PW5006
// The rule's positive case: a capability token reaching a sink declared
// `Public`. The row admits `secret<Payments>`, which permits the value to
// exist here — it does not permit it to leave.

module rules.sink_bad

import log
import secrets
import capability.{ Payments, Public }

fn trace(order: OrderId) -> () !{ log<Public>, secret<Payments> } {
    let token = secrets.payments()
    log.public("capturing with {token}")
}
