// @expect: clean
// The second control, and the more interesting one: the SAME secret value,
// interpolated the same way, into a sink whose level is not `Public`. What
// makes the first fixture an error is the sink's declared level, not the fact
// that a secret was mentioned.

module rules.sink_level

import log
import secrets

fn trace(order: OrderId) -> () !{ log<Private>, secret<Payments> } {
    let token = secrets.payments()
    log.private("capturing with {token}")
}
