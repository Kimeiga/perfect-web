// @expect: clean
// The control. Identical shape — a binding, an interpolation, the same sink —
// differing only in that the value is not secret. A rule that banned
// interpolation into `log.public`, or banned `log.public` outright, would
// catch the fixture beside this one and fail here.

module rules.sink_good

import log
import Stores
import capability.{ Public }
import domain.{ StoreId }

fn trace(id: StoreId) -> () !{ log<Public>, database.read<Stores> } {
    // The store's name, taken out of the `Result` `get` answers: a string
    // holds text, and until 2026-09-26 this logged the `Result` itself, which
    // has none and which the backend refuses (ADR-0084).
    let name = match Stores.get(id) {
        Ok(store) => store.name,
        Err(_) => "unavailable",
    }
    log.public("loaded {name}")
}
